        glow.ImageColor3 = self.Theme.Accent
        glow.ImageTransparency = 0.92
        glow.ScaleType = Enum.ScaleType.Slice
        glow.SliceCenter = Rect.new(24, 24, 276, 276)
        glow.ZIndex = 0
        glow.Parent = main

        spring(main, 0.42, {
            Size = size,
            Position = UDim2.new(0.5, -size.X.Offset / 2, 0.5, -size.Y.Offset / 2),
            AnchorPoint = Vector2.new(0, 0)
        })

        -- Compact header
        local header = Instance.new("Frame")
        header.Size = UDim2.new(1, 0, 0, 36)
        header.BackgroundColor3 = self.Theme.Sidebar
        header.BorderSizePixel = 0
        header.Parent = main
        corner(header, 10)

        local headerFill = Instance.new("Frame")
        headerFill.Size = UDim2.new(1, 0, 0, 12)
        headerFill.Position = UDim2.new(0, 0, 1, -12)
        headerFill.BackgroundColor3 = self.Theme.Sidebar
        headerFill.BorderSizePixel = 0
        headerFill.Parent = header

        local headerLine = Instance.new("Frame")
        headerLine.Size = UDim2.new(1, 0, 0, 1)
        headerLine.Position = UDim2.new(0, 0, 1, -1)
        headerLine.BackgroundColor3 = self.Theme.Accent
        headerLine.BackgroundTransparency = 0.65
        headerLine.BorderSizePixel = 0
        headerLine.Parent = header

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0, 180, 1, 0)
        title.Position = UDim2.new(0, 14, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = name
        title.TextColor3 = self.Theme.Text
        title.TextSize = 14
        title.Font = Enum.Font.GothamBold
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = header

        local right = Instance.new("Frame")
        right.Size = UDim2.new(0, 200, 1, 0)
        right.Position = UDim2.new(1, -208, 0, 0)
        right.BackgroundTransparency = 1
        right.Parent = header

        local stats = Instance.new("Frame")
        stats.Size = UDim2.new(0, 110, 1, 0)
        stats.BackgroundTransparency = 1
        stats.Parent = right

        local fpsLbl = Instance.new("TextLabel")
        fpsLbl.Size = UDim2.new(0.5, -2, 1, 0)
        fpsLbl.BackgroundTransparency = 1
        fpsLbl.Text = "FPS --"
        fpsLbl.TextColor3 = self.Theme.Muted
        fpsLbl.TextSize = 11
        fpsLbl.Font = Enum.Font.GothamMedium
        fpsLbl.TextXAlignment = Enum.TextXAlignment.Right
        fpsLbl.Parent = stats

        local pingLbl = Instance.new("TextLabel")
        pingLbl.Size = UDim2.new(0.5, -2, 1, 0)
        pingLbl.Position = UDim2.new(0.5, 2, 0, 0)
        pingLbl.BackgroundTransparency = 1
        pingLbl.Text = "ms --"
        pingLbl.TextColor3 = self.Theme.Muted
        pingLbl.TextSize = 11
        pingLbl.Font = Enum.Font.GothamMedium
        pingLbl.TextXAlignment = Enum.TextXAlignment.Left
        pingLbl.Parent = stats

        local last = 0
        RunService.RenderStepped:Connect(function(dt)
            local fps = math.floor(1 / math.max(dt, 0.001))
            if tick() - last > 0.45 then
                last = tick()
                fpsLbl.Text = "FPS " .. fps
                local ping = 0
                pcall(function()
                    ping = math.floor(LP:GetNetworkPing() * 1000)
                end)
                pingLbl.Text = ping .. "ms"
                fpsLbl.TextColor3 = fps >= 55 and self.Theme.Success or (fps >= 35 and Color3.fromRGB(250, 190, 60) or self.Theme.Danger)
                pingLbl.TextColor3 = ping <= 70 and self.Theme.Success or (ping <= 130 and Color3.fromRGB(250, 190, 60) or self.Theme.Danger)
            end
        end)

        local controls = Instance.new("Frame")
        controls.Size = UDim2.new(0, 86, 1, 0)
        controls.Position = UDim2.new(1, -88, 0, 0)
        controls.BackgroundTransparency = 1
        controls.Parent = right

        local function makeBtn(txt, col, x, size)
            local b = Instance.new("TextButton")
            b.Size = UDim2.fromOffset(24, 24)
            b.Position = UDim2.new(0, x, 0.5, -12)
            b.BackgroundColor3 = col
            b.BackgroundTransparency = 1
            b.Text = txt
            b.TextColor3 = self.Theme.Text
            b.TextSize = size or 14
            b.Font = Enum.Font.GothamBold
            b.AutoButtonColor = false
            b.Parent = controls
            corner(b, 5)
            b.MouseEnter:Connect(function()
                tween(b, 0.14, {BackgroundTransparency = 0.6})
            end)
            b.MouseLeave:Connect(function()
                tween(b, 0.14, {BackgroundTransparency = 1})
            end)
            return b
        end

        local gear = makeBtn("⚙", self.Theme.Card, 0, 13)
        local minBtn = makeBtn("–", self.Theme.Card, 28)
        local closeBtn = makeBtn("×", self.Theme.Danger, 56)
        closeBtn.TextColor3 = Color3.new(1, 1, 1)

        -- Theme panel
        local themePanel = Instance.new("Frame")
        themePanel.Size = UDim2.fromOffset(140, 0)
        themePanel.Position = UDim2.new(1, -150, 0, 42)
        themePanel.BackgroundColor3 = self.Theme.Card
        themePanel.BackgroundTransparency = 0.04
        themePanel.Visible = false
        themePanel.ClipsDescendants = true
        themePanel.ZIndex = 30
        themePanel.Parent = main
        corner(themePanel, 8)
        local tStroke = stroke(themePanel, self.Theme.Accent, 1, 0.45)

        local tLayout = Instance.new("UIListLayout")
        tLayout.Padding = UDim.new(0, 4)
        tLayout.Parent = themePanel
        padding(themePanel, 6, 6, 6, 6)

        local themeOpen = false
        local themeBtns = {}

        local function setTheme(themeName)
            local th = PhantomLib.Themes[themeName]
            if not th then return end
            self.Theme = th
            self.CurrentTheme = themeName

            tween(main, 0.28, {BackgroundColor3 = th.Background})
            tween(header, 0.28, {BackgroundColor3 = th.Sidebar})
            tween(headerFill, 0.28, {BackgroundColor3 = th.Sidebar})
            tween(headerLine, 0.28, {BackgroundColor3 = th.Accent})
            tween(title, 0.22, {TextColor3 = th.Text})
            tween(mainStroke, 0.25, {Color = th.Border})
            tween(glow, 0.3, {ImageColor3 = th.Accent})
            tween(themePanel, 0.22, {BackgroundColor3 = th.Card})
            tween(tStroke, 0.22, {Color = th.Accent})

            if self.Sidebar then
                tween(self.Sidebar, 0.25, {BackgroundColor3 = th.Sidebar})
                self.Sidebar.ScrollBarImageColor3 = th.Accent
            end

            for _, tab in ipairs(self.Tabs) do
                if tab.Label then
                    tween(tab.Label, 0.2, {
                        TextColor3 = (self.ActiveTab == tab) and th.Text or th.Muted
                    })
                end
                if tab.Indicator then
                    tween(tab.Indicator, 0.2, {BackgroundColor3 = th.Accent})
                end
                if tab.View then
                    tab.View.ScrollBarImageColor3 = th.Accent
                end
            end

            for n, data in pairs(themeBtns) do
                local sel = n == themeName
                tween(data.btn, 0.18, {
                    BackgroundTransparency = sel and 0.18 or 1,
                    BackgroundColor3 = sel and th.Accent or th.Card
                })
                tween(data.label, 0.18, {
                    TextColor3 = sel and Color3.new(1, 1, 1) or th.Text
                })
            end

            self:Notify({Title = "Theme", Content = "Switched to " .. themeName, Duration = 1.8})
        end

        for _, tName in ipairs({"Default", "Light", "Cyber", "Ocean"}) do
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, 0, 0, 26)
            b.BackgroundColor3 = self.Theme.Accent
            b.BackgroundTransparency = (tName == self.CurrentTheme) and 0.18 or 1
            b.Text = ""
            b.AutoButtonColor = false
            b.ZIndex = 31
            b.Parent = themePanel
            corner(b, 5)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = tName
            lbl.TextColor3 = (tName == self.CurrentTheme) and Color3.new(1, 1, 1) or self.Theme.Text
            lbl.TextSize = 12
            lbl.Font = Enum.Font.GothamMedium
            lbl.ZIndex = 32
            lbl.Parent = b

            themeBtns[tName] = {btn = b, label = lbl}

            b.MouseEnter:Connect(function()
                if tName ~= self.CurrentTheme then
                    tween(b, 0.12, {BackgroundTransparency = 0.7})
                end
            end)
            b.MouseLeave:Connect(function()
                if tName ~= self.CurrentTheme then
                    tween(b, 0.12, {BackgroundTransparency = 1})
                end
            end)
            b.MouseButton1Click:Connect(function()
                setTheme(tName)
            end)
        end

        gear.MouseButton1Click:Connect(function()
            themeOpen = not themeOpen
            if themeOpen then
                themePanel.Visible = true
                themePanel.Size = UDim2.fromOffset(140, 0)
                spring(themePanel, 0.3, {Size = UDim2.fromOffset(140, 128)})
            else
                tween(themePanel, 0.2, {Size = UDim2.fromOffset(140, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
                task.delay(0.22, function()
                    if not themeOpen then themePanel.Visible = false end
                end)
            end
        end)

        minBtn.MouseButton1Click:Connect(function()
            self.Minimized = not self.Minimized
            if self.Minimized then
                if themeOpen then
                    themeOpen = false
                    themePanel.Visible = false
                end
                tween(main, 0.26, {Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 36)})
                tween(glow, 0.24, {ImageTransparency = 1})
            else
                tween(main, 0.3, {Size = size}, Enum.EasingStyle.Back)
                tween(glow, 0.3, {ImageTransparency = 0.92})
            end
        end)

        closeBtn.MouseButton1Click:Connect(function()
            self:DisableAllAndDestroy()
        end)

        -- Dragging
        local dragging, start, startPos
        header.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                start = inp.Position
                startPos = main.Position
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                local d = inp.Position - start
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        -- Compact sidebar
        local sidebar = Instance.new("ScrollingFrame")
        sidebar.Size = UDim2.new(0, 112, 1, -36)
        sidebar.Position = UDim2.new(0, 0, 0, 36)
        sidebar.BackgroundColor3 = self.Theme.Sidebar
        sidebar.BorderSizePixel = 0
        sidebar.ScrollBarThickness = 2
        sidebar.ScrollBarImageColor3 = self.Theme.Accent
        sidebar.ScrollBarImageTransparency = 0.5
        sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
        sidebar.Parent = main

        local sLayout = Instance.new("UIListLayout")
        sLayout.Padding = UDim.new(0, 3)
        sLayout.Parent = sidebar
        padding(sidebar, 8, 6, 8, 6)

        sLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            sidebar.CanvasSize = UDim2.new(0, 0, 0, sLayout.AbsoluteContentSize.Y + 14)
        end)

        local container = Instance.new("Frame")
        container.Size = UDim2.new(1, -112, 1, -36)
        container.Position = UDim2.new(0, 112, 0, 36)
        container.BackgroundTransparency = 1
        container.Parent = main

        self.ScreenName = screenName
        self.Screen = screen
        self.Main = main
        self.NotifContainer = notifHolder
        self.Container = container
        self.Sidebar = sidebar
        self.TargetSize = size
        self.Glow = glow
        self.MainStroke = mainStroke

        task.delay(0.4, function()
            self:Notify({Title = "PhantomLib", Content = "Interface loaded", Duration = 2})
        end)

        return self
    end

    if opts.KeySystem then
        self:CreateKeySystem(opts.KeySystem, function()
            finishCreate()
        end)
        return self
    else
        return finishCreate()
    end
end

