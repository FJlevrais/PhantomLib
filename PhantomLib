        Border     = Color3.fromRGB(40, 40, 48)
    },
    Light = {
        Background = Color3.fromRGB(245, 245, 248),
        Sidebar    = Color3.fromRGB(230, 232, 238),
        Card       = Color3.fromRGB(255, 255, 255),
        Accent     = Color3.fromRGB(79, 70, 229),
        Text       = Color3.fromRGB(25, 25, 30),
        Muted      = Color3.fromRGB(110, 110, 120),
        Border     = Color3.fromRGB(215, 220, 228)
    },
    Cyberpunk = {
        Background = Color3.fromRGB(13, 13, 22),
        Sidebar    = Color3.fromRGB(8, 8, 14),
        Card       = Color3.fromRGB(22, 22, 36),
        Accent     = Color3.fromRGB(255, 0, 128),
        Text       = Color3.fromRGB(0, 240, 255),
