--[[
    AuroraUI
    Modern Roblox UI Library
    Style inspired by clean dark hubs (sidebar + rounded sections)
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local AuroraUI = {
    Version = "1.1.0",
    Flags = {},
    Themes = {
        Dark = {
            Background   = Color3.fromRGB(17, 17, 21),
            Secondary    = Color3.fromRGB(24, 24, 30),
            Tertiary     = Color3.fromRGB(32, 32, 40),
            Accent       = Color3.fromRGB(99, 102, 241),
            AccentHover  = Color3.fromRGB(129, 140, 248),
            Text         = Color3.fromRGB(240, 240, 245),
            TextDim      = Color3.fromRGB(150, 150, 165),
            Border       = Color3.fromRGB(42, 42, 52),
            Success      = Color3.fromRGB(52, 211, 153),
            Danger       = Color3.fromRGB(248, 113, 113),
        }
    }
}

local Theme = AuroraUI.Themes.Dark

--// Helpers
local function Create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            obj[k] = v
        end
    end
    if props and props.Parent then
        obj.Parent = props.Parent
    end
    return obj
end

local function Tween(obj, props, time)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function MakeDraggable(frame, handle)
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

--// Create Window
function AuroraUI:CreateWindow(config)
    config = config or {}
    local Title = config.Title or "Aurora"
    local Size = config.Size or UDim2.fromOffset(580, 400)

    local ScreenGui = Create("ScreenGui", {
        Name = "AuroraUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = game:GetService("CoreGui")
    })

    local Main = Create("Frame", {
        Name = "Main",
        Size = Size,
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = ScreenGui
    })
    Create("UICorner", { CornerRadius = UDim.new(0, 12), Parent = Main })
    Create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = Main })

    -- Topbar
    local TopBar = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        Parent = Main
    })
    Create("UICorner", { CornerRadius = UDim.new(0, 12), Parent = TopBar })
    Create("Frame", { -- cover bottom corners
        Size = UDim2.new(1, 0, 0, 14),
        Position = UDim2.new(0, 0, 1, -14),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        Parent = TopBar
    })

    Create("TextLabel", {
        Size = UDim2.new(1, -90, 1, 0),
        Position = UDim2.fromOffset(16, 0),
        BackgroundTransparency = 1,
        Text = Title,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = TopBar
    })

    local Minimize = Create("TextButton", {
        Size = UDim2.fromOffset(30, 30),
        Position = UDim2.new(1, -68, 0.5, -15),
        BackgroundTransparency = 1,
        Text = "−",
        TextColor3 = Theme.TextDim,
        Font = Enum.Font.GothamBold,
        TextSize = 20,
        Parent = TopBar
    })

    local Close = Create("TextButton", {
        Size = UDim2.fromOffset(30, 30),
        Position = UDim2.new(1, -34, 0.5, -15),
        BackgroundTransparency = 1,
        Text = "×",
        TextColor3 = Theme.TextDim,
        Font = Enum.Font.GothamBold,
        TextSize = 20,
        Parent = TopBar
    })

    Close.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)

    local minimized = false
    Minimize.MouseButton1Click:Connect(function()
        minimized = not minimized
        Tween(Main, { Size = minimized and UDim2.fromOffset(Size.X.Offset, 44) or Size }, 0.28)
    end)

    MakeDraggable(Main, TopBar)

    -- Sidebar
    local Sidebar = Create("Frame", {
        Size = UDim2.new(0, 148, 1, -44),
        Position = UDim2.fromOffset(0, 44),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        Parent = Main
    })

    local SidebarScroll = Create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = Sidebar
    })
    Create("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = SidebarScroll
    })
    Create("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
        Parent = SidebarScroll
    })

    -- Content
    local Content = Create("Frame", {
        Size = UDim2.new(1, -148, 1, -44),
        Position = UDim2.fromOffset(148, 44),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = Main
    })

    local Pages = {}
    local SelectedTab = nil

    local Window = {}

    function Window:CreateTab(tabConfig)
        tabConfig = tabConfig or {}
        local Name = tabConfig.Name or "Tab"
        local Icon = tabConfig.Icon or "•"

        local Button = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 38),
            BackgroundTransparency = 1,
            Text = "",
            Parent = SidebarScroll
        })
        Create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = Button })

        local IconLbl = Create("TextLabel", {
            Size = UDim2.fromOffset(30, 30),
            Position = UDim2.fromOffset(6, 4),
            BackgroundTransparency = 1,
            Text = Icon,
            TextColor3 = Theme.TextDim,
            Font = Enum.Font.GothamBold,
            TextSize = 16,
            Parent = Button
        })

        local NameLbl = Create("TextLabel", {
            Size = UDim2.new(1, -42, 1, 0),
            Position = UDim2.fromOffset(38, 0),
            BackgroundTransparency = 1,
            Text = Name,
            TextColor3 = Theme.TextDim,
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = Button
        })

        local Page = Create("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 4,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
            Parent = Content
        })
        Create("UIListLayout", {
            Padding = UDim.new(0, 12),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = Page
        })
        Create("UIPadding", {
            PaddingTop = UDim.new(0, 14),
            PaddingBottom = UDim.new(0, 14),
            PaddingLeft = UDim.new(0, 16),
            PaddingRight = UDim.new(0, 16),
            Parent = Page
        })

        Pages[Name] = Page

        local function Select()
            if SelectedTab then
                SelectedTab.BackgroundTransparency = 1
                local oldIcon = SelectedTab:FindFirstChildOfClass("TextLabel")
                if oldIcon then oldIcon.TextColor3 = Theme.TextDim end
                for _, child in ipairs(SelectedTab:GetChildren()) do
                    if child:IsA("TextLabel") and child ~= oldIcon then
                        child.TextColor3 = Theme.TextDim
                    end
                end
            end

            for _, p in pairs(Pages) do
                p.Visible = false
            end

            Button.BackgroundTransparency = 0
            Button.BackgroundColor3 = Theme.Accent
            IconLbl.TextColor3 = Color3.new(1, 1, 1)
            NameLbl.TextColor3 = Color3.new(1, 1, 1)
            Page.Visible = true
            SelectedTab = Button
        end

        Button.MouseButton1Click:Connect(Select)

        if not SelectedTab then
            Select()
        end

        local Tab = { Page = Page }

        -- Section
        function Tab:Section(secConfig)
            secConfig = secConfig or {}
            local Title = secConfig.Title or ""

            local Section = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Theme.Secondary,
                BorderSizePixel = 0,
                Parent = Page
            })
            Create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = Section })
            Create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = Section })
            Create("UIListLayout", {
                Padding = UDim.new(0, 8),
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = Section
            })
            Create("UIPadding", {
                PaddingTop = UDim.new(0, 12),
                PaddingBottom = UDim.new(0, 12),
                PaddingLeft = UDim.new(0, 14),
                PaddingRight = UDim.new(0, 14),
                Parent = Section
            })

            if Title ~= "" then
                Create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 18),
                    BackgroundTransparency = 1,
                    Text = Title,
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.GothamBold,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Section
                })
            end

            local Sec = { Frame = Section }

            -- Toggle
            function Sec:Toggle(cfg)
                cfg = cfg or {}
                local Flag = cfg.Flag
                local Default = cfg.Default or false
                local Callback = cfg.Callback or function() end

                local Row = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundTransparency = 1,
                    Parent = Section
                })

                Create("TextLabel", {
                    Size = UDim2.new(1, -55, 1, 0),
                    BackgroundTransparency = 1,
                    Text = cfg.Name or "Toggle",
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Row
                })

                local Track = Create("Frame", {
                    Size = UDim2.fromOffset(44, 24),
                    Position = UDim2.new(1, -44, 0.5, -12),
                    BackgroundColor3 = Theme.Tertiary,
                    Parent = Row
                })
                Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Track })

                local Knob = Create("Frame", {
                    Size = UDim2.fromOffset(18, 18),
                    Position = UDim2.fromOffset(3, 3),
                    BackgroundColor3 = Theme.TextDim,
                    Parent = Track
                })
                Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Knob })

                local state = Default
                if Flag then AuroraUI.Flags[Flag] = state end

                local function Set(val)
                    state = val
                    if Flag then AuroraUI.Flags[Flag] = val end
                    Tween(Track, { BackgroundColor3 = val and Theme.Accent or Theme.Tertiary }, 0.2)
                    Tween(Knob, {
                        Position = val and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3),
                        BackgroundColor3 = val and Color3.new(1,1,1) or Theme.TextDim
                    }, 0.2)
                    Callback(val)
                end

                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Set(not state)
                    end
                end)

                if Default then Set(true) end

                return { Set = Set, Get = function() return state end }
            end

            -- Button
            function Sec:Button(cfg)
                cfg = cfg or {}
                local Btn = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = Theme.Accent,
                    Text = cfg.Name or "Button",
                    TextColor3 = Color3.new(1,1,1),
                    Font = Enum.Font.GothamMedium,
                    TextSize = 13,
                    Parent = Section
                })
                Create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = Btn })

                Btn.MouseButton1Click:Connect(function()
                    if cfg.Callback then cfg.Callback() end
                end)

                Btn.MouseEnter:Connect(function()
                    Tween(Btn, { BackgroundColor3 = Theme.AccentHover }, 0.15)
                end)
                Btn.MouseLeave:Connect(function()
                    Tween(Btn, { BackgroundColor3 = Theme.Accent }, 0.15)
                end)

                return Btn
            end

            -- Dropdown (simple cycle for now)
            function Sec:Dropdown(cfg)
                cfg = cfg or {}
                local Options = cfg.Options or { "Option 1" }
                local Current = cfg.Default or Options[1]
                local Flag = cfg.Flag
                local Callback = cfg.Callback or function() end

                local Row = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundTransparency = 1,
                    Parent = Section
                })

                Create("TextLabel", {
                    Size = UDim2.new(0.45, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = cfg.Name or "Dropdown",
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Row
                })

                local Drop = Create("TextButton", {
                    Size = UDim2.new(0.52, 0, 0, 28),
                    Position = UDim2.new(0.48, 0, 0.5, -14),
                    BackgroundColor3 = Theme.Tertiary,
                    Text = Current .. "  ▼",
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    Parent = Row
                })
                Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Drop })

                if Flag then AuroraUI.Flags[Flag] = Current end

                Drop.MouseButton1Click:Connect(function()
                    local idx = table.find(Options, Current) or 1
                    idx = idx % #Options + 1
                    Current = Options[idx]
                    Drop.Text = Current .. "  ▼"
                    if Flag then AuroraUI.Flags[Flag] = Current end
                    Callback(Current)
                end)

                return {
                    Set = function(v)
                        Current = v
                        Drop.Text = v .. "  ▼"
                        if Flag then AuroraUI.Flags[Flag] = v end
                    end
                }
            end

            -- Slider
            function Sec:Slider(cfg)
                cfg = cfg or {}
                local Min = cfg.Min or 0
                local Max = cfg.Max or 100
                local Default = cfg.Default or Min
                local Flag = cfg.Flag
                local Callback = cfg.Callback or function() end

                local Row = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 48),
                    BackgroundTransparency = 1,
                    Parent = Section
                })

                local Title = Create("TextLabel", {
                    Size = UDim2.new(1, -50, 0, 18),
                    BackgroundTransparency = 1,
                    Text = (cfg.Name or "Slider") .. ": " .. Default,
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Row
                })

                local Track = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 6),
                    Position = UDim2.fromOffset(0, 28),
                    BackgroundColor3 = Theme.Tertiary,
                    Parent = Row
                })
                Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Track })

                local Fill = Create("Frame", {
                    Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0),
                    BackgroundColor3 = Theme.Accent,
                    Parent = Track
                })
                Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Fill })

                local value = Default
                if Flag then AuroraUI.Flags[Flag] = value end

                local dragging = false
                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                        value = math.floor(Min + (Max - Min) * pos)
                        Fill.Size = UDim2.new(pos, 0, 1, 0)
                        Title.Text = (cfg.Name or "Slider") .. ": " .. value
                        if Flag then AuroraUI.Flags[Flag] = value end
                        Callback(value)
                    end
                end)

                return {
                    Set = function(v)
                        value = math.clamp(v, Min, Max)
                        local pos = (value - Min) / (Max - Min)
                        Fill.Size = UDim2.new(pos, 0, 1, 0)
                        Title.Text = (cfg.Name or "Slider") .. ": " .. value
                        if Flag then AuroraUI.Flags[Flag] = value end
                    end
                }
            end

            -- Input
            function Sec:Input(cfg)
                cfg = cfg or {}
                local Flag = cfg.Flag
                local Callback = cfg.Callback or function() end

                local Row = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundTransparency = 1,
                    Parent = Section
                })

                Create("TextLabel", {
                    Size = UDim2.new(0.4, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = cfg.Name or "Input",
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Row
                })

                local Box = Create("TextBox", {
                    Size = UDim2.new(0.58, 0, 0, 28),
                    Position = UDim2.new(0.42, 0, 0.5, -14),
                    BackgroundColor3 = Theme.Tertiary,
                    Text = cfg.Default or "",
                    PlaceholderText = cfg.Placeholder or "",
                    TextColor3 = Theme.Text,
                    PlaceholderColor3 = Theme.TextDim,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    ClearTextOnFocus = false,
                    Parent = Row
                })
                Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Box })
                Create("UIPadding", { PaddingLeft = UDim.new(0, 8), Parent = Box })

                if Flag then AuroraUI.Flags[Flag] = Box.Text end

                Box.FocusLost:Connect(function()
                    if Flag then AuroraUI.Flags[Flag] = Box.Text end
                    Callback(Box.Text)
                end)

                return Box
            end

            -- Label
            function Sec:Label(text)
                return Create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text or "",
                    TextColor3 = Theme.TextDim,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    Parent = Section
                })
            end

            return Sec
        end

        return Tab
    end

    -- Simple notification
    function Window:Notify(cfg)
        cfg = cfg or {}
        local Notif = Create("Frame", {
            Size = UDim2.fromOffset(260, 70),
            Position = UDim2.new(1, -280, 1, -90),
            BackgroundColor3 = Theme.Secondary,
            BorderSizePixel = 0,
            Parent = ScreenGui
        })
        Create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = Notif })
        Create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = Notif })

        Create("TextLabel", {
            Size = UDim2.new(1, -16, 0, 22),
            Position = UDim2.fromOffset(12, 10),
            BackgroundTransparency = 1,
            Text = cfg.Title or "Notification",
            TextColor3 = Theme.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = Notif
        })

        Create("TextLabel", {
            Size = UDim2.new(1, -16, 0, 28),
            Position = UDim2.fromOffset(12, 32),
            BackgroundTransparency = 1,
            Text = cfg.Content or "",
            TextColor3 = Theme.TextDim,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Parent = Notif
        })

        task.delay(cfg.Duration or 3, function()
            Tween(Notif, { BackgroundTransparency = 1 }, 0.3)
            task.wait(0.3)
            Notif:Destroy()
        end)
    end

    return Window
end

return AuroraUI
