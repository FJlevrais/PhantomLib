            Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1,
            Text = cfg.Name or "Color Picker",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame
        })

        local preview = create("TextButton", {
            Size = UDim2.fromOffset(28, 20),
            Position = UDim2.new(1, -42, 0, 11),
            BackgroundColor3 = current,
            Text = "",
            Parent = frame
        })
        create("UICorner", { CornerRadius = UDim.new(0, 5), Parent = preview })

        local hueTrack = create("Frame", {
            Size = UDim2.new(1, -28, 0, 14),
            Position = UDim2.new(0, 14, 0, 52),
            BackgroundColor3 = Color3.new(1,1,1),
            Parent = frame
        })
        create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = hueTrack })
        create("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,0,0)),
                ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255,255,0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
                ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0,255,255)),
                ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0,0,255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
                ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,0,0))
            }),
            Parent = hueTrack
        })

        local function applyColor()
            current = Color3.fromHSV(h, s, v)
            preview.BackgroundColor3 = current
            if cfg.Flag then self.Window.Flags[cfg.Flag] = current end
            if cfg.Callback then pcall(cfg.Callback, current) end
        end

        local hueTrigger = create("TextButton", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
            Parent = hueTrack
        })
        local hueDragging = false
        hueTrigger.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                hueDragging = true
                local rel = math.clamp((input.Position.X - hueTrack.AbsolutePosition.X) / hueTrack.AbsoluteSize.X, 0, 1)
                h = 1 - rel
                applyColor()
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                hueDragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if hueDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local rel = math.clamp((input.Position.X - hueTrack.AbsolutePosition.X) / hueTrack.AbsoluteSize.X, 0, 1)
                h = 1 - rel
                applyColor()
            end
        end)

        preview.MouseButton1Click:Connect(function()
            expanded = not expanded
            tween(frame, 0.22, { Size = UDim2.new(1, 0, 0, expanded and 80 or 42) })
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = current end
        return { Set = function(_, color) current = color; h,s,v = Color3.toHSV(color); applyColor() end }
    end

    return tabData
end

function PhantomLib:Destroy()
    if self.Screen then self.Screen:Destroy() end
    self.Closed = true
end

function PhantomLib:SetTheme(themeName)
    local newTheme = PhantomLib.Themes[themeName]
    if newTheme then
        self.Theme = newTheme
        self.ThemeName = themeName
    end
end

return PhantomLib
