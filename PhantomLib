local PhantomLib = {
    Flags = {},
    Themes = {
        Default = { 
            Background = Color3.fromRGB(20, 20, 26), 
            Sidebar = Color3.fromRGB(15, 15, 20), 
            Card = Color3.fromRGB(30, 30, 40), 
            Accent = Color3.fromRGB(85, 170, 255), 
            Text = Color3.fromRGB(245, 245, 255), 
            Muted = Color3.fromRGB(150, 150, 170), 
            Border = Color3.fromRGB(45, 45, 60), 
            Red = Color3.fromRGB(255, 75, 75), 
            Yellow = Color3.fromRGB(255, 170, 0) 
        }
    }
}
PhantomLib.__index = PhantomLib

local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local StatsService = game:GetService("Stats")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

local function springTween(object, duration, properties)
    local info = TweenInfo.new(duration or 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local anim = TweenService:Create(object, info, properties)
    anim:Play()
    return anim
end

local function smoothTween(object, duration, properties)
    local info = TweenInfo.new(duration or 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local anim = TweenService:Create(object, info, properties)
    anim:Play()
    return anim
end

local function getGuiParent()
    local success, target = pcall(function() return CoreGui end)
    return (success and target) and target or LocalPlayer:WaitForChild("PlayerGui")
end

-------------------------------------------------------------------------------
-- CONFIGURATION SERIALIZATION ENGINE
-------------------------------------------------------------------------------
local function serializeValue(val)
    if typeof(val) == "Color3" then
        return { __type = "Color3", r = val.R, g = val.G, b = val.B }
    elseif typeof(val) == "EnumItem" then
        return { __type = "EnumItem", enum = tostring(val.EnumType), name = val.Name }
    elseif type(val) == "table" then
        local t = {}
        for k, v in pairs(val) do t[k] = serializeValue(v) end
        return t
    end
    return val
end

local function deserializeValue(val)
    if type(val) == "table" and val.__type then
        if val.__type == "Color3" then
            return Color3.new(val.r, val.g, val.b)
        elseif val.__type == "EnumItem" and Enum[val.enum] then
            return Enum[val.enum][val.name]
        end
    elseif type(val) == "table" then
        local t = {}
        for k, v in pairs(val) do t[k] = deserializeValue(v) end
        return t
    end
    return val
end

function PhantomLib:SaveConfig()
    if not writefile then return end
    local preparedFlags = {}
    for flag, val in pairs(self.Flags) do
        preparedFlags[flag] = serializeValue(val)
    end
    pcall(function()
        writefile(self.ConfigName, HttpService:JSONEncode(preparedFlags))
    end)
end

function PhantomLib:LoadConfig()
    if not readfile or not isfile or not isfile(self.ConfigName) then return end
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(self.ConfigName))
    end)
    if success and type(result) == "table" then
        for flag, val in pairs(result) do
            self.Flags[flag] = deserializeValue(val)
        end
    end
end

