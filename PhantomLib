local function createSearchableList(parent, options, cfg)
    cfg = cfg or {}
    local itemHeight = cfg.ItemHeight or 28
    local maxVisible = cfg.MaxVisible or 6
    local searchPlaceholder = cfg.SearchPlaceholder or "Search..."
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 0)
    container.BackgroundTransparency = 1
    container.ClipsDescendants = true
    container.Parent = parent

    -- Search bar
    local searchBox = Instance.new("Frame")
    searchBox.Size = UDim2.new(1, -8, 0, 28)
    searchBox.Position = UDim2.new(0, 4, 0, 0)
    searchBox.BackgroundColor3 = cfg.Theme.Sidebar
    searchBox.Parent = container
    corner(searchBox, 6)
    stroke(searchBox, cfg.Theme.Border, 1, 0.3)

    local searchIcon = Instance.new("TextLabel")
    searchIcon.Size = UDim2.fromOffset(20, 28)
    searchIcon.Position = UDim2.new(0, 4, 0, 0)
    searchIcon.BackgroundTransparency = 1
    searchIcon.Text = "🔍"
    searchIcon.TextColor3 = cfg.Theme.Muted
    searchIcon.TextSize = 12
    searchIcon.Font = Enum.Font.Gotham
    searchIcon.Parent = searchBox

    local searchInput = Instance.new("TextBox")
    searchInput.Size = UDim2.new(1, -28, 1, 0)
    searchInput.Position = UDim2.new(0, 24, 0, 0)
    searchInput.BackgroundTransparency = 1
    searchInput.PlaceholderText = searchPlaceholder
    searchInput.PlaceholderColor3 = cfg.Theme.Muted
    searchInput.TextColor3 = cfg.Theme.Text
    searchInput.TextSize = 12
    searchInput.Font = Enum.Font.Gotham
    searchInput.ClearTextOnFocus = false
    searchInput.Text = ""
    searchInput.Parent = searchBox

    -- List container
    local listContainer = Instance.new("Frame")
    listContainer.Size = UDim2.new(1, 0, 0, 0)
    listContainer.Position = UDim2.new(0, 0, 0, 36)
    listContainer.BackgroundTransparency = 1
    listContainer.ClipsDescendants = true
    listContainer.Parent = container

    local listFrame = Instance.new("ScrollingFrame")
    listFrame.Size = UDim2.new(1, 0, 0, 0)
    listFrame.BackgroundTransparency = 1
    listFrame.BorderSizePixel = 0
    listFrame.ScrollBarThickness = 3
    listFrame.ScrollBarImageColor3 = cfg.Theme.Accent
    listFrame.ScrollBarImageTransparency = 0.4
    listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    listFrame.ClipsDescendants = true
    listFrame.Parent = listContainer

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 2)
    listLayout.Parent = listFrame
    padding(listFrame, 2, 2, 2, 2)

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        listFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 4)
    end)

    local buttons = {}
    local filteredOptions = {}
    local selectedItems = {}
    
    -- Helper to update visibility and height
    local function updateContainerHeight(count)
        local visibleCount = math.min(count or #filteredOptions, maxVisible)
        local totalHeight = 36 + (visibleCount * (itemHeight + 2)) + 4
        container.Size = UDim2.new(1, 0, 0, totalHeight)
        listFrame.Size = UDim2.new(1, 0, 0, visibleCount * (itemHeight + 2) + 4)
    end

    -- Create/update list items
    local function buildList(filterText)
        filterText = string.lower(filterText or "")
        
        -- Clear existing buttons
        for _, btn in pairs(buttons) do
            btn:Destroy()
        end
        buttons = {}
        
        -- Filter options
        filteredOptions = {}
        if filterText == "" then
            for _, opt in ipairs(options) do
                table.insert(filteredOptions, opt)
            end
        else
            for _, opt in ipairs(options) do
                if string.find(string.lower(tostring(opt)), filterText, 1, true) then
                    table.insert(filteredOptions, opt)
                end
            end
        end
        
        -- Create buttons for filtered options
        for _, opt in ipairs(filteredOptions) do
            local isSelected = selectedItems[opt] == true
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, itemHeight)
            btn.BackgroundColor3 = isSelected and cfg.Theme.Accent or cfg.Theme.Card
            btn.BackgroundTransparency = isSelected and 0.3 or 0.65
            btn.Text = ""
            btn.AutoButtonColor = false
            btn.Parent = listFrame
            corner(btn, 5)
            
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -30, 1, 0)
            lbl.Position = UDim2.new(0, 8, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = tostring(opt)
            lbl.TextColor3 = cfg.Theme.Text
            lbl.TextSize = 12
            lbl.Font = Enum.Font.Gotham
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = btn
            
            local check = Instance.new("TextLabel")
            check.Size = UDim2.fromOffset(18, 18)
            check.Position = UDim2.new(1, -24, 0.5, -9)
            check.BackgroundTransparency = 1
            check.Text = isSelected and "✓" or ""
            check.TextColor3 = cfg.Theme.Accent
            check.TextSize = 14
            check.Font = Enum.Font.GothamBold
            check.Parent = btn
            
            btn.MouseEnter:Connect(function()
                if not isSelected then
                    tween(btn, 0.12, {BackgroundTransparency = 0.4})
                end
            end)
            btn.MouseLeave:Connect(function()
                if not isSelected then
                    tween(btn, 0.12, {BackgroundTransparency = 0.65})
                end
            end)
            
            btn.MouseButton1Click:Connect(function()
                if cfg.OnSelect then
                    cfg.OnSelect(opt, btn, check)
                end
            end)
            
            buttons[opt] = btn
        end
        
        updateContainerHeight(#filteredOptions)
    end

    -- Search input handler
    searchInput:GetPropertyChangedSignal("Text"):Connect(function()
        buildList(searchInput.Text)
    end)
    
    -- Initial build
    buildList("")
    
    -- Return useful functions
    return {
        Container = container,
        SearchBox = searchBox,
        SearchInput = searchInput,
        ListFrame = listFrame,
        Buttons = buttons,
        FilteredOptions = filteredOptions,
        SelectedItems = selectedItems,
        BuildList = buildList,
        SetOptions = function(newOptions)
            options = newOptions or {}
            selectedItems = {}
            buildList(searchInput.Text)
        end,
        GetSelected = function()
            local result = {}
            for k, v in pairs(selectedItems) do
                if v then table.insert(result, k) end
            end
            return result
        end,
        SetSelected = function(items)
            selectedItems = {}
            if type(items) == "table" then
                for _, v in ipairs(items) do
                    selectedItems[v] = true
                end
            end
            buildList(searchInput.Text)
        end,
        Clear = function()
            selectedItems = {}
            buildList(searchInput.Text)
        end
    }
end

