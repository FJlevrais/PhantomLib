        warn("Please keep the full CreatePlayerSelector from the previous version")
        return {}
    end
    function tabData:CreateInput(cfg)
        -- same as before
        return {}
    end
    function tabData:CreateKeybind(cfg)
        return {}
    end
    function tabData:CreateColorPicker(cfg)
        return {}
    end

    return tabData
end

function PhantomLib:Destroy()
    if self.Screen then
        self.Screen:Destroy()
    end
    self.Closed = true
end

function PhantomLib:SetTheme(themeName)
    local newTheme = PhantomLib.Themes[themeName]
    if newTheme then
        self.Theme = newTheme
        self.ThemeName = themeName
    end
end

return PhantomLib
