--[[
    PhantomLib - Upgraded Modern UI Library
    Features:
      - Native UIGradients & UICorners for sleek styling
      - Smooth TweenService animations for UI elements
      - Built-in Notification System
      - Core Components: Tabs, Toggles, Buttons, Text Inputs, and Sliders
--]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

local PhantomLib = {}
PhantomLib.__index = PhantomLib

-- Helper function to add rich dark gradients
local function applyGradient(instance, color1, color2, rotation)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, color1 or Color3.fromRGB(30, 32, 45)),
        ColorSequenceKeypoint.new(1, color2 or Color3.fromRGB(18, 19, 26))
    })
    gradient.Rotation = rotation or 45
    gradient.Parent = instance
    return gradient
end

-- Helper function for rounded corners
local function applyCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = instance
    return corner
end

-- ===================== LIBRARY INITIALIZATION =====================
function PhantomLib:CreateWindow(config)
    config = config or {}
    local windowName = config.Name or "Phantom Library"
    local windowSize = config.Size or UDim2.fromOffset(550, 420)

    -- ScreenGui
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "PhantomLib_" .. math.random(1000, 9999)
    ScreenGui.ResetOnSpawn = false

    pcall(function()
        ScreenGui.Parent = CoreGui
    end)
    if not ScreenGui.Parent then
        ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    -- Main Frame
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = windowSize
    MainFrame.Position = UDim2.fromScale(0.5, 0.5)
    MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    MainFrame.BackgroundColor3 = Color3.fromRGB(25, 27, 38)
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui

    applyCorner(MainFrame, 10)
    applyGradient(MainFrame, Color3.fromRGB(28, 30, 42), Color3.fromRGB(15, 16, 22), 60)

    -- Stroke Outline
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(60, 65, 90)
    Stroke.Thickness = 1
    Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Stroke.Parent = MainFrame

    -- Top Bar (Header)
    local TopBar = Instance.new("Frame")
    TopBar.Name = "TopBar"
    TopBar.Size = UDim2.new(1, 0, 0, 40)
    TopBar.BackgroundColor3 = Color3.fromRGB(35, 38, 52)
    TopBar.BorderSizePixel = 0
    TopBar.Parent = MainFrame

    applyCorner(TopBar, 10)
    applyGradient(TopBar, Color3.fromRGB(40, 44, 62), Color3.fromRGB(25, 27, 38), 0)

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Name = "Title"
    TitleLabel.Size = UDim2.new(1, -50, 1, 0)
    TitleLabel.Position = UDim2.new(0, 15, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = windowName
    TitleLabel.TextColor3 = Color3.fromRGB(240, 242, 255)
    TitleLabel.TextSize = 16
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Parent = TopBar

    -- Draggable TopBar Logic
    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    -- Sidebar Container (Tabs List)
    local SideBar = Instance.new("Frame")
    SideBar.Name = "SideBar"
    SideBar.Size = UDim2.new(0, 130, 1, -45)
    SideBar.Position = UDim2.new(0, 5, 0, 42)
    SideBar.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
    SideBar.BorderSizePixel = 0
    SideBar.Parent = MainFrame

    applyCorner(SideBar, 8)
    applyGradient(SideBar, Color3.fromRGB(22, 24, 34), Color3.fromRGB(14, 15, 20), 90)

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Padding = UDim.new(0, 5)
    TabListLayout.Parent = SideBar

    local TabPadding = Instance.new("UIPadding")
    TabPadding.PaddingTop = UDim.new(0, 5)
    TabPadding.PaddingLeft = UDim.new(0, 5)
    TabPadding.PaddingRight = UDim.new(0, 5)
    TabPadding.Parent = SideBar

    -- Content Area Container
    local ContentArea = Instance.new("Frame")
    ContentArea.Name = "ContentArea"
    ContentArea.Size = UDim2.new(1, -145, 1, -45)
    ContentArea.Position = UDim2.new(0, 140, 0, 42)
    ContentArea.BackgroundTransparency = 1
    ContentArea.Parent = MainFrame

    -- Notification Host Container
    local NotifyHolder = Instance.new("Frame")
    NotifyHolder.Name = "NotifyHolder"
    NotifyHolder.Size = UDim2.new(0, 220, 1, -20)
    NotifyHolder.Position = UDim2.new(1, -230, 0, 10)
    NotifyHolder.BackgroundTransparency = 1
    NotifyHolder.Parent = ScreenGui

    local NotifyLayout = Instance.new("UIListLayout")
    NotifyLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    NotifyLayout.SortOrder = Enum.SortOrder.LayoutOrder
    NotifyLayout.Padding = UDim.new(0, 8)
    NotifyLayout.Parent = NotifyHolder

    -- Window Methods Object
    local WindowObj = {
        ScreenGui = ScreenGui,
        MainFrame = MainFrame,
        ContentArea = ContentArea,
        SideBar = SideBar,
        Tabs = {},
        ActiveTab = nil
    }

    function WindowObj:Toggle()
        MainFrame.Visible = not MainFrame.Visible
    end

    function WindowObj:Rejoin()
        game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
    end

    function WindowObj:ServerHop()
        local HttpService = game:GetService("HttpService")
        local TeleportService = game:GetService("TeleportService")
        local serversUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        
        pcall(function()
            local raw = game:HttpGet(serversUrl)
            local data = HttpService:JSONDecode(raw)
            if data and data.data then
                for _, server in ipairs(data.data) do
                    if server.id ~= game.JobId and server.playing < server.maxPlayers then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                        break
                    end
                end
            end
        end)
    end

    function WindowObj:JoinSmallServer()
        local HttpService = game:GetService("HttpService")
        local TeleportService = game:GetService("TeleportService")
        local serversUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"

        pcall(function()
            local raw = game:HttpGet(serversUrl)
            local data = HttpService:JSONDecode(raw)
            if data and data.data then
                table.sort(data.data, function(a, b) return a.playing < b.playing end)
                for _, server in ipairs(data.data) do
                    if server.id ~= game.JobId and server.playing > 0 then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                        break
                    end
                end
            end
        end)
    end

    function WindowObj:Notify(nConfig)
        nConfig = nConfig or {}
        local nTitle = nConfig.Title or "Notification"
        local nContent = nConfig.Content or ""
        local nDuration = nConfig.Duration or 2.5

        local Frame = Instance.new("Frame")
        Frame.Size = UDim2.new(1, 0, 0, 50)
        Frame.BackgroundColor3 = Color3.fromRGB(30, 33, 46)
        Frame.BackgroundTransparency = 1
        Frame.Parent = NotifyHolder

        applyCorner(Frame, 8)
        applyGradient(Frame, Color3.fromRGB(45, 49, 68), Color3.fromRGB(22, 24, 34), 45)

        local NTitle = Instance.new("TextLabel")
        NTitle.Size = UDim2.new(1, -16, 0, 20)
        NTitle.Position = UDim2.new(0, 10, 0, 5)
        NTitle.BackgroundTransparency = 1
        NTitle.Text = nTitle
        NTitle.Font = Enum.Font.GothamBold
        NTitle.TextSize = 13
        NTitle.TextColor3 = Color3.fromRGB(120, 160, 255)
        NTitle.TextXAlignment = Enum.TextXAlignment.Left
        NTitle.Parent = Frame

        local NDesc = Instance.new("TextLabel")
        NDesc.Size = UDim2.new(1, -16, 0, 20)
        NDesc.Position = UDim2.new(0, 10, 0, 24)
        NDesc.BackgroundTransparency = 1
        NDesc.Text = nContent
        NDesc.Font = Enum.Font.Gotham
        NDesc.TextSize = 12
        NDesc.TextColor3 = Color3.fromRGB(220, 225, 240)
        NDesc.TextXAlignment = Enum.TextXAlignment.Left
        NDesc.Parent = Frame

        TweenService:Create(Frame, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()

        task.delay(nDuration, function()
            local fade = TweenService:Create(Frame, TweenInfo.new(0.3), {BackgroundTransparency = 1})
            fade:Play()
            fade.Completed:Connect(function()
                Frame:Destroy()
            end)
        end)
    end

    -- ===================== TAB SYSTEM =====================
    function WindowObj:CreateTab(tabName)
        local TabButton = Instance.new("TextButton")
        TabButton.Name = "TabBtn_" .. tabName
        TabButton.Size = UDim2.new(1, 0, 0, 32)
        TabButton.BackgroundColor3 = Color3.fromRGB(30, 32, 45)
        TabButton.BackgroundTransparency = 0.6
        TabButton.Text = tabName
        TabButton.TextColor3 = Color3.fromRGB(160, 165, 185)
        TabButton.Font = Enum.Font.GothamMedium
        TabButton.TextSize = 13
        TabButton.AutoButtonColor = false
        TabButton.Parent = SideBar

        applyCorner(TabButton, 6)
        local tabGradient = applyGradient(TabButton, Color3.fromRGB(50, 55, 75), Color3.fromRGB(25, 28, 38), 45)

        -- Scrollable Tab Content Container
        local TabPage = Instance.new("ScrollingFrame")
        TabPage.Name = "TabPage_" .. tabName
        TabPage.Size = UDim2.new(1, 0, 1, 0)
        TabPage.BackgroundTransparency = 1
        TabPage.ScrollBarThickness = 3
        TabPage.ScrollBarImageColor3 = Color3.fromRGB(80, 90, 120)
        TabPage.Visible = false
        TabPage.Parent = ContentArea

        local PageList = Instance.new("UIListLayout")
        PageList.SortOrder = Enum.SortOrder.LayoutOrder
        PageList.Padding = UDim.new(0, 6)
        PageList.Parent = TabPage

        local PagePadding = Instance.new("UIPadding")
        PagePadding.PaddingTop = UDim.new(0, 2)
        PagePadding.PaddingRight = UDim.new(0, 8)
        PagePadding.Parent = TabPage

        PageList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabPage.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 10)
        end)

        local TabObj = {
            Button = TabButton,
            Page = TabPage
        }

        local function activateTab()
            for _, t in pairs(WindowObj.Tabs) do
                t.Page.Visible = false
                TweenService:Create(t.Button, TweenInfo.new(0.2), {
                    BackgroundTransparency = 0.6,
                    TextColor3 = Color3.fromRGB(160, 165, 185)
                }):Play()
            end

            TabPage.Visible = true
            TweenService:Create(TabButton, TweenInfo.new(0.2), {
                BackgroundTransparency = 0,
                TextColor3 = Color3.fromRGB(255, 255, 255)
            }):Play()
            WindowObj.ActiveTab = TabObj
        end

        TabButton.MouseButton1Click:Connect(activateTab)

        if #WindowObj.Tabs == 0 then
            activateTab()
        end

        table.insert(WindowObj.Tabs, TabObj)

        -- ===================== TAB COMPONENTS =====================
        function TabObj:CreateToggle(tConfig)
            tConfig = tConfig or {}
            local tName = tConfig.Name or "Toggle"
            local currentValue = tConfig.CurrentValue or false
            local callback = tConfig.Callback or function() end

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 38)
            Frame.BackgroundColor3 = Color3.fromRGB(30, 33, 46)
            Frame.Parent = TabPage

            applyCorner(Frame, 6)
            applyGradient(Frame, Color3.fromRGB(38, 42, 58), Color3.fromRGB(22, 24, 34), 90)

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -55, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = tName
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextColor3 = Color3.fromRGB(220, 225, 240)
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local Switch = Instance.new("TextButton")
            Switch.Size = UDim2.new(0, 36, 0, 18)
            Switch.Position = UDim2.new(1, -46, 0.5, -9)
            Switch.BackgroundColor3 = currentValue and Color3.fromRGB(70, 120, 255) or Color3.fromRGB(50, 52, 65)
            Switch.Text = ""
            Switch.AutoButtonColor = false
            Switch.Parent = Frame

            applyCorner(Switch, 10)

            local Dot = Instance.new("Frame")
            Dot.Size = UDim2.new(0, 14, 0, 14)
            Dot.Position = currentValue and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
            Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Dot.Parent = Switch

            applyCorner(Dot, 10)

            local function setToggle(state)
                currentValue = state
                local targetBg = currentValue and Color3.fromRGB(70, 120, 255) or Color3.fromRGB(50, 52, 65)
                local targetDotPos = currentValue and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)

                TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = targetBg}):Play()
                TweenService:Create(Dot, TweenInfo.new(0.2), {Position = targetDotPos}):Play()

                pcall(callback, currentValue)
            end

            Switch.MouseButton1Click:Connect(function()
                setToggle(not currentValue)
            end)
        end

        function TabObj:CreateButton(bConfig)
            bConfig = bConfig or {}
            local bName = bConfig.Name or "Button"
            local callback = bConfig.Callback or function() end

            local Button = Instance.new("TextButton")
            Button.Size = UDim2.new(1, 0, 0, 36)
            Button.BackgroundColor3 = Color3.fromRGB(35, 38, 54)
            Button.Text = bName
            Button.TextColor3 = Color3.fromRGB(230, 235, 250)
            Button.Font = Enum.Font.GothamBold
            Button.TextSize = 13
            Button.AutoButtonColor = false
            Button.Parent = TabPage

            applyCorner(Button, 6)
            applyGradient(Button, Color3.fromRGB(50, 56, 80), Color3.fromRGB(28, 30, 42), 45)

            Button.MouseEnter:Connect(function()
                TweenService:Create(Button, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(45, 50, 70)}):Play()
            end)

            Button.MouseLeave:Connect(function()
                TweenService:Create(Button, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(35, 38, 54)}):Play()
            end)

            Button.MouseButton1Click:Connect(function()
                TweenService:Create(Button, TweenInfo.new(0.08), {Size = UDim2.new(0.98, 0, 0, 34)}):Play()
                task.wait(0.08)
                TweenService:Create(Button, TweenInfo.new(0.08), {Size = UDim2.new(1, 0, 0, 36)}):Play()
                pcall(callback)
            end)
        end

        function TabObj:CreateInput(iConfig)
            iConfig = iConfig or {}
            local iName = iConfig.Name or "Input"
            local placeholder = iConfig.PlaceholderText or "Type here..."
            local callback = iConfig.Callback or function() end

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 38)
            Frame.BackgroundColor3 = Color3.fromRGB(30, 33, 46)
            Frame.Parent = TabPage

            applyCorner(Frame, 6)
            applyGradient(Frame, Color3.fromRGB(38, 42, 58), Color3.fromRGB(22, 24, 34), 90)

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.5, -10, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = iName
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextColor3 = Color3.fromRGB(220, 225, 240)
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local TextBox = Instance.new("TextBox")
            TextBox.Size = UDim2.new(0.45, 0, 0, 24)
            TextBox.Position = UDim2.new(0.52, 0, 0.5, -12)
            TextBox.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
            TextBox.Text = ""
            TextBox.PlaceholderText = placeholder
            TextBox.TextColor3 = Color3.fromRGB(240, 240, 255)
            TextBox.PlaceholderColor3 = Color3.fromRGB(120, 125, 140)
            TextBox.Font = Enum.Font.Gotham
            TextBox.TextSize = 12
            TextBox.Parent = Frame

            applyCorner(TextBox, 4)

            TextBox.FocusLost:Connect(function(enterPressed)
                pcall(callback, TextBox.Text, enterPressed)
            end)
        end

        function TabObj:CreateSlider(sConfig)
            sConfig = sConfig or {}
            local sName = sConfig.Name or "Slider"
            local minVal = sConfig.Min or 0
            local maxVal = sConfig.Max or 100
            local defaultVal = sConfig.Default or minVal
            local callback = sConfig.Callback or function() end

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 48)
            Frame.BackgroundColor3 = Color3.fromRGB(30, 33, 46)
            Frame.Parent = TabPage

            applyCorner(Frame, 6)
            applyGradient(Frame, Color3.fromRGB(38, 42, 58), Color3.fromRGB(22, 24, 34), 90)

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -60, 0, 20)
            Label.Position = UDim2.new(0, 12, 0, 6)
            Label.BackgroundTransparency = 1
            Label.Text = sName
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextColor3 = Color3.fromRGB(220, 225, 240)
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local ValLabel = Instance.new("TextLabel")
            ValLabel.Size = UDim2.new(0, 45, 0, 20)
            ValLabel.Position = UDim2.new(1, -50, 0, 6)
            ValLabel.BackgroundTransparency = 1
            ValLabel.Text = tostring(defaultVal)
            ValLabel.Font = Enum.Font.GothamBold
            ValLabel.TextSize = 12
            ValLabel.TextColor3 = Color3.fromRGB(130, 170, 255)
            ValLabel.TextXAlignment = Enum.TextXAlignment.Right
            ValLabel.Parent = Frame

            local Track = Instance.new("TextButton")
            Track.Size = UDim2.new(1, -24, 0, 8)
            Track.Position = UDim2.new(0, 12, 0, 32)
            Track.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
            Track.Text = ""
            Track.AutoButtonColor = false
            Track.Parent = Frame

            applyCorner(Track, 4)

            local Fill = Instance.new("Frame")
            Fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
            Fill.BackgroundColor3 = Color3.fromRGB(70, 120, 255)
            Fill.Parent = Track

            applyCorner(Fill, 4)

            local sliding = false
            local function updateSlider(input)
                local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local val = math.floor(minVal + (maxVal - minVal) * pos)
                Fill.Size = UDim2.new(pos, 0, 1, 0)
                ValLabel.Text = tostring(val)
                pcall(callback, val)
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = true
                    updateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                    updateSlider(input)
                end
            end)
        end

        return TabObj
    end

    return WindowObj
end

return PhantomLib
