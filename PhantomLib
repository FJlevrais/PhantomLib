function PhantomLib:Rejoin()
    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
end

function PhantomLib:ServerHop()
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then return end
    local placeId = game.PlaceId
    local res = req({ Url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/0?sortOrder=Asc&limit=100", Method = "GET" })
    if res and res.StatusCode == 200 then
        local body = HttpService:JSONDecode(res.Body)
        if body and body.data then
            local valid = {}
            for _, s in ipairs(body.data) do
                if type(s) == "table" and s.id ~= game.JobId and s.playing < s.maxPlayers then
                    table.insert(valid, s.id)
                end
            end
            if #valid > 0 then
                TeleportService:TeleportToPlaceInstance(placeId, valid[math.random(1, #valid)], LocalPlayer)
            end
        end
    end
end

function PhantomLib:JoinSmallServer()
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then return end
    local placeId = game.PlaceId
    local cursor, targetId, minPlayers = "", nil, math.huge
    for _ = 1, 5 do
        local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/0?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
        local res = req({ Url = url, Method = "GET" })
        if res and res.StatusCode == 200 then
            local body = HttpService:JSONDecode(res.Body)
            if body and body.data then
                for _, s in ipairs(body.data) do
                    if type(s) == "table" and s.id ~= game.JobId and s.playing < s.maxPlayers and s.playing < minPlayers then
                        minPlayers = s.playing
                        targetId = s.id
                    end
                end
            end
            cursor = body.nextPageCursor or ""
            if cursor == "" then break end
        else
            break
        end
    end
    if targetId then
        TeleportService:TeleportToPlaceInstance(placeId, targetId, LocalPlayer)
    end
end

-- ─────────────────────────────────────────────
-- Tabs
-- ─────────────────────────────────────────────
function PhantomLib:CreateTab(tabName)
    local tabData = { Name = tabName, Window = self }

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = self.Theme.Card
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = self.Sidebar
    createCorner(btn, 6)

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0.55, 0)
    indicator.Position = UDim2.new(0, 0, 0.5, 0)
    indicator.AnchorPoint = Vector2.new(0, 0.5)
    indicator.BackgroundColor3 = self.Theme.Accent
    indicator.BackgroundTransparency = 1
    indicator.BorderSizePixel = 0
    indicator.Parent = btn
    createCorner(indicator, 2)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -14, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = tabName
    label.TextColor3 = self.Theme.Muted
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btn

    local view = Instance.new("ScrollingFrame")
    view.Size = UDim2.new(1, 0, 1, 0)
    view.BackgroundTransparency = 1
    view.Visible = false
    view.ScrollBarThickness = 3
    view.ScrollBarImageColor3 = self.Theme.Accent
    view.ScrollBarImageTransparency = 0.35
    view.BorderSizePixel = 0
    view.ClipsDescendants = true
    view.CanvasSize = UDim2.new(0, 0, 0, 0)
    view.Parent = self.Container

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.Parent = view

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 8)
    pad.PaddingLeft = UDim.new(0, 8)
    pad.PaddingRight = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 10)
    pad.Parent = view

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        view.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 16)
    end)

    tabData.Button    = btn
    tabData.View      = view
    tabData.Indicator = indicator
    tabData.Label     = label

    local function selectTab()
        for _, tab in ipairs(self.Tabs) do
            tab.View.Visible = false
            tween(tab.Button, 0.18, { BackgroundTransparency = 1 })
            tween(tab.Indicator, 0.18, { BackgroundTransparency = 1 })
            tween(tab.Label, 0.18, { TextColor3 = self.Theme.Muted })
        end
        view.Visible = true
        tween(btn, 0.2, { BackgroundTransparency = 0.55 })
        tween(indicator, 0.2, { BackgroundTransparency = 0 })
        tween(label, 0.2, { TextColor3 = self.Theme.Text })
        self.ActiveTab = tabData
    end

    btn.MouseButton1Click:Connect(selectTab)
    btn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tabData then
            tween(btn, 0.15, { BackgroundTransparency = 0.75 })
            tween(label, 0.15, { TextColor3 = self.Theme.Text })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab ~= tabData then
            tween(btn, 0.15, { BackgroundTransparency = 1 })
            tween(label, 0.15, { TextColor3 = self.Theme.Muted })
        end
    end)

    if #self.Tabs == 0 then selectTab() end
    table.insert(self.Tabs, tabData)

    -- Button
    function tabData:CreateButton(cfg)
        cfg = cfg or {}
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 32)
        b.BackgroundColor3 = self.Window.Theme.ButtonGradTop
        b.BackgroundTransparency = 0.15
        b.Text = cfg.Name or "Button"
        b.TextColor3 = self.Window.Theme.Text
        b.TextSize = 12
        b.Font = Enum.Font.GothamBold
        b.AutoButtonColor = false
        b.Parent = view
        createCorner(b, 6)
        local stroke = createStroke(b, self.Window.Theme.Accent, 1, 0.55)

        b.BackgroundTransparency = 1
        b.TextTransparency = 1
        tween(b, 0.3, { BackgroundTransparency = 0.15, TextTransparency = 0 })

        b.MouseEnter:Connect(function()
            tween(b, 0.18, { BackgroundTransparency = 0, BackgroundColor3 = self.Window.Theme.Accent })
            tween(stroke, 0.18, { Transparency = 0.2, Color = self.Window.Theme.GradientAccent })
            spring(b, 0.22, { Size = UDim2.new(1, 0, 0, 34) })
        end)
        b.MouseLeave:Connect(function()
            tween(b, 0.2, { BackgroundTransparency = 0.15, BackgroundColor3 = self.Window.Theme.ButtonGradTop, Size = UDim2.new(1, 0, 0, 32) })
            tween(stroke, 0.2, { Transparency = 0.55, Color = self.Window.Theme.Accent })
        end)
        b.MouseButton1Down:Connect(function()
            tween(b, 0.08, { Size = UDim2.new(1, 0, 0, 30) })
        end)
        b.MouseButton1Up:Connect(function()
            spring(b, 0.2, { Size = UDim2.new(1, 0, 0, 34) })
        end)
        b.MouseButton1Click:Connect(function()
            if cfg.Callback then pcall(cfg.Callback) end
        end)
    end

    -- Toggle
    function tabData:CreateToggle(cfg)
        cfg = cfg or {}
        local state = cfg.CurrentValue or false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 30)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.BackgroundTransparency = 0.3
        frame.Parent = view
        createCorner(frame, 6)
        createStroke(frame, self.Window.Theme.Border, 1, 0.5)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -48, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = cfg.Name or "Toggle"
        label.TextColor3 = self.Window.Theme.Text
        label.TextSize = 12
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local track = Instance.new("Frame")
        track.Size = UDim2.fromOffset(34, 18)
        track.Position = UDim2.new(1, -42, 0.5, -9)
        track.BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Sidebar
        track.Parent = frame
        createCorner(track, 9)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(14, 14)
        knob.Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.Parent = track
        createCorner(knob, 7)

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 0)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = frame

        local toggleObj = {}

        local function update(newState)
            state = newState
            tween(track, 0.22, { BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Sidebar })
            spring(knob, 0.28, { Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7) })
            if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
            if cfg.Callback then pcall(cfg.Callback, state) end
        end

        function toggleObj:Set(val) update(val) end
        function toggleObj:Get() return state end

        trigger.MouseButton1Click:Connect(function()
            update(not state)
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
        table.insert(self.Window.ToggleObjects, toggleObj)
        return toggleObj
    end

    -- Slider
    function tabData:CreateSlider(cfg)
        cfg = cfg or {}
        local min = cfg.Range and cfg.Range[1] or 0
        local max = cfg.Range and cfg.Range[2] or 100
        local val = math.clamp(cfg.CurrentValue or min, min, max)

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 42)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.BackgroundTransparency = 0.3
        frame.Parent = view
        createCorner(frame, 6)
        createStroke(frame, self.Window.Theme.Border, 1, 0.5)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.7, 0, 0, 16)
        title.Position = UDim2.new(0, 10, 0, 6)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Slider"
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 12
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local valDisplay = Instance.new("TextLabel")
        valDisplay.Size = UDim2.new(0.3, -10, 0, 16)
        valDisplay.Position = UDim2.new(0.7, 0, 0, 6)
        valDisplay.BackgroundTransparency = 1
        valDisplay.Text = tostring(val) .. (cfg.Suffix or "")
        valDisplay.TextColor3 = self.Window.Theme.Accent
        valDisplay.TextSize = 12
        valDisplay.Font = Enum.Font.GothamBold
        valDisplay.TextXAlignment = Enum.TextXAlignment.Right
        valDisplay.Parent = frame

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -20, 0, 5)
        track.Position = UDim2.new(0, 10, 0, 28)
        track.BackgroundColor3 = self.Window.Theme.Sidebar
        track.Parent = frame
        createCorner(track, 3)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((val - min) / math.max(max - min, 1), 0, 1, 0)
        fill.BackgroundColor3 = self.Window.Theme.Accent
        fill.Parent = track
        createCorner(fill, 3)

        local handle = Instance.new("Frame")
        handle.Size = UDim2.fromOffset(12, 12)
        handle.Position = UDim2.new((val - min) / math.max(max - min, 1), -6, 0.5, -6)
        handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        handle.Parent = track
        createCorner(handle, 6)
        createStroke(handle, self.Window.Theme.Accent, 1.5, 0.2)

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 14)
        trigger.Position = UDim2.new(0, 0, 0, -5)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = track

        local dragging = false

        local function update(input)
            local percent = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = math.floor(min + ((max - min) * percent) + 0.5)
            valDisplay.Text = tostring(val) .. (cfg.Suffix or "")
            tween(fill, 0.06, { Size = UDim2.new(percent, 0, 1, 0) })
            tween(handle, 0.06, { Position = UDim2.new(percent, -6, 0.5, -6) })
            if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
            if cfg.Callback then pcall(cfg.Callback, val) end
        end

        trigger.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input)
                spring(handle, 0.2, { Size = UDim2.fromOffset(14, 14) })
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                spring(handle, 0.2, { Size = UDim2.fromOffset(12, 12) })
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input)
            end
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
    end

    -- Input
    function tabData:CreateInput(cfg)
        cfg = cfg or {}
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 32)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.BackgroundTransparency = 0.3
        frame.Parent = view
        createCorner(frame, 6)
        createStroke(frame, self.Window.Theme.Border, 1, 0.5)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.42, 0, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = cfg.Name or "Input"
        label.TextColor3 = self.Window.Theme.Text
        label.TextSize = 12
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local boxBg = Instance.new("Frame")
        boxBg.Size = UDim2.new(0.55, -8, 0, 22)
        boxBg.Position = UDim2.new(0.45, 0, 0.5, -11)
        boxBg.BackgroundColor3 = self.Window.Theme.Sidebar
        boxBg.Parent = frame
        createCorner(boxBg, 5)

        local input = Instance.new("TextBox")
        input.Size = UDim2.new(1, -10, 1, 0)
        input.Position = UDim2.new(0, 6, 0, 0)
        input.BackgroundTransparency = 1
        input.Text = cfg.CurrentValue or ""
        input.PlaceholderText = cfg.PlaceholderText or "Type here..."
        input.TextColor3 = self.Window.Theme.Text
        input.PlaceholderColor3 = self.Window.Theme.Muted
        input.TextSize = 11
        input.Font = Enum.Font.Gotham
        input.TextXAlignment = Enum.TextXAlignment.Left
        input.ClearTextOnFocus = false
        input.Parent = boxBg

        input.Focused:Connect(function()
            tween(boxBg, 0.18, { BackgroundColor3 = self.Window.Theme.Card })
        end)
        input.FocusLost:Connect(function()
            tween(boxBg, 0.18, { BackgroundColor3 = self.Window.Theme.Sidebar })
            if cfg.Flag then self.Window.Flags[cfg.Flag] = input.Text end
            if cfg.Callback then pcall(cfg.Callback, input.Text) end
        end)
    end

    -- Color Picker
    function tabData:CreateColorPicker(cfg)
        cfg = cfg or {}
        local currentColor = cfg.Color or Color3.fromRGB(255, 255, 255)
        local expanded = false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 32)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.BackgroundTransparency = 0.3
        frame.ClipsDescendants = true
        frame.Parent = view
        createCorner(frame, 6)
        createStroke(frame, self.Window.Theme.Border, 1, 0.5)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, -48, 0, 32)
        title.Position = UDim2.new(0, 10, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Color Picker"
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 12
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local preview = Instance.new("TextButton")
        preview.Size = UDim2.fromOffset(22, 16)
        preview.Position = UDim2.new(1, -32, 0, 8)
        preview.BackgroundColor3 = currentColor
        preview.Text = ""
        preview.AutoButtonColor = false
        preview.Parent = frame
        createCorner(preview, 4)
        createStroke(preview, Color3.fromRGB(255, 255, 255), 1, 0.7)

        local hueTrack = Instance.new("Frame")
        hueTrack.Size = UDim2.new(1, -20, 0, 12)
        hueTrack.Position = UDim2.new(0, 10, 0, 38)
        hueTrack.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        hueTrack.Parent = frame
        createCorner(hueTrack, 4)

        local gradient = Instance.new("UIGradient")
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0))
        })
        gradient.Parent = hueTrack

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 0)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = hueTrack

        local dragging = false
        local function update(input)
            local percent = math.clamp((input.Position.X - hueTrack.AbsolutePosition.X) / hueTrack.AbsoluteSize.X, 0, 1)
            currentColor = Color3.fromHSV(1 - percent, 1, 1)
            preview.BackgroundColor3 = currentColor
            if cfg.Flag then self.Window.Flags[cfg.Flag] = currentColor end
            if cfg.Callback then pcall(cfg.Callback, currentColor) end
        end

        trigger.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input)
            end
        end)

        preview.MouseButton1Click:Connect(function()
            expanded = not expanded
            spring(frame, 0.28, { Size = UDim2.new(1, 0, 0, expanded and 58 or 32) })
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = currentColor end
    end

    return tabData
end

-- ─────────────────────────────────────────────
-- Cleanup (Premium close animation)
-- ─────────────────────────────────────────────
function PhantomLib:DisableAllAndDestroy()
    if self.ToggleObjects then
        for _, toggle in ipairs(self.ToggleObjects) do
            if toggle:Get() then
                toggle:Set(false)
            end
        end
    end
    if self.ScreenName and getgenv()._PhantomLib_Instances then
        getgenv()._PhantomLib_Instances[self.ScreenName] = nil
    end
    self:Destroy()
end

function PhantomLib:Destroy()
    if not self.Screen or not self.Main then return end

    local main = self.Main
    local glow = self.Glow
    local stroke = self.MainStroke

    -- Create UIScale for smooth scaling
    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = main

    -- Stage 1: Fade glow & stroke quickly
    if glow then
        tween(glow, 0.22, { ImageTransparency = 1 })
    end
    if stroke then
        tween(stroke, 0.2, { Transparency = 1 })
    end

    -- Stage 2: Scale down + fade + slight drift toward close button
    tween(scale, 0.28, { Scale = 0.88 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    tween(main, 0.28, {
        BackgroundTransparency = 0.35,
        Position = UDim2.new(
            main.Position.X.Scale,
            main.Position.X.Offset + 18,
            main.Position.Y.Scale,
            main.Position.Y.Offset - 12
        )
    }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

    task.wait(0.18)

    -- Stage 3: Final collapse
    tween(scale, 0.22, { Scale = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    tween(main, 0.22, {
        BackgroundTransparency = 1,
        Position = UDim2.new(
            main.Position.X.Scale,
            main.Position.X.Offset + 35,
            main.Position.Y.Scale,
            main.Position.Y.Offset - 28
        )
    }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

    task.wait(0.24)

    if self.Screen then
        self.Screen:Destroy()
    end
end

return PhantomLib
