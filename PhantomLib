    function tabData:CreateDropdown(cfg)
        cfg = cfg or {}
        local name = cfg.Name or "Dropdown"
        local options = cfg.Options or {"Option 1", "Option 2"}
        local current = cfg.CurrentOption or options[1]
        local open = false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 42)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.ClipsDescendants = true
        frame.Parent = view
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 9)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, -50, 0, 42)
        title.Position = UDim2.new(0, 12, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = name .. ": " .. tostring(current)
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 13
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local arrow = Instance.new("TextLabel")
        arrow.Size = UDim2.new(0, 30, 0, 42)
        arrow.Position = UDim2.new(1, -36, 0, 0)
        arrow.BackgroundTransparency = 1
        arrow.Text = "▼"
        arrow.TextColor3 = self.Window.Theme.Muted
        arrow.TextSize = 12
        arrow.Parent = frame

        local list = Instance.new("Frame")
        list.Size = UDim2.new(1, -16, 0, 0)
        list.Position = UDim2.new(0, 8, 0, 44)
        list.BackgroundColor3 = self.Window.Theme.Sidebar
        list.Visible = false
        list.Parent = frame
        Instance.new("UICorner", list).CornerRadius = UDim.new(0, 7)

        local listLayout = Instance.new("UIListLayout")
        listLayout.Parent = list

        local function rebuild()
            for _, c in ipairs(list:GetChildren()) do
                if c:IsA("TextButton") then c:Destroy() end
            end
            for _, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(1, 0, 0, 30)
                optBtn.BackgroundTransparency = 1
                optBtn.Text = "  " .. tostring(opt)
                optBtn.TextColor3 = self.Window.Theme.Text
                optBtn.TextSize = 13
                optBtn.Font = Enum.Font.Gotham
                optBtn.TextXAlignment = Enum.TextXAlignment.Left
                optBtn.Parent = list

                optBtn.MouseButton1Click:Connect(function()
                    current = opt
                    title.Text = name .. ": " .. tostring(current)
                    open = false
                    tween(frame, 0.2, {Size = UDim2.new(1, 0, 0, 42)})
                    list.Visible = false
                    arrow.Text = "▼"
                    if cfg.Flag then self.Window.Flags[cfg.Flag] = current end
                    if cfg.Callback then pcall(cfg.Callback, current) end
                end)
            end
            list.Size = UDim2.new(1, -16, 0, #options * 30)
        end
        rebuild()

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 0, 42)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = frame

        trigger.MouseButton1Click:Connect(function()
            open = not open
            if open then
                list.Visible = true
                tween(frame, 0.22, {Size = UDim2.new(1, 0, 0, 48 + #options * 30)})
                arrow.Text = "▲"
            else
                tween(frame, 0.2, {Size = UDim2.new(1, 0, 0, 42)})
                task.delay(0.2, function() list.Visible = false end)
                arrow.Text = "▼"
            end
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = current end
        register(name, frame)
        return {Set = function(_, v) current = v; title.Text = name .. ": " .. tostring(v) end}
    end

