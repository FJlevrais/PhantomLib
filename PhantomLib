function PhantomLib:CreateKeySystem(cfg, onSuccess)
    cfg = cfg or {}
    local keys = cfg.Key or {}
    if type(keys) == "string" then keys = {keys} end

    local parent = getParent()
    local screen = Instance.new("ScreenGui")
    screen.Name = "PhantomKeySystem"
    screen.ResetOnSpawn = false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.Parent = parent

    local overlay = Instance.new("Frame")
    overlay.Size = UDim2.fromScale(1, 1)
    overlay.BackgroundColor3 = Color3.new(0, 0, 0)
    overlay.BackgroundTransparency = 1
    overlay.Parent = screen

    local card = Instance.new("Frame")
    card.Size = UDim2.fromOffset(0, 0)
    card.Position = UDim2.fromScale(0.5, 0.5)
    card.AnchorPoint = Vector2.new(0.5, 0.5)
    card.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.Parent = overlay
    corner(card, 10)
    local cardStroke = stroke(card, Color3.fromRGB(99, 102, 241), 1, 0.5)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -36, 0, 24)
    title.Position = UDim2.new(0, 18, 0, 16)
    title.BackgroundTransparency = 1
    title.Text = cfg.Title or "Key System"
    title.TextColor3 = Color3.fromRGB(241, 243, 255)
    title.TextSize = 16
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = card

    local desc = Instance.new("TextLabel")
    desc.Size = UDim2.new(1, -36, 0, 32)
    desc.Position = UDim2.new(0, 18, 0, 42)
    desc.BackgroundTransparency = 1
    desc.Text = cfg.Note or cfg.Description or "Enter a valid key to continue"
    desc.TextColor3 = Color3.fromRGB(140, 145, 170)
    desc.TextSize = 12
    desc.Font = Enum.Font.Gotham
    desc.TextWrapped = true
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = card

    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, -36, 0, 34)
    box.Position = UDim2.new(0, 18, 0, 84)
    box.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
    box.Parent = card
    corner(box, 6)
    stroke(box, Color3.fromRGB(55, 58, 85), 1, 0.45)

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, -14, 1, 0)
    input.Position = UDim2.new(0, 8, 0, 0)
    input.BackgroundTransparency = 1
    input.PlaceholderText = "Enter key..."
    input.PlaceholderColor3 = Color3.fromRGB(110, 115, 140)
    input.TextColor3 = Color3.fromRGB(241, 243, 255)
    input.TextSize = 13
    input.Font = Enum.Font.GothamMedium
    input.ClearTextOnFocus = false
    input.Text = ""
    input.Parent = box

    local submit = Instance.new("TextButton")
    submit.Size = UDim2.new(1, -36, 0, 32)
    submit.Position = UDim2.new(0, 18, 0, 130)
    submit.BackgroundColor3 = Color3.fromRGB(99, 102, 241)
    submit.Text = "Unlock"
    submit.TextColor3 = Color3.new(1, 1, 1)
    submit.TextSize = 13
    submit.Font = Enum.Font.GothamBold
    submit.AutoButtonColor = false
    submit.Parent = card
    corner(submit, 6)

    local getKey
    if cfg.URL then
        getKey = Instance.new("TextButton")
        getKey.Size = UDim2.new(1, -36, 0, 24)
        getKey.Position = UDim2.new(0, 18, 0, 170)
        getKey.BackgroundTransparency = 1
        getKey.Text = "Get Key"
        getKey.TextColor3 = Color3.fromRGB(99, 102, 241)
        getKey.TextSize = 12
        getKey.Font = Enum.Font.GothamMedium
        getKey.Parent = card
        getKey.MouseButton1Click:Connect(function()
            pcall(function()
                if setclipboard then setclipboard(cfg.URL) end
            end)
            getKey.Text = "Link copied!"
            task.delay(1.5, function()
                if getKey then getKey.Text = "Get Key" end
            end)
        end)
    end

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -36, 0, 18)
    status.Position = UDim2.new(0, 18, 1, -28)
    status.BackgroundTransparency = 1
    status.Text = ""
    status.TextColor3 = Color3.fromRGB(248, 113, 113)
    status.TextSize = 11
    status.Font = Enum.Font.Gotham
    status.Parent = card

    tween(overlay, 0.3, {BackgroundTransparency = 0.5})
    spring(card, 0.4, {Size = UDim2.fromOffset(320, cfg.URL and 220 or 185)})

    local function checkKey(val)
        val = tostring(val or ""):gsub("%s+", "")
        for _, k in ipairs(keys) do
            if tostring(k) == val then
                return true
            end
        end
        return false
    end

    local saveFolder = cfg.Folder or "PhantomLib"
    local savePath = saveFolder .. "/key.txt"

    if cfg.SaveKey then
        pcall(function()
            if isfile and isfile(savePath) then
                local saved = readfile(savePath)
                if checkKey(saved) then
                    screen:Destroy()
                    onSuccess()
                    return
                end
            end
        end)
    end

    local function tryUnlock()
        local val = input.Text
        if checkKey(val) then
            status.TextColor3 = Color3.fromRGB(52, 211, 153)
            status.Text = "Key accepted"
            if cfg.SaveKey and writefile then
                pcall(writefile, savePath, val)
            end
            tween(overlay, 0.25, {BackgroundTransparency = 1})
            tween(card, 0.24, {
                Size = UDim2.fromOffset(300, 0),
                BackgroundTransparency = 1
            }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            task.delay(0.28, function()
                screen:Destroy()
                onSuccess()
            end)
        else
            status.Text = "Invalid key"
            spring(card, 0.15, {Position = UDim2.new(0.5, 6, 0.5, 0)})
            task.delay(0.07, function()
                spring(card, 0.18, {Position = UDim2.fromScale(0.5, 0.5)})
            end)
        end
    end

    submit.MouseButton1Click:Connect(tryUnlock)
    input.FocusLost:Connect(function(enter)
        if enter then tryUnlock() end
    end)

    submit.MouseEnter:Connect(function()
        tween(submit, 0.15, {BackgroundColor3 = Color3.fromRGB(120, 123, 250)})
    end)
    submit.MouseLeave:Connect(function()
        tween(submit, 0.15, {BackgroundColor3 = Color3.fromRGB(99, 102, 241)})
    end)
end

