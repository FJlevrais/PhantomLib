    btn.Text = tabName
    btn.TextColor3 = self.Theme.Muted
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamMedium
    btn.Parent = self.Sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local view = Instance.new("ScrollingFrame")
    view.Size = UDim2.new(1, 0, 1, 0)
    view.BackgroundTransparency = 1
    view.Visible = false
    view.ScrollBarThickness = 4
    view.ScrollBarImageColor3 = self.Theme.Muted
    view.BorderSizePixel = 0
    view.CanvasSize = UDim2.new(0, 0, 0, 0)
    view.Parent = self.Container

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 7)
    layout.Parent = view

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 10)
    pad.PaddingLeft = UDim.new(0, 12)
    pad.PaddingRight = UDim.new(0, 12)
    pad.PaddingBottom = UDim.new(0, 12)
    pad.Parent = view

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        view.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)

    -- Search Bar
    local searchFrame = Instance.new("Frame")
    searchFrame.Size = UDim2.new(1, 0, 0, 36)
    searchFrame.BackgroundColor3 = self.Theme.Card
    searchFrame.Parent = view
    Instance.new("UICorner", searchFrame).CornerRadius = UDim.new(0, 8)

    local searchStroke = Instance.new("UIStroke")
    searchStroke.Color = self.Theme.Border
    searchStroke.Parent = searchFrame

    local searchBox = Instance.new("TextBox")
    searchBox.Size = UDim2.new(1, -40, 1, 0)
    searchBox.Position = UDim2.new(0, 12, 0, 0)
    searchBox.BackgroundTransparency = 1
    searchBox.PlaceholderText = "Search..."
    searchBox.PlaceholderColor3 = self.Theme.Muted
    searchBox.Text = ""
    searchBox.TextColor3 = self.Theme.Text
    searchBox.TextSize = 13
    searchBox.Font = Enum.Font.Gotham
    searchBox.TextXAlignment = Enum.TextXAlignment.Left
    searchBox.ClearTextOnFocus = false
    searchBox.Parent = searchFrame

    local clearBtn = Instance.new("TextButton")
    clearBtn.Size = UDim2.new(0, 24, 0, 24)
    clearBtn.Position = UDim2.new(1, -30, 0.5, -12)
    clearBtn.BackgroundColor3 = self.Theme.Border
    clearBtn.Text = "×"
    clearBtn.TextColor3 = self.Theme.Text
    clearBtn.TextSize = 14
    clearBtn.Font = Enum.Font.GothamBold
    clearBtn.Visible = false
    clearBtn.Parent = searchFrame
    Instance.new("UICorner", clearBtn).CornerRadius = UDim.new(0, 6)

    local function filterElements(query)
        query = string.lower(query or "")
        clearBtn.Visible = query \~= ""
        for _, data in ipairs(tabData.Elements) do
            data.Frame.Visible = query == "" or string.find(string.lower(data.Name), query, 1, true) \~= nil
        end
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        filterElements(searchBox.Text)
    end)

    clearBtn.MouseButton1Click:Connect(function()
        searchBox.Text = ""
        filterElements("")
    end)

    tabData.Button = btn
    tabData.View = view

    local function selectTab()
        for _, tab in ipairs(self.Tabs) do
            tab.View.Visible = false
            tween(tab.Button, 0.15, {BackgroundTransparency = 1, TextColor3 = self.Theme.Muted})
        end
        view.Visible = true
        tween(btn, 0.15, {BackgroundTransparency = 0, TextColor3 = self.Theme.Text})
        self.ActiveTab = tabData
    end

    btn.MouseButton1Click:Connect(selectTab)
    if #self.Tabs == 0 then selectTab() end
    table.insert(self.Tabs, tabData)

    local function register(name, frame)
        table.insert(tabData.Elements, {Name = name or "Unnamed", Frame = frame})
    end

    -- ========== ELEMENTS ==========

    function tabData:CreateSection(cfg)
        cfg = cfg or {}
        local name = cfg.Name or "Section"

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 26)
        frame.BackgroundTransparency = 1
        frame.Parent = view

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = name
        label.TextColor3 = self.Window.Theme.Accent
        label.TextSize = 13
        label.Font = Enum.Font.GothamBold
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        register(name, frame)
        return label
    end

    function tabData:CreateLabel(cfg)
        cfg = cfg or {}
        local name = cfg.Name or "Label"

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 24)
        frame.BackgroundTransparency = 1
        frame.Parent = view

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = name
        label.TextColor3 = self.Window.Theme.Muted
        label.TextSize = 12
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        register(name, frame)
        return label
    end

    function tabData:CreateButton(cfg)
        cfg = cfg or {}
        local name = cfg.Name or "Button"

        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 36)
        b.BackgroundColor3 = self.Window.Theme.Card
        b.Text = name
        b.TextColor3 = self.Window.Theme.Text
        b.TextSize = 13
        b.Font = Enum.Font.GothamMedium
        b.Parent = view
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

        local stroke = Instance.new("UIStroke", b)
        stroke.Color = self.Window.Theme.Border

        addHoverScale(b, 1.02)

        b.MouseButton1Click:Connect(function()
            if cfg.Callback then pcall(cfg.Callback) end
        end)

        register(name, b)
        return b
    end

    function tabData:CreateToggle(cfg)
        cfg = cfg or {}
        local name = cfg.Name or "Toggle"
        local state = cfg.CurrentValue or false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 38)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.Parent = view
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -52, 1, 0)
        label.Position = UDim2.new(0, 12, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = name
        label.TextColor3 = self.Window.Theme.Text
        label.TextSize = 13
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local track = Instance.new("Frame")
        track.Size = UDim2.fromOffset(38, 18)
        track.Position = UDim2.new(1, -48, 0.5, -9)
        track.BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Border
        track.Parent = frame
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(14, 14)
        knob.Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.Parent = track
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 0)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = frame

        local toggleObj = {}

        local function update(newState)
            state = newState
            tween(track, 0.15, {BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Border})
            tween(knob, 0.15, {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)})
            if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
            if cfg.Callback then pcall(cfg.Callback, state) end
        end

        function toggleObj:Set(val) update(val) end
        function toggleObj:Get() return state end

        trigger.MouseButton1Click:Connect(function()
            update(not state)
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
        table.insert(self.Window.ToggleObjects, toggleObj)

        register(name, frame)
        return toggleObj
    end

    function tabData:CreateSlider(cfg)
        cfg = cfg or {}
        local name = cfg.Name or "Slider"
        local min = cfg.Range and cfg.Range[1] or 0
        local max = cfg.Range and cfg.Range[2] or 100
        local val = math.clamp(cfg.CurrentValue or min, min, max)

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 52)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.Parent = view
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, -20, 0, 20)
        title.Position = UDim2.new(0, 12, 0, 6)
        title.BackgroundTransparency = 1
        title.Text = name
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 13
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local valDisplay = Instance.new("TextLabel")
        valDisplay.Size = UDim2.new(1, -20, 0, 20)
        valDisplay.Position = UDim2.new(0, 12, 0, 6)
        valDisplay.BackgroundTransparency = 1
        valDisplay.Text = tostring(val) .. (cfg.Suffix or "")
        valDisplay.TextColor3 = self.Window.Theme.Accent
        valDisplay.TextSize = 13
        valDisplay.Font = Enum.Font.GothamBold
        valDisplay.TextXAlignment = Enum.TextXAlignment.Right
        valDisplay.Parent = frame

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -24, 0, 6)
        track.Position = UDim2.new(0, 12, 0, 34)
        track.BackgroundColor3 = self.Window.Theme.Sidebar
        track.Parent = frame
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((val - min) / math.max(max - min, 1), 0, 1, 0)
        fill.BackgroundColor3 = self.Window.Theme.Accent
        fill.Parent = track
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 12)
        trigger.Position = UDim2.new(0, 0, 0, -4)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = track

        local dragging = false
        local function update(input)
            local percent = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = math.floor(min + (max - min) * percent + 0.5)
            valDisplay.Text = tostring(val) .. (cfg.Suffix or "")
            tween(fill, 0.05, {Size = UDim2.new(percent, 0, 1, 0)})
            if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
            if cfg.Callback then pcall(cfg.Callback, val) end
        end

        trigger.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input)
            end
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
        register(name, frame)
    end

    function tabData:CreateInput(cfg)
        cfg = cfg or {}
        local name = cfg.Name or "Input"

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 42)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.Parent = view
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.45, 0, 1, 0)
        label.Position = UDim2.new(0, 12, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = name
        label.TextColor3 = self.Window.Theme.Text
        label.TextSize = 13
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local boxBg = Instance.new("Frame")
        boxBg.Size = UDim2.new(0.5, -10, 0, 28)
        boxBg.Position = UDim2.new(0.48, 0, 0.5, -14)
        boxBg.BackgroundColor3 = self.Window.Theme.Sidebar
        boxBg.Parent = frame
        Instance.new("UICorner", boxBg).CornerRadius = UDim.new(0, 6)

        local input = Instance.new("TextBox")
        input.Size = UDim2.new(1, -10, 1, 0)
        input.Position = UDim2.new(0, 5, 0, 0)
        input.BackgroundTransparency = 1
        input.Text = cfg.CurrentValue or ""
        input.PlaceholderText = cfg.PlaceholderText or "Type..."
        input.TextColor3 = self.Window.Theme.Text
        input.PlaceholderColor3 = self.Window.Theme.Muted
        input.TextSize = 12
        input.Font = Enum.Font.Gotham
        input.TextXAlignment = Enum.TextXAlignment.Left
        input.ClearTextOnFocus = false
        input.Parent = boxBg

        input.FocusLost:Connect(function()
            if cfg.Flag then self.Window.Flags[cfg.Flag] = input.Text end
            if cfg.Callback then pcall(cfg.Callback, input.Text) end
        end)

        register(name, frame)
    end

    return tabData
end

function PhantomLib:DisableAllAndDestroy()
    if self.ToggleObjects then
        for _, toggle in ipairs(self.ToggleObjects) do
            if toggle:Get() then
                toggle:Set(false)
            end
        end
    end
    if self.ScreenName and getgenv()._PhantomLib_Instances then
        getgenv()._PhantomLib_Instances[self.ScreenName] = nil
    end
    self:Destroy()
end

function PhantomLib:Destroy()
    if self.Screen then
        if self.Main then
            tween(self.Main, 0.15, {BackgroundTransparency = 1})
        end
        task.wait(0.15)
        self.Screen:Destroy()
    end
end

return PhantomLib
