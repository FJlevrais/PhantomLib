    lbl.Parent = btn

    local view = Instance.new("ScrollingFrame")
    view.Size = UDim2.new(1, 0, 1, 0)
    view.BackgroundTransparency = 1
    view.Visible = false
    view.ScrollBarThickness = 2
    view.ScrollBarImageColor3 = self.Theme.Accent
    view.ScrollBarImageTransparency = 0.4
    view.BorderSizePixel = 0
    view.ClipsDescendants = true
    view.CanvasSize = UDim2.new(0, 0, 0, 0)
    view.Parent = self.Container

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.Parent = view
    padding(view, 12, 12, 14, 12)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        view.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 18)
    end)

    tab.Button = btn
    tab.View = view
    tab.Indicator = ind
    tab.Label = lbl

    local function select()
        for _, t in ipairs(self.Tabs) do
            t.View.Visible = false
            soft(t.Button, 0.2, {BackgroundTransparency = 1})
            soft(t.Indicator, 0.2, {BackgroundTransparency = 1})
            soft(t.Label, 0.2, {TextColor3 = self.Theme.Muted})
        end
        view.Visible = true
        soft(btn, 0.22, {BackgroundTransparency = 0.5})
        soft(ind, 0.22, {BackgroundTransparency = 0})
        soft(lbl, 0.22, {TextColor3 = self.Theme.Text})
        self.ActiveTab = tab
    end

    btn.MouseButton1Click:Connect(select)
    btn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.12, {BackgroundTransparency = 0.75})
            tween(lbl, 0.12, {TextColor3 = self.Theme.Text})
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.12, {BackgroundTransparency = 1})
            tween(lbl, 0.12, {TextColor3 = self.Theme.Muted})
        end
    end)

    if #self.Tabs == 0 then select() end
    table.insert(self.Tabs, tab)

    -- BUTTON
    function tab:CreateButton(cfg)
        cfg = cfg or {}
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 34)
        b.BackgroundColor3 = self.Window.Theme.Button
