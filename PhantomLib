function PhantomLib:CreateTab(name)
    local tab = {Name = name, Window = self}

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = self.Theme.Card
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = self.Sidebar
    corner(btn, 8)

    local ind = Instance.new("Frame")
    ind.Size = UDim2.new(0, 3.5, 0.55, 0)
    ind.Position = UDim2.new(0, 0, 0.5, 0)
    ind.AnchorPoint = Vector2.new(0, 0.5)
    ind.BackgroundColor3 = self.Theme.Accent
    ind.BackgroundTransparency = 1
    ind.BorderSizePixel = 0
    ind.Parent = btn
    corner(ind, 2)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -16, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = self.Theme.Muted
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = btn

    local view = Instance.new("ScrollingFrame")
    view.Size = UDim2.new(1, 0, 1, 0)
    view.BackgroundTransparency = 1
    view.Visible = false
    view.ScrollBarThickness = 3
    view.ScrollBarImageColor3 = self.Theme.Accent
    view.ScrollBarImageTransparency = 0.4
    view.BorderSizePixel = 0
    view.ClipsDescendants = true
    view.CanvasSize = UDim2.new(0, 0, 0, 0)
    view.Parent = self.Container

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.Parent = view
    padding(view, 12, 12, 14, 12)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        view.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)

    tab.Button = btn
    tab.View = view
    tab.Indicator = ind
    tab.Label = lbl

    local function select()
        for _, t in ipairs(self.Tabs) do
            t.View.Visible = false
            tween(t.Button, 0.2, {BackgroundTransparency = 1})
            tween(t.Indicator, 0.2, {BackgroundTransparency = 1})
            tween(t.Label, 0.2, {TextColor3 = self.Theme.Muted})
        end
        view.Visible = true
        tween(btn, 0.22, {BackgroundTransparency = 0.5})
        tween(ind, 0.22, {BackgroundTransparency = 0})
        tween(lbl, 0.22, {TextColor3 = self.Theme.Text})
        self.ActiveTab = tab
    end

    btn.MouseButton1Click:Connect(select)
    btn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.15, {BackgroundTransparency = 0.75})
            tween(lbl, 0.15, {TextColor3 = self.Theme.Text})
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.15, {BackgroundTransparency = 1})
            tween(lbl, 0.15, {TextColor3 = self.Theme.Muted})
        end
    end)

    if #self.Tabs == 0 then select() end
    table.insert(self.Tabs, tab)

    -- BUTTON
    function tab:CreateButton(cfg)
        cfg = cfg or {}
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 36)
        b.BackgroundColor3 = self.Window.Theme.Button
        b.BackgroundTransparency = 0.1
        b.Text = cfg.Name or "Button"
        b.TextColor3 = self.Window.Theme.Text
        b.TextSize = 13
        b.Font = Enum.Font.GothamBold
        b.AutoButtonColor = false
        b.Parent = view
        corner(b, 9)
        local st = stroke(b, self.Window.Theme.Accent, 1, 0.55)

        b.BackgroundTransparency = 1
        b.TextTransparency = 1
        tween(b, 0.32, {BackgroundTransparency = 0.1, TextTransparency = 0})

        b.MouseEnter:Connect(function()
            tween(b, 0.18, {BackgroundTransparency = 0, BackgroundColor3 = self.Window.Theme.Accent})
            tween(st, 0.18, {Transparency = 0.15, Color = self.Window.Theme.Accent2})
            spring(b, 0.22, {Size = UDim2.new(1, 0, 0, 38)})
        end)
        b.MouseLeave:Connect(function()
            tween(b, 0.2, {
                BackgroundTransparency = 0.1,
                BackgroundColor3 = self.Window.Theme.Button,
                Size = UDim2.new(1, 0, 0, 36)
            })
            tween(st, 0.2, {Transparency = 0.55, Color = self.Window.Theme.Accent})
        end)
        b.MouseButton1Down:Connect(function()
            tween(b, 0.08, {Size = UDim2.new(1, 0, 0, 33)})
        end)
        b.MouseButton1Up:Connect(function()
            spring(b, 0.2, {Size = UDim2.new(1, 0, 0, 38)})
        end)
        b.MouseButton1Click:Connect(function()
            if cfg.Callback then pcall(cfg.Callback) end
        end)
    end

    -- TOGGLE
    function tab:CreateToggle(cfg)
        cfg = cfg or {}
        local state = cfg.CurrentValue or false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 36)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.BackgroundTransparency = 0.25
        frame.Parent = view
        corner(frame, 9)
        stroke(frame, self.Window.Theme.Border, 1, 0.45)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -56, 1, 0)
        label.Position = UDim2.new(0, 14, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = cfg.Name or "Toggle"
        label.TextColor3 = self.Window.Theme.Text
        label.TextSize = 13
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local track = Instance.new("Frame")
        track.Size = UDim2.fromOffset(40, 22)
        track.Position = UDim2.new(1, -50, 0.5, -11)
        track.BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Sidebar
        track.Parent = frame
        corner(track, 11)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(16, 16)
        knob.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.Parent = track
        corner(knob, 8)

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 0)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = frame

        local obj = {}
        local function update(v)
            state = v
            tween(track, 0.24, {BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Sidebar})
            spring(knob, 0.3, {
                Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
            })
            if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
            if cfg.Callback then pcall(cfg.Callback, state) end
        end

        function obj:Set(v) update(v) end
        function obj:Get() return state end

        trigger.MouseButton1Click:Connect(function()
            update(not state)
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
        table.insert(self.Window.ToggleObjects, obj)
        return obj
    end

    -- SLIDER
    function tab:CreateSlider(cfg)
        cfg = cfg or {}
        local min = cfg.Range and cfg.Range[1] or 0
        local max = cfg.Range and cfg.Range[2] or 100
        local range = math.max(max - min, 1e-9)
        local increment = cfg.Increment or cfg.Step or (range <= 1 and 0.01 or range <= 10 and 0.1 or 1)

        local function snap(v)
            v = math.clamp(v, min, max)
            v = math.floor(v / increment + 0.5) * increment
            local decimals = math.max(0, math.ceil(-math.log10(increment)))
            local mult = 10 ^ decimals
            return math.floor(v * mult + 0.5) / mult
        end

        local val = snap(cfg.CurrentValue or min)

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 52)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.BackgroundTransparency = 0.25
        frame.Parent = view
        corner(frame, 9)
        stroke(frame, self.Window.Theme.Border, 1, 0.45)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.65, 0, 0, 18)
        title.Position = UDim2.new(0, 14, 0, 8)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Slider"
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 13
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0.35, -14, 0, 18)
        valLbl.Position = UDim2.new(0.65, 0, 0, 8)
        valLbl.BackgroundTransparency = 1
        valLbl.TextColor3 = self.Window.Theme.Accent
        valLbl.TextSize = 13
        valLbl.Font = Enum.Font.GothamBold
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.Parent = frame

        local function formatValue(v)
            if v == math.floor(v) then return tostring(math.floor(v)) end
            return string.format("%.4f", v):gsub("0+$", ""):gsub("%.$", "")
        end
        valLbl.Text = formatValue(val) .. (cfg.Suffix or "")

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -28, 0, 6)
        track.Position = UDim2.new(0, 14, 0, 34)
        track.BackgroundColor3 = self.Window.Theme.Sidebar
        track.Parent = frame
        corner(track, 3)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((val - min) / range, 0, 1, 0)
        fill.BackgroundColor3 = self.Window.Theme.Accent
        fill.Parent = track
        corner(fill, 3)

        local handle = Instance.new("Frame")
        handle.Size = UDim2.fromOffset(14, 14)
        handle.Position = UDim2.new((val - min) / range, -7, 0.5, -7)
        handle.BackgroundColor3 = Color3.new(1, 1, 1)
        handle.Parent = track
        corner(handle, 7)
        stroke(handle, self.Window.Theme.Accent, 1.6, 0.15)

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 16)
        trigger.Position = UDim2.new(0, 0, 0, -5)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = track

        local drag = false
        local function update(inp)
            local pct = math.clamp((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = snap(min + range * pct)
            valLbl.Text = formatValue(val) .. (cfg.Suffix or "")
            tween(fill, 0.07, {Size = UDim2.new((val - min) / range, 0, 1, 0)})
