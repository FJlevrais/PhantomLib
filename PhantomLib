function PhantomLib:CreateWindow(options)
    options = options or {}
    local self = setmetatable({}, PhantomLib)
    
    -- Rayfield-style configuration mapping
    self.WindowName = options.Name or "Phantom Hub"
    self.LoadingTitle = options.LoadingTitle or self.WindowName
    self.LoadingSubtitle = options.LoadingSubtitle or "Loading Interface..."
    self.Theme = PhantomLib.Themes.Default -- Extendable in the future
    self.Tabs = {}
    self.ActiveTab = nil
    self.Flags = PhantomLib.Flags
    self.IsMinimized = false
    
    local configSetting = options.ConfigurationSaving or {}
    self.ConfigName = (configSetting.FolderName or "Phantom") .. "_" .. (configSetting.FileName or "Config") .. ".json"
    self.AutoSaveEnabled = configSetting.Enabled or false

    local screen = Instance.new("ScreenGui")
    screen.Name = "PhantomLib_" .. HttpService:GenerateGUID(false)
    screen.ResetOnSpawn = false
    screen.Parent = getGuiParent()

    -- Mobile Support
    local isTouch = UserInputService.TouchEnabled
    local mobileToggle = Instance.new("TextButton", screen)
    mobileToggle.Size = UDim2.fromOffset(45, 45)
    mobileToggle.Position = UDim2.new(0.5, -22, 0, 15)
    mobileToggle.BackgroundColor3 = self.Theme.Card
    mobileToggle.Text = "P"
    mobileToggle.TextColor3 = self.Theme.Accent
    mobileToggle.TextSize = 20
    mobileToggle.Font = Enum.Font.GothamBold
    mobileToggle.Visible = isTouch
    Instance.new("UICorner", mobileToggle).CornerRadius = UDim.new(1, 0)
    
    local mobStroke = Instance.new("UIStroke", mobileToggle)
    mobStroke.Color = self.Theme.Border
    mobStroke.Thickness = 2

    -- Notifications
    local notifContainer = Instance.new("Frame", screen)
    notifContainer.Size = UDim2.new(0, 260, 1, -40)
    notifContainer.Position = UDim2.new(1, -20, 1, -20)
    notifContainer.AnchorPoint = Vector2.new(1, 1)
    notifContainer.BackgroundTransparency = 1
    
    local notifLayout = Instance.new("UIListLayout", notifContainer)
    notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    notifLayout.Padding = UDim.new(0, 8)

    -- Main Frame
    local main = Instance.new("Frame", screen)
    main.Size = UDim2.fromOffset(650, 430)
    main.Position = UDim2.new(0.5, -325, 0.5, -215)
    main.BackgroundColor3 = self.Theme.Background
    main.BorderSizePixel = 0
    main.ClipsDescendants = true
    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 10)
    
    local stroke = Instance.new("UIStroke", main)
    stroke.Color = self.Theme.Border
    stroke.Thickness = 1

    -- Header
    local header = Instance.new("Frame", main)
    header.Size = UDim2.new(1, 0, 0, 42)
    header.BackgroundColor3 = self.Theme.Sidebar

    local title = Instance.new("TextLabel", header)
    title.Size = UDim2.new(0, 220, 1, 0)
    title.Position = UDim2.new(0, 15, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = self.WindowName
    title.TextColor3 = self.Theme.Text
    title.TextSize = 14
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left

    -- FPS/Ping Stats
    local statsHud = Instance.new("TextLabel", header)
    statsHud.Size = UDim2.new(0, 160, 1, 0)
    statsHud.Position = UDim2.new(1, -240, 0, 0)
    statsHud.BackgroundTransparency = 1
    statsHud.Text = "FPS: -- | Ping: -- ms"
    statsHud.TextColor3 = self.Theme.Muted
    statsHud.TextSize = 11
    statsHud.Font = Enum.Font.GothamMedium
    statsHud.TextXAlignment = Enum.TextXAlignment.Right

    local frameCount = 0
    local lastCheck = tick()
    self.StatsConnection = RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastCheck >= 1 then
            local fps = math.floor(frameCount / (now - lastCheck))
            frameCount = 0
            lastCheck = now
            local ping = 0
            pcall(function()
                ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            statsHud.Text = string.format("FPS: %d | Ping: %d ms", fps, ping)
        end
    end)

    -- Window Controls
    local controls = Instance.new("Frame", header)
    controls.Size = UDim2.new(0, 60, 1, 0)
    controls.Position = UDim2.new(1, -70, 0, 0)
    controls.BackgroundTransparency = 1

    local minBtn = Instance.new("TextButton", controls)
    minBtn.Size = UDim2.fromOffset(24, 24)
    minBtn.Position = UDim2.new(0, 0, 0.5, -12)
    minBtn.BackgroundColor3 = self.Theme.Card
    minBtn.Text = "-"
    minBtn.TextColor3 = self.Theme.Text
    minBtn.TextSize = 14
    minBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", minBtn).CornerRadius = UDim.new(0, 6)

    local closeBtn = Instance.new("TextButton", controls)
    closeBtn.Size = UDim2.fromOffset(24, 24)
    closeBtn.Position = UDim2.new(0, 32, 0.5, -12)
    closeBtn.BackgroundColor3 = self.Theme.Card
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = self.Theme.Red
    closeBtn.TextSize = 11
    closeBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)

    -- Dragging Logic
    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)

    -- Hotkey
    local toggleKey = options.Keybind or Enum.KeyCode.RightControl
    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == toggleKey then
            main.Visible = not main.Visible
        end
    end)

    -- Sidebar Layout
    local sidebar = Instance.new("Frame", main)
    sidebar.Size = UDim2.new(0, 170, 1, -42)
    sidebar.Position = UDim2.new(0, 0, 0, 42)
    sidebar.BackgroundColor3 = self.Theme.Sidebar

    local searchBoxBg = Instance.new("Frame", sidebar)
    searchBoxBg.Size = UDim2.new(1, -16, 0, 30)
    searchBoxBg.Position = UDim2.new(0, 8, 0, 8)
    searchBoxBg.BackgroundColor3 = self.Theme.Card
    Instance.new("UICorner", searchBoxBg).CornerRadius = UDim.new(0, 6)
    
    local searchInput = Instance.new("TextBox", searchBoxBg)
    searchInput.Size = UDim2.new(1, -20, 1, 0)
    searchInput.Position = UDim2.new(0, 10, 0, 0)
    searchInput.BackgroundTransparency = 1
    searchInput.PlaceholderText = "Search..."
    searchInput.Text = ""
    searchInput.TextColor3 = self.Theme.Text
    searchInput.PlaceholderColor3 = self.Theme.Muted
    searchInput.TextSize = 11
    searchInput.Font = Enum.Font.Gotham
    searchInput.TextXAlignment = Enum.TextXAlignment.Left

    local tabListContainer = Instance.new("ScrollingFrame", sidebar)
    tabListContainer.Size = UDim2.new(1, 0, 1, -46)
    tabListContainer.Position = UDim2.new(0, 0, 0, 46)
    tabListContainer.BackgroundTransparency = 1
    tabListContainer.ScrollBarThickness = 0

    local sidebarLayout = Instance.new("UIListLayout", tabListContainer)
    sidebarLayout.Padding = UDim.new(0, 4)
    local sidebarPad = Instance.new("UIPadding", tabListContainer)
    sidebarPad.PaddingLeft = UDim.new(0, 8); sidebarPad.PaddingRight = UDim.new(0, 8)

    searchInput:GetPropertyChangedSignal("Text"):Connect(function()
        local filter = searchInput.Text:lower()
        if self.ActiveTab then
            for _, item in ipairs(self.ActiveTab.View:GetChildren()) do
                if item:IsA("Frame") then
                    local nameLabel = item:FindFirstChildOfClass("TextLabel")
                    if nameLabel then
                        item.Visible = (filter == "" or nameLabel.Text:lower():find(filter) ~= nil)
                    end
                end
            end
        end
    end)

    local container = Instance.new("Frame", main)
    container.Size = UDim2.new(1, -170, 1, -42)
    container.Position = UDim2.new(0, 170, 0, 42)
    container.BackgroundTransparency = 1

    self.Screen = screen
    self.Main = main
    self.NotifContainer = notifContainer
    self.Container = container
    self.Sidebar = tabListContainer

    minBtn.MouseButton1Click:Connect(function()
        self.IsMinimized = not self.IsMinimized
        springTween(main, 0.4, {Size = self.IsMinimized and UDim2.fromOffset(650, 42) or UDim2.fromOffset(650, 430)})
    end)
    
    mobileToggle.MouseButton1Click:Connect(function() main.Visible = not main.Visible end)
    closeBtn.MouseButton1Click:Connect(function() self:Destroy() end)

    -------------------------------------------------------------------------------
    -- PREMIUM RAYFIELD-STYLE LOADING SEQUENCE
    -------------------------------------------------------------------------------
    main.Visible = false

    local introFrame = Instance.new("Frame", screen)
    introFrame.Size = UDim2.fromOffset(320, 130)
    introFrame.Position = UDim2.new(0.5, -160, 0.5, -65)
    introFrame.BackgroundColor3 = self.Theme.Card
    introFrame.BackgroundTransparency = 1
    introFrame.ClipsDescendants = true
    Instance.new("UICorner", introFrame).CornerRadius = UDim.new(0, 10)

    local introStroke = Instance.new("UIStroke", introFrame)
    introStroke.Color = self.Theme.Border
    introStroke.Thickness = 1
    introStroke.Transparency = 1

    local wmTitle = Instance.new("TextLabel", introFrame)
    wmTitle.Size = UDim2.new(1, 0, 0, 30)
    wmTitle.Position = UDim2.new(0, 0, 0, 25)
    wmTitle.BackgroundTransparency = 1
    wmTitle.Text = self.LoadingTitle
    wmTitle.TextColor3 = self.Theme.Text
    wmTitle.TextSize = 20
    wmTitle.Font = Enum.Font.GothamBold
    wmTitle.TextTransparency = 1

    local wmSub = Instance.new("TextLabel", introFrame)
    wmSub.Size = UDim2.new(1, 0, 0, 20)
    wmSub.Position = UDim2.new(0, 0, 0, 60)
    wmSub.BackgroundTransparency = 1
    wmSub.Text = self.LoadingSubtitle
    wmSub.TextColor3 = self.Theme.Accent
    wmSub.TextSize = 12
    wmSub.Font = Enum.Font.GothamMedium
    wmSub.TextTransparency = 1

    local pBarBg = Instance.new("Frame", introFrame)
    pBarBg.Size = UDim2.new(0.85, 0, 0, 4)
    pBarBg.Position = UDim2.new(0.075, 0, 1, -25)
    pBarBg.BackgroundColor3 = self.Theme.Background
    pBarBg.BackgroundTransparency = 1
    Instance.new("UICorner", pBarBg).CornerRadius = UDim.new(1, 0)

    local pBarFill = Instance.new("Frame", pBarBg)
    pBarFill.Size = UDim2.new(0, 0, 1, 0)
    pBarFill.BackgroundColor3 = self.Theme.Accent
    Instance.new("UICorner", pBarFill).CornerRadius = UDim.new(1, 0)

    task.spawn(function()
        smoothTween(introFrame, 0.3, {BackgroundTransparency = 0})
        smoothTween(introStroke, 0.3, {Transparency = 0})
        smoothTween(wmTitle, 0.3, {TextTransparency = 0})
        smoothTween(wmSub, 0.3, {TextTransparency = 0})
        smoothTween(pBarBg, 0.3, {BackgroundTransparency = 0})
        
        task.wait(0.2)
        -- Simulating a segmented Rayfield-style loading bar
        smoothTween(pBarFill, 0.4, {Size = UDim2.new(0.4, 0, 1, 0)})
        task.wait(0.5)
        smoothTween(pBarFill, 0.6, {Size = UDim2.new(1, 0, 1, 0)})
        task.wait(0.7)

        smoothTween(introFrame, 0.4, {BackgroundTransparency = 1})
        smoothTween(introStroke, 0.4, {Transparency = 1})
        smoothTween(wmTitle, 0.4, {TextTransparency = 1})
        smoothTween(wmSub, 0.4, {TextTransparency = 1})
        smoothTween(pBarBg, 0.4, {BackgroundTransparency = 1})
        smoothTween(pBarFill, 0.4, {BackgroundTransparency = 1})
        
        task.wait(0.4)
        introFrame:Destroy()
        main.Visible = true
        main.Position = UDim2.new(0.5, -325, 0.5, -190) -- Slight drop-in effect
        springTween(main, 0.4, {Position = UDim2.new(0.5, -325, 0.5, -215)})
    end)

    if self.AutoSaveEnabled then self:LoadConfig() end

    return self
end

