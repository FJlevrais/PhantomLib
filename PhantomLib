        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 0, baseH)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.ZIndex = 2
        trigger.Parent = frame

        local content = Instance.new("Frame")
        content.Size = UDim2.new(1, -8, 0, 0)
        content.Position = UDim2.new(0, 4, 0, baseH + 2)
        content.BackgroundTransparency = 1
        content.ClipsDescendants = true
        content.Visible = false
        content.ZIndex = 5
        content.Parent = frame

        local searchBox = Instance.new("Frame")
        searchBox.Size = UDim2.new(1, 0, 0, 24)
        searchBox.BackgroundColor3 = self.Window.Theme.Background
        searchBox.Parent = content
        corner(searchBox, 6)

        local searchInput = Instance.new("TextBox")
        searchInput.Size = UDim2.new(1, -16, 1, 0)
        searchInput.Position = UDim2.new(0, 8, 0, 0)
        searchInput.BackgroundTransparency = 1
        searchInput.PlaceholderText = "Search..."
        searchInput.PlaceholderColor3 = self.Window.Theme.Muted
        searchInput.TextColor3 = self.Window.Theme.Text
        searchInput.TextSize = 12
        searchInput.Font = Enum.Font.Gotham
        searchInput.ClearTextOnFocus = false
        searchInput.Text = ""
        searchInput.Parent = searchBox

        local list = Instance.new("ScrollingFrame")
        list.Size = UDim2.new(1, 0, 0, 0)
        list.Position = UDim2.new(0, 0, 0, 28)
        list.BackgroundColor3 = self.Window.Theme.Background
        list.BorderSizePixel = 0
        list.ScrollBarThickness = 3
        list.ScrollBarImageColor3 = self.Window.Theme.Accent
        list.CanvasSize = UDim2.new(0, 0, 0, 0)
        list.ClipsDescendants = true
        list.ZIndex = 6
        list.Parent = content
        corner(list, 6)

        local listLayout = Instance.new("UIListLayout")
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Padding = UDim.new(0, 2)
        listLayout.Parent = list
        padding(list, 3, 3, 3, 3)

        listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            list.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 6)
        end)

        local optionButtons = {}
        local filteredOptions = {}

        local function getSelectedList()
            local t = {}
            for _, opt in ipairs(options) do
                if selected[opt] then table.insert(t, opt) end
            end
            return t
        end

        local function updateTitle()
            if isMulti then
                local sel = getSelectedList()
                if #sel == 0 then
                    title.Text = cfg.Name or "Multi Select"
                    title.TextColor3 = self.Window.Theme.Muted
                elseif #sel == 1 then
                    title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. sel[1]
                    title.TextColor3 = self.Window.Theme.Text
                else
                    title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. #sel .. " selected"
                    title.TextColor3 = self.Window.Theme.Text
                end
            else
                valueLbl.Text = tostring(singleValue)
                title.TextColor3 = singleValue ~= "" and self.Window.Theme.Text or self.Window.Theme.Muted
            end
        end

        local function updateDropdownHeight(count)
            local visibleCount = math.min(count or #filteredOptions, maxVisible)
            local searchH = 28
            local listH = math.min(visibleCount * (itemHeight + 2) + 6, maxOpenHeight - searchH)
            content.Size = UDim2.new(1, -8, 0, searchH + listH)
            list.Size = UDim2.new(1, 0, 0, listH)
        end

        local function buildOptions(filterText)
            filterText = string.lower(filterText or "")
            for _, btn in pairs(optionButtons) do btn:Destroy() end
            optionButtons = {}
            filteredOptions = {}

            if filterText == "" then
                for _, opt in ipairs(options) do table.insert(filteredOptions, opt) end
            else
                for _, opt in ipairs(options) do
                    if string.find(string.lower(tostring(opt)), filterText, 1, true) then
                        table.insert(filteredOptions, opt)
                    end
                end
            end

            for i, opt in ipairs(filteredOptions) do
                local isSel = isMulti and selected[opt] or (opt == singleValue)
                local b = Instance.new("TextButton")
                b.Size = UDim2.new(1, 0, 0, itemHeight)
                b.BackgroundColor3 = isSel and self.Window.Theme.Accent or self.Window.Theme.Elevated
                b.BackgroundTransparency = isSel and 0.15 or 0
                b.Text = ""
                b.AutoButtonColor = false
                b.LayoutOrder = i
                b.ZIndex = 7
                b.Parent = list
                corner(b, 5)

                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, -26, 1, 0)
                lbl.Position = UDim2.new(0, 8, 0, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = tostring(opt)
                lbl.TextColor3 = self.Window.Theme.Text
                lbl.TextSize = 12
                lbl.Font = Enum.Font.Gotham
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.ZIndex = 8
                lbl.Parent = b

                local check = Instance.new("TextLabel")
                check.Size = UDim2.fromOffset(16, 16)
                check.Position = UDim2.new(1, -20, 0.5, -8)
                check.BackgroundTransparency = 1
                check.Text = isSel and "✓" or ""
                check.TextColor3 = self.Window.Theme.Accent
                check.TextSize = 12
                check.Font = Enum.Font.GothamBold
                check.ZIndex = 8
                check.Parent = b

                b.MouseEnter:Connect(function()
                    if not isSel then tween(b, 0.1, {BackgroundColor3 = Color3.fromRGB(45, 45, 58)}) end
                end)
                b.MouseLeave:Connect(function()
                    if not isSel then tween(b, 0.1, {BackgroundColor3 = self.Window.Theme.Elevated}) end
                end)

                b.MouseButton1Click:Connect(function()
                    if isMulti then
                        selected[opt] = not selected[opt]
                        local now = selected[opt]
                        tween(b, 0.12, {
                            BackgroundColor3 = now and self.Window.Theme.Accent or self.Window.Theme.Elevated,
                            BackgroundTransparency = now and 0.15 or 0
                        })
                        check.Text = now and "✓" or ""
                        updateTitle()
                        if cfg.Flag then self.Window.Flags[cfg.Flag] = getSelectedList() end
                        if cfg.Callback then pcall(cfg.Callback, getSelectedList()) end
                    else
                        singleValue = opt
                        valueLbl.Text = tostring(singleValue)
                        title.TextColor3 = self.Window.Theme.Text
                        if cfg.Flag then self.Window.Flags[cfg.Flag] = singleValue end
                        if cfg.Callback then pcall(cfg.Callback, singleValue) end
                        setOpen(false)
                    end
                end)
                optionButtons[opt] = b
            end
            updateDropdownHeight(#filteredOptions)
        end

        searchInput:GetPropertyChangedSignal("Text"):Connect(function()
            buildOptions(searchInput.Text)
        end)

        local function setOpen(state)
            isOpen = state
            if isOpen then
                buildOptions("")
                content.Visible = true
                content.Size = UDim2.new(1, -8, 0, 0)
                local targetH = math.min(maxOpenHeight, 28 + (math.min(#filteredOptions, maxVisible) * (itemHeight + 2) + 6))
                spring(content, 0.22, {Size = UDim2.new(1, -8, 0, targetH)})
                tween(arrow, 0.14, {Rotation = 180})
                spring(frame, 0.22, {Size = UDim2.new(1, 0, 0, baseH + 4 + targetH)})
                task.wait(0.04)
                searchInput:CaptureFocus()
            else
                spring(frame, 0.18, {Size = UDim2.new(1, 0, 0, baseH)})
                tween(arrow, 0.14, {Rotation = 0})
                tween(content, 0.14, {Size = UDim2.new(1, -8, 0, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
                task.delay(0.16, function()
                    if not isOpen then
                        content.Visible = false
                        content.Size = UDim2.new(1, -8, 0, 0)
                    end
                end)
            end
        end

        trigger.MouseButton1Click:Connect(function()
            setOpen(not isOpen)
        end)

        searchInput.FocusLost:Connect(function()
            task.delay(0.1, function()
                if isOpen and not searchInput:IsFocused() then
                    setOpen(false)
                end
            end)
        end)

        local obj = {}
        function obj:SetOptions(newOptions)
            options = newOptions or {}
            if isMulti then
                for k in pairs(selected) do
                    if not table.find(options, k) then selected[k] = nil end
                end
            else
                if not table.find(options, singleValue) then
                    singleValue = options[1] or ""
                end
            end
            updateTitle()
            if isOpen then buildOptions(searchInput.Text) end
        end
        function obj:Get()
            return isMulti and getSelectedList() or singleValue
        end
        function obj:Set(value)
            if isMulti then
                selected = {}
                if type(value) == "table" then
                    for _, v in ipairs(value) do selected[v] = true end
                end
            else
                if table.find(options, value) or value == "" then
                    singleValue = value
                end
            end
            updateTitle()
            if isOpen then buildOptions(searchInput.Text) end
            if cfg.Flag then self.Window.Flags[cfg.Flag] = obj:Get() end
            if cfg.Callback then pcall(cfg.Callback, obj:Get()) end
        end
        function obj:Clear()
            if isMulti then
                selected = {}
            else
                singleValue = ""
            end
            updateTitle()
            if isOpen then buildOptions(searchInput.Text) end
            if cfg.Flag then self.Window.Flags[cfg.Flag] = obj:Get() end
            if cfg.Callback then pcall(cfg.Callback, obj:Get()) end
        end

        updateTitle()
        if cfg.Flag then self.Window.Flags[cfg.Flag] = obj:Get() end
        return obj
    end

    function tab:CreateMultiDropdown(cfg)
        return createDropdownBase(cfg, true)
    end

    function tab:CreateSelect(cfg)
        return createDropdownBase(cfg, false)
    end

    function tab:CreateSearchableList(cfg)
        cfg = cfg or {}
        cfg.Name = cfg.Name or "List"
        return createDropdownBase(cfg, true)
    end

    return tab
end

function PhantomLib:DisableAllAndDestroy()
    if self.ToggleObjects then
        for _, t in ipairs(self.ToggleObjects) do
            if t:Get() then t:Set(false) end
        end
    end
    if self.ScreenName and getgenv()._PhantomLib_Instances then
        getgenv()._PhantomLib_Instances[self.ScreenName] = nil
    end
    self:Destroy()
end

function PhantomLib:Destroy()
    if not self.Screen or not self.Main then return end
    local main = self.Main
    local stroke = self.MainStroke

    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = main

    if stroke then tween(stroke, 0.14, {Transparency = 1}) end

    tween(scale, 0.2, {Scale = 0.94}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    tween(main, 0.2, {
        BackgroundTransparency = 0.4,
        Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset + 12, main.Position.Y.Scale, main.Position.Y.Offset - 8)
    }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

    task.wait(0.14)
    tween(scale, 0.16, {Scale = 0}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    tween(main, 0.16, {
        BackgroundTransparency = 1,
        Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset + 22, main.Position.Y.Scale, main.Position.Y.Offset - 16)
    }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

    task.wait(0.18)
    if self.Screen then self.Screen:Destroy() end
end

return PhantomLib
