local function tween(obj, time, props)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function createGradient(parent, c1, c2, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(1, c2)
    })
    g.Rotation = rot or 90
    g.Parent = parent
    return g
end

local function addHoverScale(btn, amount)
    amount = amount or 1.03
    local orig = btn.Size
    btn.MouseEnter:Connect(function()
        tween(btn, 0.15, {Size = UDim2.new(orig.X.Scale, orig.X.Offset * amount, orig.Y.Scale, orig.Y.Offset * amount)})
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.15, {Size = orig})
    end)
end

local function getGuiParent()
    local ok, res = pcall(function() return CoreGui end)
    return (ok and res) and res or LocalPlayer:WaitForChild("PlayerGui")
end

function PhantomLib:CreateWindow(options)
    options = options or {}
    local windowName = options.Name or "Phantom Window"
    local guiParent = getGuiParent()
    local screenName = "PhantomLib_" .. windowName:gsub("%s+", "_")

    if getgenv()._PhantomLib_Instances[screenName] then
        pcall(function()
            getgenv()._PhantomLib_Instances[screenName]:DisableAllAndDestroy()
        end)
    else
        local existing = guiParent:FindFirstChild(screenName)
        if existing then existing:Destroy() end
    end

    local self = setmetatable({}, PhantomLib)
    self.Theme = PhantomLib.Themes[options.Theme] or PhantomLib.Themes.Default
    self.Tabs = {}
    self.ActiveTab = nil
    self.Flags = {}
    self.ToggleObjects = {}
    self.Minimized = false

    getgenv()._PhantomLib_Instances[screenName] = self

    local screen = Instance.new("ScreenGui")
    screen.Name = screenName
    screen.ResetOnSpawn = false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.Parent = guiParent

    local notifContainer = Instance.new("Frame")
    notifContainer.Size = UDim2.new(0, 280, 1, -20)
    notifContainer.Position = UDim2.new(1, -15, 1, -15)
    notifContainer.AnchorPoint = Vector2.new(1, 1)
    notifContainer.BackgroundTransparency = 1
    notifContainer.Parent = screen

    local notifLayout = Instance.new("UIListLayout")
    notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    notifLayout.Padding = UDim.new(0, 10)
    notifLayout.Parent = notifContainer

    local targetSize = options.Size or UDim2.fromOffset(560, 460)

    local main = Instance.new("Frame")
    main.Size = targetSize
    main.Position = UDim2.new(0.5, -targetSize.X.Offset/2, 0.5, -targetSize.Y.Offset/2)
    main.BackgroundColor3 = self.Theme.Background
    main.BorderSizePixel = 0
    main.ClipsDescendants = true
    main.Parent = screen

    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)
    local mainStroke = Instance.new("UIStroke", main)
    mainStroke.Color = self.Theme.Border
    mainStroke.Thickness = 1.2
    mainStroke.Transparency = 0.3

    createGradient(main, self.Theme.Background, Color3.fromRGB(
        math.clamp(self.Theme.Background.R*255 - 8, 0, 255)/255,
        math.clamp(self.Theme.Background.G*255 - 8, 0, 255)/255,
        math.clamp(self.Theme.Background.B*255 - 8, 0, 255)/255
