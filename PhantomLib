-------------------------------------------------------------------------------
-- CONFIG API (SAVE / LOAD / DELETE)
-------------------------------------------------------------------------------
function PhantomLib:SaveConfig()
    if not writefile then return end
    local preparedFlags = {}
    for flag, val in pairs(self.Flags) do
        preparedFlags[flag] = serializeValue(val)
    end
    
    local success, err = pcall(function()
        writefile(self.ConfigName, HttpService:JSONEncode(preparedFlags))
    end)
    
    if success then
        self:Notify({Title = "Config Saved", Content = "Saved settings to file.", Duration = 2})
    end
end

function PhantomLib:LoadConfig()
    if not readfile or not isfile or not isfile(self.ConfigName) then return end
    
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(self.ConfigName))
    end)

    if success and type(result) == "table" then
        for flag, val in pairs(result) do
            self.Flags[flag] = deserializeValue(val)
        end
        self:Notify({Title = "Config Loaded", Content = "Restored saved configuration.", Duration = 2})
    end
end

function PhantomLib:DeleteConfig()
    if isfile and delfile and isfile(self.ConfigName) then
        delfile(self.ConfigName)
        self:Notify({Title = "Config Reset", Content = "Deleted saved settings profile.", Duration = 2})
    end
end

