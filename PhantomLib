        local vp = Workspace.CurrentCamera.ViewportSize
        if vp.X < 600 or vp.Y < 500 then
            uiScale.Scale = math.clamp(vp.X / 650, 0.65, 0.85)
        else
            uiScale.Scale = 1
        end
    end
    updateScale()
