        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 13
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0.4, -12, 0, 16)
        valLbl.Position = UDim2.new(0.6, 0, 0, 8)
        valLbl.BackgroundTransparency = 1
        valLbl.TextColor3 = self.Window.Theme.Accent
        valLbl.TextSize = 13
        valLbl.Font = Enum.Font.GothamBold
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.Parent = frame

        local function formatValue(v)
            if v == math.floor(v) then return tostring(math.floor(v)) end
            return string.format("%.4f", v):gsub("0+$", ""):gsub("%.$", "")
        end
        valLbl.Text = formatValue(val) .. (cfg.Suffix or "")

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -24, 0, 4)
        track.Position = UDim2.new(0, 12, 0, 32)
        track.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
        track.Parent = frame
        corner(track, 2)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((val - min) / range, 0, 1, 0)
        fill.BackgroundColor3 = self.Window.Theme.Accent
        fill.Parent = track
        corner(fill, 2)

        local handle = Instance.new("Frame")
        handle.Size = UDim2.fromOffset(12, 12)
        handle.Position = UDim2.new((val - min) / range, -6, 0.5, -6)
        handle.BackgroundColor3 = Color3.new(1, 1, 1)
        handle.Parent = track
        corner(handle, 6)
        stroke(handle, self.Window.Theme.Accent, 1.2)

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 16)
        trigger.Position = UDim2.new(0, 0, 0, -6)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = track

        local drag = false
        local function update(inp)
            local pct = math.clamp((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = snap(min + range * pct)
            valLbl.Text = formatValue(val) .. (cfg.Suffix or "")
            tween(fill, 0.05, {Size = UDim2.new((val - min) / range, 0, 1, 0)})
            tween(handle, 0.05, {Position = UDim2.new((val - min) / range, -6, 0.5, -6)})
            if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
            if cfg.Callback then pcall(cfg.Callback, val) end
        end

        trigger.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                drag = true
                update(inp)
