function PhantomLib:CreateTab(tabName)
    local tabData = { Name = tabName, Window = self }

    local btn = Instance.new("TextButton", self.Sidebar)
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = self.Theme.Card
    btn.BackgroundTransparency = 1
    btn.Text = tabName; btn.TextColor3 = self.Theme.Muted; btn.TextSize = 12; btn.Font = Enum.Font.GothamMedium
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local view = Instance.new("ScrollingFrame", self.Container)
    view.Size = UDim2.new(1, 0, 1, 0)
    view.BackgroundTransparency = 1; view.Visible = false
    view.ScrollBarThickness = 2; view.BorderSizePixel = 0

    local layout = Instance.new("UIListLayout", view)
    layout.Padding = UDim.new(0, 8)
    local pad = Instance.new("UIPadding", view)
    pad.PaddingTop = UDim.new(0, 12); pad.PaddingLeft = UDim.new(0, 12); pad.PaddingRight = UDim.new(0, 12); pad.PaddingBottom = UDim.new(0, 12)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        view.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 24)
    end)

    tabData.Button = btn; tabData.View = view

    local function selectTab()
        for _, tab in ipairs(self.Tabs) do
            tab.View.Visible = false
            smoothTween(tab.Button, 0.2, {BackgroundTransparency = 1, TextColor3 = self.Theme.Muted})
        end
        view.Visible = true
        smoothTween(btn, 0.2, {BackgroundTransparency = 0, TextColor3 = self.Theme.Text})
        self.ActiveTab = tabData
    end

    btn.MouseButton1Click:Connect(selectTab)
    if #self.Tabs == 0 then selectTab() end
    table.insert(self.Tabs, tabData)

    local function triggerAutoSave()
        if self.Window.AutoSaveEnabled then self.Window:SaveConfig() end
    end

    -------------------------------------------------------------------------------
    -- SECTIONS & UI ELEMENTS
    -------------------------------------------------------------------------------
    function tabData:CreateSection(sectionName)
        local secData = {}

        local secHeader = Instance.new("TextLabel", view)
        secHeader.Size = UDim2.new(1, 0, 0, 24)
        secHeader.BackgroundTransparency = 1
        secHeader.Text = sectionName or "Section"
        secHeader.TextColor3 = self.Window.Theme.Accent
        secHeader.TextSize = 11
        secHeader.Font = Enum.Font.GothamBold
        secHeader.TextXAlignment = Enum.TextXAlignment.Left

        function secData:CreateButton(cfg)
            cfg = cfg or {}
            local b = Instance.new("TextButton", view)
            b.Size = UDim2.new(1, 0, 0, 36)
            b.BackgroundColor3 = self.Window.Theme.Card
            b.Text = cfg.Name or "Button"; b.TextColor3 = self.Window.Theme.Text; b.TextSize = 12; b.Font = Enum.Font.GothamMedium
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

            b.MouseButton1Click:Connect(function()
                springTween(b, 0.15, {Size = UDim2.new(1, -4, 0, 34)})
                task.wait(0.1)
                springTween(b, 0.15, {Size = UDim2.new(1, 0, 0, 36)})
                if cfg.Callback then pcall(cfg.Callback) end
            end)
        end

        function secData:CreateToggle(cfg)
            cfg = cfg or {}
            local flag = cfg.Flag
            local state = (flag and self.Window.Flags[flag] ~= nil) and self.Window.Flags[flag] or (cfg.CurrentValue or false)

            local frame = Instance.new("Frame", view)
            frame.Size = UDim2.new(1, 0, 0, 38)
            frame.BackgroundColor3 = self.Window.Theme.Card
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

            local label = Instance.new("TextLabel", frame)
            label.Size = UDim2.new(1, -55, 1, 0); label.Position = UDim2.new(0, 12, 0, 0)
            label.BackgroundTransparency = 1; label.Text = cfg.Name or "Toggle"
            label.TextColor3 = self.Window.Theme.Text; label.TextSize = 12; label.Font = Enum.Font.Gotham; label.TextXAlignment = Enum.TextXAlignment.Left

            local track = Instance.new("Frame", frame)
            track.Size = UDim2.fromOffset(36, 18); track.Position = UDim2.new(1, -48, 0.5, -9)
            track.BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Sidebar
            Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

            local knob = Instance.new("Frame", track)
            knob.Size = UDim2.fromOffset(12, 12)
            knob.Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
            knob.BackgroundColor3 = self.Window.Theme.Text
            Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

            local trigger = Instance.new("TextButton", frame)
            trigger.Size = UDim2.new(1, 0, 1, 0); trigger.BackgroundTransparency = 1; trigger.Text = ""

            trigger.MouseButton1Click:Connect(function()
                state = not state
                smoothTween(track, 0.25, {BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Sidebar})
                springTween(knob, 0.3, {Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)})
                if flag then self.Window.Flags[flag] = state end
                if cfg.Callback then pcall(cfg.Callback, state) end
                triggerAutoSave()
            end)

            if flag then self.Window.Flags[flag] = state end
        end

        function secData:CreateSlider(cfg)
            cfg = cfg or {}
            local min = cfg.Range and cfg.Range[1] or (cfg.Min or 0)
            local max = cfg.Range and cfg.Range[2] or (cfg.Max or 100)
            local flag = cfg.Flag
            local val = (flag and self.Window.Flags[flag] ~= nil) and self.Window.Flags[flag] or math.clamp(cfg.CurrentValue or min, min, max)

            local frame = Instance.new("Frame", view)
            frame.Size = UDim2.new(1, 0, 0, 52)
            frame.BackgroundColor3 = self.Window.Theme.Card
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

            local title = Instance.new("TextLabel", frame)
            title.Size = UDim2.new(1, -24, 0, 20); title.Position = UDim2.new(0, 12, 0, 6)
            title.BackgroundTransparency = 1; title.Text = cfg.Name or "Slider"; title.TextColor3 = self.Window.Theme.Text
            title.TextSize = 12; title.Font = Enum.Font.Gotham; title.TextXAlignment = Enum.TextXAlignment.Left

            local valDisplay = Instance.new("TextLabel", frame)
            valDisplay.Size = UDim2.new(1, -24, 0, 20); valDisplay.Position = UDim2.new(0, 12, 0, 6)
            valDisplay.BackgroundTransparency = 1; valDisplay.Text = tostring(val) .. (cfg.Suffix or ""); valDisplay.TextColor3 = self.Window.Theme.Accent
            valDisplay.TextSize = 12; valDisplay.Font = Enum.Font.GothamBold; valDisplay.TextXAlignment = Enum.TextXAlignment.Right

            local track = Instance.new("Frame", frame)
            track.Size = UDim2.new(1, -24, 0, 6); track.Position = UDim2.new(0, 12, 0, 34)
            track.BackgroundColor3 = self.Window.Theme.Sidebar
            Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

            local fill = Instance.new("Frame", track)
            fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
            fill.BackgroundColor3 = self.Window.Theme.Accent
            Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

            local trigger = Instance.new("TextButton", track)
            trigger.Size = UDim2.new(1, 0, 1, 14); trigger.Position = UDim2.new(0, 0, 0, -7)
            trigger.BackgroundTransparency = 1; trigger.Text = ""

            local dragging = false
            local function update(input)
                local percent = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                val = math.floor(min + ((max - min) * percent))
                valDisplay.Text = tostring(val) .. (cfg.Suffix or "")
                smoothTween(fill, 0.1, {Size = UDim2.new(percent, 0, 1, 0)})
                if flag then self.Window.Flags[flag] = val end
                if cfg.Callback then pcall(cfg.Callback, val) end
            end

            trigger.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; update(input) end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
                    if dragging then dragging = false; triggerAutoSave() end
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
            end)

            if flag then self.Window.Flags[flag] = val end
        end

        function secData:CreateTextbox(cfg)
            cfg = cfg or {}
            local flag = cfg.Flag
            local textVal = (flag and self.Window.Flags[flag] ~= nil) and self.Window.Flags[flag] or (cfg.CurrentValue or "")

            local frame = Instance.new("Frame", view)
            frame.Size = UDim2.new(1, 0, 0, 42)
            frame.BackgroundColor3 = self.Window.Theme.Card
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

            local label = Instance.new("TextLabel", frame)
            label.Size = UDim2.new(0.45, 0, 1, 0); label.Position = UDim2.new(0, 12, 0, 0)
            label.BackgroundTransparency = 1; label.Text = cfg.Name or "Textbox"
            label.TextColor3 = self.Window.Theme.Text; label.TextSize = 12; label.Font = Enum.Font.Gotham; label.TextXAlignment = Enum.TextXAlignment.Left

            local boxBg = Instance.new("Frame", frame)
            boxBg.Size = UDim2.new(0.5, -12, 0, 28); boxBg.Position = UDim2.new(0.5, 0, 0.5, -14)
            boxBg.BackgroundColor3 = self.Window.Theme.Sidebar
            Instance.new("UICorner", boxBg).CornerRadius = UDim.new(0, 4)

            local textBox = Instance.new("TextBox", boxBg)
            textBox.Size = UDim2.new(1, -16, 1, 0); textBox.Position = UDim2.new(0, 8, 0, 0)
            textBox.BackgroundTransparency = 1; textBox.Text = textVal
            textBox.PlaceholderText = cfg.PlaceholderText or "Enter text..."
            textBox.TextColor3 = self.Window.Theme.Text; textBox.PlaceholderColor3 = self.Window.Theme.Muted
            textBox.TextSize = 11; textBox.Font = Enum.Font.Gotham; textBox.TextXAlignment = Enum.TextXAlignment.Left
            textBox.ClearTextOnFocus = false

            textBox.FocusLost:Connect(function(enterPressed)
                textVal = textBox.Text
                if flag then self.Window.Flags[flag] = textVal end
                if cfg.Callback then pcall(cfg.Callback, textVal, enterPressed) end
                triggerAutoSave()
            end)

            if flag then self.Window.Flags[flag] = textVal end
        end

        function secData:CreateDropdown(cfg)
            cfg = cfg or {}
            local options = cfg.Options or {}
            local flag = cfg.Flag
            local selected = (flag and self.Window.Flags[flag] ~= nil) and self.Window.Flags[flag] or (cfg.CurrentOption or options[1] or "Select...")
            local expanded = false

            local frame = Instance.new("Frame", view)
            frame.Size = UDim2.new(1, 0, 0, 42); frame.BackgroundColor3 = self.Window.Theme.Card
            frame.ClipsDescendants = true
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

            local label = Instance.new("TextLabel", frame)
            label.Size = UDim2.new(0.45, 0, 0, 42); label.Position = UDim2.new(0, 12, 0, 0)
            label.BackgroundTransparency = 1; label.Text = cfg.Name or "Dropdown"
            label.TextColor3 = self.Window.Theme.Text; label.TextSize = 12; label.Font = Enum.Font.Gotham; label.TextXAlignment = Enum.TextXAlignment.Left

            local mainBtn = Instance.new("TextButton", frame)
            mainBtn.Size = UDim2.new(0.5, -12, 0, 28); mainBtn.Position = UDim2.new(0.5, 0, 0, 7)
            mainBtn.BackgroundColor3 = self.Window.Theme.Sidebar
            mainBtn.Text = tostring(selected); mainBtn.TextColor3 = self.Window.Theme.Muted; mainBtn.TextSize = 11; mainBtn.Font = Enum.Font.Gotham
            Instance.new("UICorner", mainBtn).CornerRadius = UDim.new(0, 4)

            local listHolder = Instance.new("Frame", frame)
            listHolder.Size = UDim2.new(1, -24, 0, #options * 26)
            listHolder.Position = UDim2.new(0, 12, 0, 44)
            listHolder.BackgroundTransparency = 1

            local listLayout = Instance.new("UIListLayout", listHolder)
            listLayout.Padding = UDim.new(0, 4)

            local function buildOptions()
                for _, child in ipairs(listHolder:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                for _, opt in ipairs(options) do
                    local optBtn = Instance.new("TextButton", listHolder)
                    optBtn.Size = UDim2.new(1, 0, 0, 24)
                    optBtn.BackgroundColor3 = self.Window.Theme.Background
                    optBtn.Text = opt; optBtn.TextSize = 11; optBtn.Font = Enum.Font.Gotham
                    optBtn.TextColor3 = (selected == opt) and self.Window.Theme.Accent or self.Window.Theme.Muted
                    Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 4)

                    optBtn.MouseButton1Click:Connect(function()
                        selected = opt
                        expanded = false
                        mainBtn.Text = tostring(selected)
                        springTween(frame, 0.3, {Size = UDim2.new(1, 0, 0, 42)})
                        buildOptions()
                        if flag then self.Window.Flags[flag] = selected end
                        if cfg.Callback then pcall(cfg.Callback, selected) end
                        triggerAutoSave()
                    end)
                end
            end

            buildOptions()

            mainBtn.MouseButton1Click:Connect(function()
                expanded = not expanded
                springTween(frame, 0.3, {Size = UDim2.new(1, 0, 0, expanded and (52 + #options * 26) or 42)})
            end)

            if flag then self.Window.Flags[flag] = selected end
        end

        return secData
    end

    return tabData
end

function PhantomLib:Destroy()
    if self.StatsConnection then self.StatsConnection:Disconnect() end
    if self.Screen then self.Screen:Destroy() end
end

return PhantomLib
