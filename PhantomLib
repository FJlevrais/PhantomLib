function PhantomLib:CreateTab(name)
    local tab = {Name = name, Window = self}

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = self.Theme.Card
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = self.Sidebar
    corner(btn, 5)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -12, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = self.Theme.Muted
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = btn

    local view = Instance.new("ScrollingFrame")
    view.Size = UDim2.new(1, 0, 1, 0)
    view.BackgroundTransparency = 1
    view.Visible = false
    view.ScrollBarThickness = 2
    view.ScrollBarImageColor3 = self.Theme.Border
    view.BorderSizePixel = 0
    view.CanvasSize = UDim2.new(0, 0, 0, 0)
    view.Parent = self.Container

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.Parent = view
    padding(view, 8, 10, 10, 10)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        view.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
    end)

    tab.Button = btn
    tab.View = view
    tab.Label = lbl

    local function select()
        for _, t in ipairs(self.Tabs) do
            t.View.Visible = false
            tween(t.Button, 0.15, {BackgroundTransparency = 1})
            tween(t.Label, 0.15, {TextColor3 = self.Theme.Muted})
        end
        view.Visible = true
        tween(btn, 0.15, {BackgroundTransparency = 0, BackgroundColor3 = self.Theme.Card})
        tween(lbl, 0.15, {TextColor3 = self.Theme.Text})
        self.ActiveTab = tab
    end

    btn.MouseButton1Click:Connect(select)
    if #self.Tabs == 0 then select() end
    table.insert(self.Tabs, tab)

    -- SECTION HEADER
    function tab:CreateSection(titleText)
        local secLbl = Instance.new("TextLabel")
        secLbl.Size = UDim2.new(1, 0, 0, 20)
        secLbl.BackgroundTransparency = 1
        secLbl.Text = string.upper(titleText)
        secLbl.TextColor3 = self.Window.Theme.Accent
        secLbl.TextSize = 10
        secLbl.Font = Enum.Font.GothamBold
        secLbl.TextXAlignment = Enum.TextXAlignment.Left
        secLbl.Parent = view
    end

    -- BUTTON
    function tab:CreateButton(cfg)
        cfg = cfg or {}
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 30)
        b.BackgroundColor3 = self.Window.Theme.Card
        b.Text = cfg.Name or "Button"
        b.TextColor3 = self.Window.Theme.Text
        b.TextSize = 12
        b.Font = Enum.Font.GothamMedium
        b.AutoButtonColor = false
        b.Parent = view
        corner(b, 5)
        stroke(b, self.Window.Theme.Border, 1, 0)

        b.MouseEnter:Connect(function()
            tween(b, 0.12, {BackgroundColor3 = self.Window.Theme.Button})
        end)
        b.MouseLeave:Connect(function()
            tween(b, 0.12, {BackgroundColor3 = self.Window.Theme.Card})
        end)
        b.MouseButton1Click:Connect(function()
            if cfg.Callback then pcall(cfg.Callback) end
        end)
    end

    -- TOGGLE
    function tab:CreateToggle(cfg)
        cfg = cfg or {}
        local state = cfg.CurrentValue or false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 32)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.Parent = view
        corner(frame, 5)
        stroke(frame, self.Window.Theme.Border, 1, 0)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -50, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = cfg.Name or "Toggle"
        label.TextColor3 = self.Window.Theme.Text
        label.TextSize = 12
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local track = Instance.new("Frame")
        track.Size = UDim2.fromOffset(32, 16)
        track.Position = UDim2.new(1, -40, 0.5, -8)
        track.BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Button
        track.Parent = frame
        corner(track, 8)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(12, 12)
        knob.Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.Parent = track
        corner(knob, 6)

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 0)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = frame

        local obj = {}
        local function update(v)
            state = v
            tween(track, 0.15, {BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Button})
            tween(knob, 0.15, {Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)})
            if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
            if cfg.Callback then pcall(cfg.Callback, state) end
        end

        function obj:Set(v) update(v) end
        function obj:Get() return state end

        trigger.MouseButton1Click:Connect(function() update(not state) end)
        return obj
    end

    -- SLIDER
    function tab:CreateSlider(cfg)
        cfg = cfg or {}
        local min = cfg.Range and cfg.Range[1] or 0
        local max = cfg.Range and cfg.Range[2] or 100
        local increment = cfg.Increment or 1
        local val = math.clamp(cfg.CurrentValue or min, min, max)

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 42)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.Parent = view
        corner(frame, 5)
        stroke(frame, self.Window.Theme.Border, 1, 0)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.6, 0, 0, 18)
        title.Position = UDim2.new(0, 10, 0, 4)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Slider"
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 12
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0.4, -10, 0, 18)
        valLbl.Position = UDim2.new(0.6, 0, 0, 4)
        valLbl.BackgroundTransparency = 1
        valLbl.Text = tostring(val) .. (cfg.Suffix or "")
        valLbl.TextColor3 = self.Window.Theme.Muted
        valLbl.TextSize = 11
        valLbl.Font = Enum.Font.Gotham
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.Parent = frame

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -20, 0, 4)
        track.Position = UDim2.new(0, 10, 0, 26)
        track.BackgroundColor3 = self.Window.Theme.Button
        track.Parent = frame
        corner(track, 2)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = self.Window.Theme.Accent
        fill.Parent = track
        corner(fill, 2)

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 10)
        trigger.Position = UDim2.new(0, 0, 0, -3)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = track

        local drag = false
        local function update(inp)
            local pct = math.clamp((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = math.floor((min + (max - min) * pct) / increment + 0.5) * increment
            valLbl.Text = tostring(val) .. (cfg.Suffix or "")
            tween(fill, 0.05, {Size = UDim2.new((val - min) / (max - min), 0, 1, 0)})
            if cfg.Callback then pcall(cfg.Callback, val) end
        end

        trigger.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                drag = true
                update(inp)
            end
        end)
        UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
        end)
        UIS.InputChanged:Connect(function(inp)
            if drag and inp.UserInputType == Enum.UserInputType.MouseMovement then update(inp) end
        end)
    end

    -- TEXT INPUT / TEXTBOX
    function tab:CreateInput(cfg)
        cfg = cfg or {}
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 32)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.Parent = view
        corner(frame, 5)
        stroke(frame, self.Window.Theme.Border, 1, 0)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.4, 0, 1, 0)
        title.Position = UDim2.new(0, 10, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Input"
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 12
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local box = Instance.new("TextBox")
        box.Size = UDim2.new(0.6, -16, 0, 22)
        box.Position = UDim2.new(0.4, 6, 0.5, -11)
        box.BackgroundColor3 = self.Window.Theme.Button
        box.Text = cfg.CurrentValue or ""
        box.PlaceholderText = cfg.Placeholder or "Enter text..."
        box.TextColor3 = self.Window.Theme.Text
        box.PlaceholderColor3 = self.Window.Theme.Muted
        box.TextSize = 11
        box.Font = Enum.Font.Gotham
        box.Parent = frame
        corner(box, 4)
        stroke(box, self.Window.Theme.Border, 1, 0)

        box.FocusLost:Connect(function(enterPressed)
            if cfg.Callback then pcall(cfg.Callback, box.Text, enterPressed) end
        end)
    end

    -- DROPDOWN / SELECT
    function tab:CreateSelect(cfg)
        cfg = cfg or {}
        local options = cfg.Options or {}
        local selected = cfg.CurrentValue or options[1] or "Select..."

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 32)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.Parent = view
        corner(frame, 5)
        stroke(frame, self.Window.Theme.Border, 1, 0)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.5, 0, 1, 0)
        title.Position = UDim2.new(0, 10, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Select"
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 12
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0.5, -24, 1, 0)
        valLbl.Position = UDim2.new(0.5, 0, 0, 0)
        valLbl.BackgroundTransparency = 1
        valLbl.Text = tostring(selected)
        valLbl.TextColor3 = self.Window.Theme.Muted
        valLbl.TextSize = 12
        valLbl.Font = Enum.Font.Gotham
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.Parent = frame

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text = ""
        btn.Parent = frame

        btn.MouseButton1Click:Connect(function()
            local idx = table.find(options, selected) or 0
            idx = (idx % #options) + 1
            selected = options[idx]
            valLbl.Text = tostring(selected)
            if cfg.Callback then pcall(cfg.Callback, selected) end
        end)
    end

    -- MULTI-SELECT DROPDOWN
    function tab:CreateMultiDropdown(cfg)
        cfg = cfg or {}
        local options = cfg.Options or {}
        local selectedMap = {}

        if cfg.CurrentValue then
            for _, v in ipairs(cfg.CurrentValue) do selectedMap[v] = true end
        end

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 32)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.Parent = view
        corner(frame, 5)
        stroke(frame, self.Window.Theme.Border, 1, 0)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.5, 0, 1, 0)
        title.Position = UDim2.new(0, 10, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Multi Select"
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 12
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0.5, -10, 1, 0)
        valLbl.Position = UDim2.new(0.5, 0, 0, 0)
        valLbl.BackgroundTransparency = 1
        valLbl.Text = "Click to cycle"
        valLbl.TextColor3 = self.Window.Theme.Muted
        valLbl.TextSize = 11
        valLbl.Font = Enum.Font.Gotham
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.Parent = frame

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text = ""
        btn.Parent = frame

        local idx = 1
        btn.MouseButton1Click:Connect(function()
            local opt = options[idx]
            if opt then
                selectedMap[opt] = not selectedMap[opt]
                local active = {}
                for k, v in pairs(selectedMap) do if v then table.insert(active, k) end end
                valLbl.Text = #active > 0 and table.concat(active, ", ") or "None"
                if cfg.Callback then pcall(cfg.Callback, active) end
            end
            idx = (idx % #options) + 1
        end)
    end

    -- KEYBIND
    function tab:CreateKeybind(cfg)
        cfg = cfg or {}
        local key = cfg.CurrentKeybind or "None"
        local listening = false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 32)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.Parent = view
        corner(frame, 5)
        stroke(frame, self.Window.Theme.Border, 1, 0)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.6, 0, 1, 0)
        title.Position = UDim2.new(0, 10, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Keybind"
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 12
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 70, 0, 22)
        btn.Position = UDim2.new(1, -76, 0.5, -11)
        btn.BackgroundColor3 = self.Window.Theme.Button
        btn.Text = key
        btn.TextColor3 = self.Window.Theme.Muted
        btn.TextSize = 11
        btn.Font = Enum.Font.GothamMedium
        btn.Parent = frame
        corner(btn, 4)

        btn.MouseButton1Click:Connect(function()
            listening = true
            btn.Text = "..."
        end)

        UIS.InputBegan:Connect(function(inp, gpe)
            if listening and inp.UserInputType == Enum.UserInputType.Keyboard then
                listening = false
                key = inp.KeyCode.Name
                btn.Text = key
                if cfg.Callback then pcall(cfg.Callback, key) end
            elseif not gpe and inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode.Name == key then
                if cfg.Callback then pcall(cfg.Callback, key) end
            end
        end)
    end

    -- COLOR PICKER
    function tab:CreateColorPicker(cfg)
        cfg = cfg or {}
        local col = cfg.Color or Color3.fromRGB(255, 255, 255)

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 32)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.Parent = view
        corner(frame, 5)
        stroke(frame, self.Window.Theme.Border, 1, 0)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.6, 0, 1, 0)
        title.Position = UDim2.new(0, 10, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Color Picker"
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 12
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local preview = Instance.new("Frame")
        preview.Size = UDim2.fromOffset(20, 20)
        preview.Position = UDim2.new(1, -30, 0.5, -10)
        preview.BackgroundColor3 = col
        preview.Parent = frame
        corner(preview, 4)
        stroke(preview, self.Window.Theme.Border, 1, 0)

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text = ""
        btn.Parent = frame

        -- Palette Switcher built-in
        local presetColors = {
            Color3.fromRGB(239, 68, 68),
            Color3.fromRGB(34, 197, 94),
            Color3.fromRGB(59, 130, 246),
            Color3.fromRGB(168, 85, 247),
            Color3.fromRGB(245, 158, 11)
        }
        local cIdx = 1

        btn.MouseButton1Click:Connect(function()
            cIdx = (cIdx % #presetColors) + 1
            col = presetColors[cIdx]
            preview.BackgroundColor3 = col
            if cfg.Callback then pcall(cfg.Callback, col) end
        end)
    end

    return tab
end

function PhantomLib:DisableAllAndDestroy()
    if self.Screen then self.Screen:Destroy() end
end

return PhantomLib
