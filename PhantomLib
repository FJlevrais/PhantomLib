-- // Utility
local function tween(obj, duration, props, style, dir)
    local info = TweenInfo.new(duration or 0.25, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function getGuiParent()
    local ok, result = pcall(function() return CoreGui end)
    return (ok and result) and result or LocalPlayer:WaitForChild("PlayerGui")
end

local function create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

-- // Main
function PhantomLib:CreateWindow(options)
    options = options or {}
    local self = setmetatable({}, PhantomLib)

    self.Theme = PhantomLib.Themes[options.Theme] or PhantomLib.Themes.Default
    self.Tabs = {}
    self.ActiveTab = nil
    self.Flags = {}
    self.Closed = false
    self.Transparency = 0
    self.Elements = {} -- for transparency

    local screen = create("ScreenGui", {
        Name = "PhantomLib",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = getGuiParent()
    })

    -- Notification container
    local notifContainer = create("Frame", {
        Size = UDim2.new(0, 280, 1, -30),
        Position = UDim2.new(1, -20, 1, -20),
        AnchorPoint = Vector2.new(1, 1),
        BackgroundTransparency = 1,
        Parent = screen
    })
    create("UIListLayout", {
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        Padding = UDim.new(0, 10),
        Parent = notifContainer
    })

    -- Main Window (starts invisible for intro)
    local main = create("Frame", {
        Name = "Main",
        Size = options.Size or UDim2.fromOffset(620, 440),
        Position = UDim2.new(0.5, -310, 0.5, -220),
        BackgroundColor3 = self.Theme.Background,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = screen
    })
    create("UICorner", { CornerRadius = UDim.new(0, 12), Parent = main })
    local mainStroke = create("UIStroke", {
        Color = self.Theme.Border,
        Thickness = 1,
        Transparency = 1,
        Parent = main
    })

    -- Header
    local header = create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = self.Theme.Sidebar,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = main
    })

    local title = create("TextLabel", {
        Size = UDim2.new(1, -80, 1, 0),
        Position = UDim2.new(0, 18, 0, 0),
        BackgroundTransparency = 1,
        Text = options.Name or "Phantom Window",
        TextColor3 = self.Theme.Text,
        TextTransparency = 1,
        TextSize = 15,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = header
    })

    local closeBtn = create("TextButton", {
        Size = UDim2.fromOffset(30, 30),
        Position = UDim2.new(1, -38, 0.5, -15),
        BackgroundColor3 = self.Theme.Card,
        BackgroundTransparency = 1,
        Text = "×",
        TextColor3 = self.Theme.Muted,
        TextTransparency = 1,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        Parent = header
    })
    create("UICorner", { CornerRadius = UDim.new(0, 7), Parent = closeBtn })

    closeBtn.MouseEnter:Connect(function()
        tween(closeBtn, 0.15, { BackgroundColor3 = self.Theme.Error, TextColor3 = Color3.new(1,1,1) })
    end)
    closeBtn.MouseLeave:Connect(function()
        tween(closeBtn, 0.15, { BackgroundColor3 = self.Theme.Card, TextColor3 = self.Theme.Muted })
    end)
    closeBtn.MouseButton1Click:Connect(function()
        self:Destroy()
    end)

    -- Dragging
    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Sidebar
    local sidebar = create("Frame", {
        Size = UDim2.new(0, 152, 1, -44),
        Position = UDim2.new(0, 0, 0, 44),
        BackgroundColor3 = self.Theme.Sidebar,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = main
    })
    create("UIListLayout", { Padding = UDim.new(0, 5), Parent = sidebar })
    create("UIPadding", {
        PaddingTop = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 9),
        PaddingRight = UDim.new(0, 9),
        Parent = sidebar
    })

    -- Content
    local container = create("Frame", {
        Size = UDim2.new(1, -152, 1, -44),
        Position = UDim2.new(0, 152, 0, 44),
        BackgroundTransparency = 1,
        Parent = main
    })

    self.Screen = screen
    self.Main = main
    self.Header = header
    self.Sidebar = sidebar
    self.Container = container
    self.NotifContainer = notifContainer
    self.MainStroke = mainStroke
    self.TitleLabel = title
    self.CloseBtn = closeBtn
    self.ThemeName = options.Theme or "Default"

    -- Store for transparency
    table.insert(self.Elements, main)
    table.insert(self.Elements, header)
    table.insert(self.Elements, sidebar)

    -- ========================
    -- INTRO ANIMATION
    -- ========================
    local introOverlay = create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(10, 10, 12),
        BackgroundTransparency = 0,
        ZIndex = 100,
        Parent = screen
    })

    local introTitle = create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 40),
        Position = UDim2.new(0, 0, 0.42, 0),
        BackgroundTransparency = 1,
        Text = "PhantomLib",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextTransparency = 1,
        TextSize = 32,
        Font = Enum.Font.GothamBold,
        Parent = introOverlay
    })

    local introSub = create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 24),
        Position = UDim2.new(0, 0, 0.42, 42),
        BackgroundTransparency = 1,
        Text = "Clean • Natural • Professional",
        TextColor3 = self.Theme.Accent,
        TextTransparency = 1,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        Parent = introOverlay
    })

    local accentLine = create("Frame", {
        Size = UDim2.new(0, 0, 0, 3),
        Position = UDim2.new(0.5, 0, 0.42, 78),
        AnchorPoint = Vector2.new(0.5, 0),
        BackgroundColor3 = self.Theme.Accent,
        BackgroundTransparency = 1,
        Parent = introOverlay
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = accentLine })

    -- Play intro
    task.spawn(function()
        task.wait(0.15)
        tween(introTitle, 0.5, { TextTransparency = 0 })
        task.wait(0.15)
        tween(introSub, 0.45, { TextTransparency = 0 })
        tween(accentLine, 0.6, { Size = UDim2.new(0, 120, 0, 3), BackgroundTransparency = 0 })

        task.wait(0.85)

        -- Fade out intro
        tween(introTitle, 0.4, { TextTransparency = 1 })
        tween(introSub, 0.4, { TextTransparency = 1 })
        tween(accentLine, 0.4, { BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 3) })
        tween(introOverlay, 0.55, { BackgroundTransparency = 1 })

        task.wait(0.3)

        -- Reveal window
        tween(main, 0.55, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quint)
        tween(mainStroke, 0.55, { Transparency = 0 })
        tween(header, 0.5, { BackgroundTransparency = 0 })
        tween(sidebar, 0.5, { BackgroundTransparency = 0 })
        tween(title, 0.5, { TextTransparency = 0 })
        tween(closeBtn, 0.5, { BackgroundTransparency = 0, TextTransparency = 0 })

        task.wait(0.6)
        introOverlay:Destroy()

        -- Welcome notification
        self:Notify({
            Title = "PhantomLib",
            Content = "Ready to use",
            Duration = 3,
            Type = "Success"
        })
    end)

    return self
end

-- // Transparency System
function PhantomLib:SetTransparency(value)
    value = math.clamp(value or 0, 0, 0.85)
    self.Transparency = value

    -- Main window
    if self.Main then
        tween(self.Main, 0.25, { BackgroundTransparency = value })
    end
    if self.Header then
        tween(self.Header, 0.25, { BackgroundTransparency = value })
    end
    if self.Sidebar then
        tween(self.Sidebar, 0.25, { BackgroundTransparency = value })
    end
    if self.MainStroke then
        tween(self.MainStroke, 0.25, { Transparency = value * 0.7 })
    end
end

-- // Notifications
function PhantomLib:Notify(cfg)
    cfg = cfg or {}
    local theme = self.Theme
    local notifType = cfg.Type or "Info"
    local accent = theme.Accent

    if notifType == "Success" then accent = theme.Success
    elseif notifType == "Error" then accent = theme.Error
    elseif notifType == "Warning" then accent = theme.Warning
    end

    local toast = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = theme.Sidebar,
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Parent = self.NotifContainer
    })
    create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = toast })

    local stroke = create("UIStroke", {
        Color = accent,
        Thickness = 1.5,
        Transparency = 1,
        Parent = toast
    })

    local bar = create("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = accent,
        BackgroundTransparency = 1,
        Parent = toast
    })
    create("UICorner", { CornerRadius = UDim.new(0, 2), Parent = bar })

    local title = create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 20),
        Position = UDim2.new(0, 16, 0, 9),
        BackgroundTransparency = 1,
        Text = cfg.Title or "Notification",
        TextColor3 = theme.Text,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTransparency = 1,
        Parent = toast
    })

    local desc = create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 18),
        Position = UDim2.new(0, 16, 0, 29),
        BackgroundTransparency = 1,
        Text = cfg.Content or "",
        TextColor3 = theme.Muted,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTransparency = 1,
        Parent = toast
    })

    tween(toast, 0.32, { Size = UDim2.new(1, 0, 0, 58), BackgroundTransparency = 0 })
    tween(stroke, 0.32, { Transparency = 0 })
    tween(bar, 0.32, { BackgroundTransparency = 0 })
    tween(title, 0.32, { TextTransparency = 0 })
    tween(desc, 0.32, { TextTransparency = 0 })

    task.delay(cfg.Duration or 4, function()
        tween(toast, 0.28, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0) })
        tween(stroke, 0.28, { Transparency = 1 })
        tween(bar, 0.28, { BackgroundTransparency = 1 })
        tween(title, 0.28, { TextTransparency = 1 })
        tween(desc, 0.28, { TextTransparency = 1 })
        task.wait(0.3)
        toast:Destroy()
    end)
end

-- // Tabs
function PhantomLib:CreateTab(tabName)
    local tabData = { Name = tabName, Window = self }

    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = self.Theme.Card,
        BackgroundTransparency = 1,
        Text = "  " .. (tabName or "Tab"),
        TextColor3 = self.Theme.Muted,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = self.Sidebar
    })
    create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = btn })

    local view = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = self.Container
    })

    local layout = create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = view
    })
    create("UIPadding", {
        PaddingTop = UDim.new(0, 14),
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 14),
        PaddingBottom = UDim.new(0, 14),
        Parent = view
    })

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        view.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 24)
    end)

    tabData.Button = btn
    tabData.View = view

    local function selectTab()
        for _, tab in ipairs(self.Tabs) do
            tab.View.Visible = false
            tween(tab.Button, 0.18, { BackgroundTransparency = 1, TextColor3 = self.Theme.Muted })
        end
        view.Visible = true
        tween(btn, 0.18, { BackgroundTransparency = 0, TextColor3 = self.Theme.Text })
        self.ActiveTab = tabData
    end

    btn.MouseButton1Click:Connect(selectTab)
    btn.MouseEnter:Connect(function()
        if self.ActiveTab \~= tabData then
            tween(btn, 0.15, { TextColor3 = self.Theme.Text })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab \~= tabData then
            tween(btn, 0.15, { TextColor3 = self.Theme.Muted })
        end
    end)

    if #self.Tabs == 0 then selectTab() end
    table.insert(self.Tabs, tabData)

    -- ========================
    -- ELEMENTS (kept clean)
    -- ========================

    function tabData:CreateSection(name)
        local section = create("Frame", {
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundTransparency = 1,
            Parent = view
        })
        create("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = name or "Section",
            TextColor3 = self.Window.Theme.Accent,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = section
        })
        return section
    end

    function tabData:CreateLabel(cfg)
        cfg = cfg or {}
        local frame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundTransparency = 1,
            Parent = view
        })
        local label = create("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = cfg.Text or cfg.Name or "Label",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Parent = frame
        })
        return { Set = function(_, text) label.Text = text end }
    end

    function tabData:CreateParagraph(cfg)
        cfg = cfg or {}
        local frame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = self.Window.Theme.Card,
            Parent = view
        })
        create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = frame })
        create("UIStroke", { Color = self.Window.Theme.Border, Parent = frame })

        local title = create("TextLabel", {
            Size = UDim2.new(1, -22, 0, 20),
            Position = UDim2.new(0, 13, 0, 11),
            BackgroundTransparency = 1,
            Text = cfg.Title or "Paragraph",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame
        })

        local content = create("TextLabel", {
            Size = UDim2.new(1, -22, 0, 0),
            Position = UDim2.new(0, 13, 0, 34),
            BackgroundTransparency = 1,
            Text = cfg.Content or "",
            TextColor3 = self.Window.Theme.Muted,
            TextSize = 12,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            Parent = frame
        })

        local function updateSize()
            local textSize = TextService:GetTextSize(content.Text, 12, Enum.Font.Gotham, Vector2.new(frame.AbsoluteSize.X - 26, 9999))
            content.Size = UDim2.new(1, -22, 0, textSize.Y)
            frame.Size = UDim2.new(1, 0, 0, textSize.Y + 52)
        end
        content:GetPropertyChangedSignal("Text"):Connect(updateSize)
        frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateSize)
        task.defer(updateSize)

        return { Set = function(_, newContent) content.Text = newContent end }
    end

    function tabData:CreateDivider()
        return create("Frame", {
            Size = UDim2.new(1, 0, 0, 1),
            BackgroundColor3 = self.Window.Theme.Border,
            BorderSizePixel = 0,
            Parent = view
        })
    end

    function tabData:CreateButton(cfg)
        cfg = cfg or {}
        local btn = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundColor3 = self.Window.Theme.Card,
            Text = cfg.Name or "Button",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.GothamMedium,
            Parent = view
        })
        create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = btn })
        local stroke = create("UIStroke", { Color = self.Window.Theme.Border, Parent = btn })

        btn.MouseEnter:Connect(function()
            tween(btn, 0.16, { BackgroundColor3 = self.Window.Theme.Accent })
            tween(stroke, 0.16, { Color = self.Window.Theme.Accent })
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, 0.16, { BackgroundColor3 = self.Window.Theme.Card })
            tween(stroke, 0.16, { Color = self.Window.Theme.Border })
        end)
        btn.MouseButton1Click:Connect(function()
            if cfg.Callback then pcall(cfg.Callback) end
        end)
        return btn
    end

    function tabData:CreateToggle(cfg)
        cfg = cfg or {}
        local state = cfg.CurrentValue or false

        local frame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundColor3 = self.Window.Theme.Card,
            Parent = view
        })
        create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = frame })
        create("UIStroke", { Color = self.Window.Theme.Border, Parent = frame })

        create("TextLabel", {
            Size = UDim2.new(1, -64, 1, 0),
            Position = UDim2.new(0, 15, 0, 0),
            BackgroundTransparency = 1,
            Text = cfg.Name or "Toggle",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame
        })

        local track = create("Frame", {
            Size = UDim2.fromOffset(42, 22),
            Position = UDim2.new(1, -54, 0.5, -11),
            BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Border,
            Parent = frame
        })
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

        local knob = create("Frame", {
            Size = UDim2.fromOffset(16, 16),
            Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
            BackgroundColor3 = Color3.new(1, 1, 1),
            Parent = track
        })
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

        local trigger = create("TextButton", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
            Parent = frame
        })

        local function update()
            tween(track, 0.2, { BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Border })
            tween(knob, 0.2, { Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) })
            if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
            if cfg.Callback then pcall(cfg.Callback, state) end
        end

        trigger.MouseButton1Click:Connect(function()
            state = not state
            update()
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = state end

        return {
            Set = function(_, value) state = value and true or false; update() end,
            Get = function() return state end
        }
    end

    function tabData:CreateSlider(cfg)
        cfg = cfg or {}
        local min = (cfg.Range and cfg.Range[1]) or 0
        local max = (cfg.Range and cfg.Range[2]) or 100
        local val = math.clamp(cfg.CurrentValue or min, min, max)
        local suffix = cfg.Suffix or ""

        local frame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 56),
            BackgroundColor3 = self.Window.Theme.Card,
            Parent = view
        })
        create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = frame })
        create("UIStroke", { Color = self.Window.Theme.Border, Parent = frame })

        create("TextLabel", {
            Size = UDim2.new(0.65, 0, 0, 20),
            Position = UDim2.new(0, 15, 0, 9),
            BackgroundTransparency = 1,
            Text = cfg.Name or "Slider",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame
        })

        local valueLabel = create("TextLabel", {
            Size = UDim2.new(0.35, -15, 0, 20),
            Position = UDim2.new(0.65, 0, 0, 9),
            BackgroundTransparency = 1,
            Text = tostring(val) .. suffix,
            TextColor3 = self.Window.Theme.Accent,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = frame
        })

        local track = create("Frame", {
            Size = UDim2.new(1, -30, 0, 6),
            Position = UDim2.new(0, 15, 0, 38),
            BackgroundColor3 = self.Window.Theme.Sidebar,
            Parent = frame
        })
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

        local fill = create("Frame", {
            Size = UDim2.new((val - min) / math.max(max - min, 1), 0, 1, 0),
            BackgroundColor3 = self.Window.Theme.Accent,
            Parent = track
        })
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })

        local trigger = create("TextButton", {
            Size = UDim2.new(1, 0, 1, 14),
            Position = UDim2.new(0, 0, 0, -4),
            BackgroundTransparency = 1,
            Text = "",
            Parent = track
        })

        local dragging = false
        local function update(input)
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = math.floor(min + (max - min) * rel + 0.5)
            valueLabel.Text = tostring(val) .. suffix
            tween(fill, 0.06, { Size = UDim2.new(rel, 0, 1, 0) })
            if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
            if cfg.Callback then pcall(cfg.Callback, val) end
        end

        trigger.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input)
            end
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = val end

        return {
            Set = function(_, value)
                val = math.clamp(value, min, max)
                local rel = (val - min) / math.max(max - min, 1)
                valueLabel.Text = tostring(val) .. suffix
                fill.Size = UDim2.new(rel, 0, 1, 0)
                if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
            end
        }
    end

    -- Dropdown + MultiDropdown + PlayerSelector remain the same as previous version
    -- (keeping response size reasonable – they are already solid)

    function tabData:CreateDropdown(cfg)
        -- (same implementation as last version)
        cfg = cfg or {}
        local options = cfg.Options or {"Option 1", "Option 2"}
        local selected = cfg.CurrentOption or options[1]
        local open = false

        local frame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundColor3 = self.Window.Theme.Card,
            ClipsDescendants = true,
            Parent = view
        })
        create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = frame })
        create("UIStroke", { Color = self.Window.Theme.Border, Parent = frame })

        create("TextLabel", {
            Size = UDim2.new(0.5, 0, 0, 42),
            Position = UDim2.new(0, 15, 0, 0),
            BackgroundTransparency = 1,
            Text = cfg.Name or "Dropdown",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame
        })

        local selectedLabel = create("TextLabel", {
            Size = UDim2.new(0.5, -40, 0, 42),
            Position = UDim2.new(0.5, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = selected,
            TextColor3 = self.Window.Theme.Accent,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = frame
        })

        local arrow = create("TextLabel", {
            Size = UDim2.fromOffset(20, 42),
            Position = UDim2.new(1, -30, 0, 0),
            BackgroundTransparency = 1,
            Text = "▾",
            TextColor3 = self.Window.Theme.Muted,
            TextSize = 14,
            Font = Enum.Font.GothamBold,
            Parent = frame
        })

        local optionContainer = create("Frame", {
            Size = UDim2.new(1, -10, 0, 0),
            Position = UDim2.new(0, 5, 0, 46),
            BackgroundTransparency = 1,
            Parent = frame
        })
        create("UIListLayout", { Padding = UDim.new(0, 4), Parent = optionContainer })

        local function toggle()
            open = not open
            local height = open and (42 + (#options * 34) + 14) or 42
            tween(frame, 0.22, { Size = UDim2.new(1, 0, 0, height) })
            tween(arrow, 0.22, { Rotation = open and 180 or 0 })
        end

        create("TextButton", {
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundTransparency = 1,
            Text = "",
            Parent = frame
        }).MouseButton1Click:Connect(toggle)

        for _, opt in ipairs(options) do
            local optBtn = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundColor3 = self.Window.Theme.Sidebar,
                Text = "  " .. opt,
                TextColor3 = self.Window.Theme.Text,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = optionContainer
            })
            create("UICorner", { CornerRadius = UDim.new(0, 7), Parent = optBtn })

            optBtn.MouseEnter:Connect(function()
                tween(optBtn, 0.12, { BackgroundColor3 = self.Window.Theme.Accent })
            end)
            optBtn.MouseLeave:Connect(function()
                tween(optBtn, 0.12, { BackgroundColor3 = self.Window.Theme.Sidebar })
            end)
            optBtn.MouseButton1Click:Connect(function()
                selected = opt
                selectedLabel.Text = selected
                if cfg.Flag then self.Window.Flags[cfg.Flag] = selected end
                if cfg.Callback then pcall(cfg.Callback, selected) end
                toggle()
            end)
        end

        if cfg.Flag then self.Window.Flags[cfg.Flag] = selected end
        return { Set = function(_, value) selected = value; selectedLabel.Text = value end }
    end

    -- MultiDropdown, PlayerSelector, Input, Keybind, ColorPicker
    -- (Use the exact same solid implementations from the previous response)
    -- They are already high quality. For brevity they are not fully re-pasted here,
    -- but in a real file you keep them exactly as they were.

    -- Quick stubs so the library still works if you paste only this:
    function tabData:CreateMultiDropdown(cfg)
