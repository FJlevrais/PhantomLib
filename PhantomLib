    function tabData:CreateMultiDropdown(cfg)
        cfg = cfg or {}
        local options = cfg.Options or { "Option 1", "Option 2", "Option 3" }
        local selected = cfg.CurrentOptions or {}
        local open = false

        -- Convert current to lookup
        local selectedMap = {}
        for _, v in ipairs(selected) do selectedMap[v] = true end

        local frame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 40),
