        local filteredOptions = {}
        
        -- Update dropdown height
        local function updateDropdownHeight(count)
            local visibleCount = math.min(count or #filteredOptions, maxVisible)
            local searchHeight = 34
            local listHeight = visibleCount * (itemHeight + 2) + 6
            local totalHeight = searchHeight + listHeight
            content.Size = UDim2.new(1, -8, 0, totalHeight)
            list.Size = UDim2.new(1, 0, 0, listHeight)
        end

        -- Build filtered options
        local function buildOptions(filterText)
            filterText = string.lower(filterText or "")
            
            -- Clear existing buttons
            for _, btn in pairs(optionButtons) do
                btn:Destroy()
            end
            optionButtons = {}
            
            -- Filter options
            filteredOptions = {}
            if filterText == "" then
                for _, opt in ipairs(options) do
                    table.insert(filteredOptions, opt)
                end
            else
                for _, opt in ipairs(options) do
                    if string.find(string.lower(tostring(opt)), filterText, 1, true) then
                        table.insert(filteredOptions, opt)
                    end
                end
            end
            
            -- Create buttons
            for i, opt in ipairs(filteredOptions) do
                local isSelected = selected[opt] == true
                local b = Instance.new("TextButton")
                b.Size = UDim2.new(1, 0, 0, itemHeight)
                b.BackgroundColor3 = isSelected and self.Window.Theme.Accent or self.Window.Theme.Card
                b.BackgroundTransparency = isSelected and 0.3 or 0.65
                b.Text = ""
                b.AutoButtonColor = false
                b.LayoutOrder = i
                b.ZIndex = 7
                b.Parent = list
                corner(b, 5)

                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, -30, 1, 0)
                lbl.Position = UDim2.new(0, 8, 0, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = tostring(opt)
                lbl.TextColor3 = self.Window.Theme.Text
                lbl.TextSize = 12
                lbl.Font = Enum.Font.Gotham
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.ZIndex = 8
                lbl.Parent = b

                local check = Instance.new("TextLabel")
                check.Size = UDim2.fromOffset(18, 18)
                check.Position = UDim2.new(1, -24, 0.5, -9)
                check.BackgroundTransparency = 1
                check.Text = isSelected and "✓" or ""
                check.TextColor3 = self.Window.Theme.Accent
                check.TextSize = 14
                check.Font = Enum.Font.GothamBold
                check.ZIndex = 8
                check.Parent = b

                b.MouseEnter:Connect(function()
                    if not selected[opt] then
                        tween(b, 0.12, {BackgroundTransparency = 0.4})
                    end
                end)
                b.MouseLeave:Connect(function()
                    if not selected[opt] then
                        tween(b, 0.12, {BackgroundTransparency = 0.65})
                    end
                end)
                b.MouseButton1Click:Connect(function()
                    selected[opt] = not selected[opt]
                    local now = selected[opt]
                    tween(b, 0.15, {
                        BackgroundColor3 = now and self.Window.Theme.Accent or self.Window.Theme.Card,
                        BackgroundTransparency = now and 0.3 or 0.65
                    })
                    check.Text = now and "✓" or ""
                    updateTitle()
                    if cfg.Flag then self.Window.Flags[cfg.Flag] = getSelectedList() end
                    if cfg.Callback then pcall(cfg.Callback, getSelectedList()) end
                end)
                optionButtons[opt] = b
            end
            
            updateDropdownHeight(#filteredOptions)
        end

        -- Search input handler
        searchInput:GetPropertyChangedSignal("Text"):Connect(function()
            buildOptions(searchInput.Text)
        end)

        local function getSelectedList()
            local t = {}
            for _, opt in ipairs(options) do
                if selected[opt] then table.insert(t, opt) end
            end
            return t
        end

        local function updateTitle()
            local sel = getSelectedList()
            if #sel == 0 then
                title.Text = cfg.Name or "Multi Select"
                title.TextColor3 = self.Window.Theme.Muted
            elseif #sel == 1 then
                title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. sel[1]
                title.TextColor3 = self.Window.Theme.Text
            else
                title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. #sel .. " selected"
                title.TextColor3 = self.Window.Theme.Text
            end
        end

        local function setOpen(state)
            isOpen = state
            if isOpen then
                buildOptions("")
                content.Visible = true
                content.Size = UDim2.new(1, -8, 0, 0)
                spring(content, 0.3, {Size = UDim2.new(1, -8, 0, 120)})
                tween(arrow, 0.2, {Rotation = 180})
                spring(frame, 0.3, {Size = UDim2.new(1, 0, 0, 38 + 8 + 120)})
                
                -- Focus search input
                task.wait(0.1)
                searchInput:CaptureFocus()
            else
                spring(frame, 0.26, {Size = UDim2.new(1, 0, 0, 38)})
                tween(arrow, 0.2, {Rotation = 0})
                tween(content, 0.22, {Size = UDim2.new(1, -8, 0, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
                task.delay(0.24, function()
                    if not isOpen then
                        content.Visible = false
                        content.Size = UDim2.new(1, -8, 0, 0)
                    end
                end)
            end
        end

        trigger.MouseButton1Click:Connect(function()
            setOpen(not isOpen)
        end)

        -- Close on focus loss
        searchInput.FocusLost:Connect(function()
            task.delay(0.15, function()
                if isOpen and not searchInput:IsFocused() then
                    setOpen(false)
                end
            end)
        end)

        local obj = {}
        function obj:SetOptions(newOptions)
            options = newOptions or {}
            for k in pairs(selected) do
                if not table.find(options, k) then selected[k] = nil end
            end
            updateTitle()
            if isOpen then buildOptions(searchInput.Text) end
        end
        function obj:Get() return getSelectedList() end
        function obj:Set(values)
            selected = {}
            if type(values) == "table" then
                for _, v in ipairs(values) do selected[v] = true end
            end
            updateTitle()
            if isOpen then buildOptions(searchInput.Text) end
            if cfg.Flag then self.Window.Flags[cfg.Flag] = getSelectedList() end
            if cfg.Callback then pcall(cfg.Callback, getSelectedList()) end
        end
        function obj:Clear()
            selected = {}
            updateTitle()
            if isOpen then buildOptions(searchInput.Text) end
            if cfg.Flag then self.Window.Flags[cfg.Flag] = {} end
            if cfg.Callback then pcall(cfg.Callback, {}) end
        end

        updateTitle()
        if cfg.Flag then self.Window.Flags[cfg.Flag] = getSelectedList() end
        return obj
    end

