        local track = Instance.new("Frame")
        track.Size = UDim2.fromOffset(36, 20)
        track.Position = UDim2.new(1, -46, 0.5, -10)
        track.BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Sidebar
        track.Parent = frame
        corner(track, 10)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(14, 14)
        knob.Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.Parent = track
        corner(knob, 7)

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 0)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = frame

        local obj = {}
        local function update(v)
            state = v
            tween(track, 0.2, {BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Sidebar})
            spring(knob, 0.25, {
                Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
            })
            if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
            if cfg.Callback then pcall(cfg.Callback, state) end
        end

        function obj:Set(v) update(v) end
        function obj:Get() return state end

        trigger.MouseButton1Click:Connect(function()
            update(not state)
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
        table.insert(self.Window.ToggleObjects, obj)
        return obj
    end

    -- SLIDER
    function tab:CreateSlider(cfg)
        cfg = cfg or {}
        local min = cfg.Range and cfg.Range[1] or 0
        local max = cfg.Range and cfg.Range[2] or 100
        local range = math.max(max - min, 1e-9)
        local increment = cfg.Increment or cfg.Step or (range <= 1 and 0.01 or range <= 10 and 0.1 or 1)

        local function snap(v)
            v = math.clamp(v, min, max)
            v = math.floor(v / increment + 0.5) * increment
            local decimals = math.max(0, math.ceil(-math.log10(increment)))
            local mult = 10 ^ decimals
            return math.floor(v * mult + 0.5) / mult
        end

        local val = snap(cfg.CurrentValue or min)

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 44)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.BackgroundTransparency = 0.2
        frame.Parent = view
        corner(frame, 7)
        stroke(frame, self.Window.Theme.Border, 1, 0.5)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.65, 0, 0, 16)
        title.Position = UDim2.new(0, 12, 0, 6)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Slider"
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 12
        title.Font = Enum.Font.Gotham
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0.35, -12, 0, 16)
        valLbl.Position = UDim2.new(0.65, 0, 0, 6)
        valLbl.BackgroundTransparency = 1
        valLbl.TextColor3 = self.Window.Theme.Accent
        valLbl.TextSize = 12
        valLbl.Font = Enum.Font.GothamBold
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.Parent = frame

        local function formatValue(v)
            if v == math.floor(v) then return tostring(math.floor(v)) end
            return string.format("%.4f", v):gsub("0+$", ""):gsub("%.$", "")
        end
        valLbl.Text = formatValue(val) .. (cfg.Suffix or "")

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -24, 0, 5)
        track.Position = UDim2.new(0, 12, 0, 28)
        track.BackgroundColor3 = self.Window.Theme.Sidebar
        track.Parent = frame
        corner(track, 3)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((val - min) / range, 0, 1, 0)
        fill.BackgroundColor3 = self.Window.Theme.Accent
        fill.Parent = track
        corner(fill, 3)

        local handle = Instance.new("Frame")
        handle.Size = UDim2.fromOffset(12, 12)
        handle.Position = UDim2.new((val - min) / range, -6, 0.5, -6)
        handle.BackgroundColor3 = Color3.new(1, 1, 1)
        handle.Parent = track
        corner(handle, 6)
        stroke(handle, self.Window.Theme.Accent, 1.4, 0.2)

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 14)
        trigger.Position = UDim2.new(0, 0, 0, -4)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = track

        local drag = false
        local function update(inp)
            local pct = math.clamp((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = snap(min + range * pct)
            valLbl.Text = formatValue(val) .. (cfg.Suffix or "")
            tween(fill, 0.06, {Size = UDim2.new((val - min) / range, 0, 1, 0)})
            tween(handle, 0.06, {Position = UDim2.new((val - min) / range, -6, 0.5, -6)})
            if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
            if cfg.Callback then pcall(cfg.Callback, val) end
        end

        trigger.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                drag = true
                update(inp)
                spring(handle, 0.16, {Size = UDim2.fromOffset(14, 14)})
            end
        end)
        UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                drag = false
                spring(handle, 0.16, {Size = UDim2.fromOffset(12, 12)})
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if drag and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                update(inp)
            end
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
    end

