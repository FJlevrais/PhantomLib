local function tween(obj, time, props, style, dir)
    style = style or Enum.EasingStyle.Quart
    dir = dir or Enum.EasingDirection.Out
    local t = TweenService:Create(obj, TweenInfo.new(time, style, dir), props)
    t:Play()
    return t
end

local function spring(obj, time, props)
    return tween(obj, time, props, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

local function getParent()
    local ok, gui = pcall(function() return CoreGui end)
    return (ok and gui) and gui or LP:WaitForChild("PlayerGui")
end

local function corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = parent
    return c
end

local function stroke(parent, col, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color = col
    s.Thickness = thick or 1
    s.Transparency = trans or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function padding(parent, t, r, b, l)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, t or 0)
    p.PaddingRight = UDim.new(0, r or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.PaddingLeft = UDim.new(0, l or 0)
    p.Parent = parent
    return p
end

-- ─────────────────────────────────────────────
-- NOTIFICATION SYSTEM
-- ─────────────────────────────────────────────
function PhantomLib:Notify(opts)
    opts = opts or {}
    local titleText = opts.Title or "Notification"
    local descText = opts.Description or opts.Text or ""
    local duration = opts.Duration or 3

    if not self.NotifContainer then return end

    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(1, 0, 0, 50)
    notif.BackgroundColor3 = self.Theme.Card
    notif.BackgroundTransparency = 1
    notif.Parent = self.NotifContainer
    corner(notif, 6)
    stroke(notif, self.Theme.Border, 1, 0)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 18)
    title.Position = UDim2.new(0, 10, 0, 6)
    title.BackgroundTransparency = 1
    title.Text = titleText
    title.TextColor3 = self.Theme.Text
    title.TextSize = 12
    title.Font = Enum.Font.GothamMedium
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = notif

    local desc = Instance.new("TextLabel")
    desc.Size = UDim2.new(1, -20, 0, 20)
    desc.Position = UDim2.new(0, 10, 0, 24)
    desc.BackgroundTransparency = 1
    desc.Text = descText
    desc.TextColor3 = self.Theme.Muted
    desc.TextSize = 11
    desc.Font = Enum.Font.Gotham
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = notif

    tween(notif, 0.25, {BackgroundTransparency = 0})

    task.delay(duration, function()
        tween(notif, 0.25, {BackgroundTransparency = 1})
        task.wait(0.25)
        notif:Destroy()
    end)
end

-- ─────────────────────────────────────────────
-- WINDOW CREATION
-- ─────────────────────────────────────────────
function PhantomLib:CreateWindow(opts)
    opts = opts or {}
    local name = opts.Name or opts.Title or "Phantom Window"
    local parent = getParent()
    local screenName = "PhantomLib_" .. name:gsub("%s+", "_")

    if getgenv()._PhantomLib_Instances[screenName] then
        pcall(function()
            getgenv()._PhantomLib_Instances[screenName]:DisableAllAndDestroy()
        end)
    else
        local old = parent:FindFirstChild(screenName)
        if old then old:Destroy() end
    end

    local self = setmetatable({}, PhantomLib)
    self.Theme = PhantomLib.Themes[opts.Theme] or PhantomLib.Themes.Default
    self.CurrentTheme = opts.Theme or "Default"
    self.Tabs = {}
    self.ActiveTab = nil
    self.Flags = {}
    self.ToggleObjects = {}
    self.Minimized = false
    getgenv()._PhantomLib_Instances[screenName] = self

    local screen = Instance.new("ScreenGui")
    screen.Name = screenName
    screen.ResetOnSpawn = false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.Parent = parent

    local notifHolder = Instance.new("Frame")
    notifHolder.Size = UDim2.new(0, 260, 1, -20)
    notifHolder.Position = UDim2.new(1, -16, 1, -16)
    notifHolder.AnchorPoint = Vector2.new(1, 1)
    notifHolder.BackgroundTransparency = 1
    notifHolder.Parent = screen

    local notifLayout = Instance.new("UIListLayout")
    notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    notifLayout.Padding = UDim.new(0, 8)
    notifLayout.Parent = notifHolder

    local size = opts.Size or UDim2.fromOffset(540, 320)

    local main = Instance.new("Frame")
    main.Name = "Main"
    main.Size = UDim2.fromOffset(0, 0)
    main.Position = UDim2.fromScale(0.5, 0.5)
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.BackgroundColor3 = self.Theme.Background
    main.BorderSizePixel = 0
    main.ClipsDescendants = false
    main.Parent = screen
    corner(main, 8)
    stroke(main, self.Theme.Border, 1, 0)

    spring(main, 0.4, {
        Size = size,
        Position = UDim2.new(0.5, -size.X.Offset / 2, 0.5, -size.Y.Offset / 2),
        AnchorPoint = Vector2.new(0, 0)
    })

    -- Header
    local header = Instance.new("Frame")
    header.Size = UDim2.new(1, 0, 0, 36)
    header.BackgroundColor3 = self.Theme.Sidebar
    header.BorderSizePixel = 0
    header.Parent = main
    corner(header, 8)

    local headerFill = Instance.new("Frame")
    headerFill.Size = UDim2.new(1, 0, 0, 10)
    headerFill.Position = UDim2.new(0, 0, 1, -10)
    headerFill.BackgroundColor3 = self.Theme.Sidebar
    headerFill.BorderSizePixel = 0
    headerFill.Parent = header

    local headerLine = Instance.new("Frame")
    headerLine.Size = UDim2.new(1, 0, 0, 1)
    headerLine.Position = UDim2.new(0, 0, 1, -1)
    headerLine.BackgroundColor3 = self.Theme.Border
    headerLine.BorderSizePixel = 0
    headerLine.Parent = header

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(0, 200, 1, 0)
    title.Position = UDim2.new(0, 14, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = name
    title.TextColor3 = self.Theme.Text
    title.TextSize = 13
    title.Font = Enum.Font.GothamMedium
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = header

    -- Stats Display
    local right = Instance.new("Frame")
    right.Size = UDim2.new(0, 180, 1, 0)
    right.Position = UDim2.new(1, -186, 0, 0)
    right.BackgroundTransparency = 1
    right.Parent = header

    local stats = Instance.new("Frame")
    stats.Size = UDim2.new(0, 100, 1, 0)
    stats.BackgroundTransparency = 1
    stats.Parent = right

    local fpsLbl = Instance.new("TextLabel")
    fpsLbl.Size = UDim2.new(0.5, -2, 1, 0)
    fpsLbl.BackgroundTransparency = 1
    fpsLbl.Text = "60 FPS"
    fpsLbl.TextColor3 = self.Theme.Muted
    fpsLbl.TextSize = 11
    fpsLbl.Font = Enum.Font.Gotham
    fpsLbl.TextXAlignment = Enum.TextXAlignment.Right
    fpsLbl.Parent = stats

    local pingLbl = Instance.new("TextLabel")
    pingLbl.Size = UDim2.new(0.5, -2, 1, 0)
    pingLbl.Position = UDim2.new(0.5, 2, 0, 0)
    pingLbl.BackgroundTransparency = 1
    pingLbl.Text = "20 ms"
    pingLbl.TextColor3 = self.Theme.Muted
    pingLbl.TextSize = 11
    pingLbl.Font = Enum.Font.Gotham
    pingLbl.TextXAlignment = Enum.TextXAlignment.Left
    pingLbl.Parent = stats

    local last = 0
    RunService.RenderStepped:Connect(function(dt)
        local fps = math.floor(1 / math.max(dt, 0.001))
        if tick() - last > 0.5 then
            last = tick()
            fpsLbl.Text = fps .. " FPS"
            local ping = 0
            pcall(function() ping = math.floor(LP:GetNetworkPing() * 1000) end)
            pingLbl.Text = ping .. " ms"
        end
    end)

    -- Window Controls
    local controls = Instance.new("Frame")
    controls.Size = UDim2.new(0, 70, 1, 0)
    controls.Position = UDim2.new(1, -74, 0, 0)
    controls.BackgroundTransparency = 1
    controls.Parent = right

    local function makeBtn(txt, x)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(22, 22)
        b.Position = UDim2.new(0, x, 0.5, -11)
        b.BackgroundTransparency = 1
        b.Text = txt
        b.TextColor3 = self.Theme.Muted
        b.TextSize = 12
        b.Font = Enum.Font.GothamMedium
        b.AutoButtonColor = false
        b.Parent = controls
        corner(b, 4)
        b.MouseEnter:Connect(function()
            tween(b, 0.12, {TextColor3 = self.Theme.Text, BackgroundTransparency = 0.8, BackgroundColor3 = self.Theme.Text})
        end)
        b.MouseLeave:Connect(function()
            tween(b, 0.12, {TextColor3 = self.Theme.Muted, BackgroundTransparency = 1})
        end)
        return b
    end

    local minBtn = makeBtn("—", 18)
    local closeBtn = makeBtn("✕", 42)

    minBtn.MouseButton1Click:Connect(function()
        self.Minimized = not self.Minimized
        tween(main, 0.25, {Size = self.Minimized and UDim2.new(size.X.Scale, size.X.Offset, 0, 36) or size})
    end)

    closeBtn.MouseButton1Click:Connect(function()
        self:DisableAllAndDestroy()
    end)

    -- Window Dragging
    local dragging, start, startPos
    header.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            start = inp.Position
            startPos = main.Position
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            local d = inp.Position - start
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Sidebar Layout
    local sidebar = Instance.new("ScrollingFrame")
    sidebar.Size = UDim2.new(0, 130, 1, -36)
    sidebar.Position = UDim2.new(0, 0, 0, 36)
    sidebar.BackgroundColor3 = self.Theme.Sidebar
    sidebar.BorderSizePixel = 0
    sidebar.ScrollBarThickness = 0
    sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
    sidebar.Parent = main

    local sLayout = Instance.new("UIListLayout")
    sLayout.Padding = UDim.new(0, 2)
    sLayout.Parent = sidebar
    padding(sidebar, 8, 6, 8, 6)

    sLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        sidebar.CanvasSize = UDim2.new(0, 0, 0, sLayout.AbsoluteContentSize.Y + 12)
    end)

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -130, 1, -36)
    container.Position = UDim2.new(0, 130, 0, 36)
    container.BackgroundTransparency = 1
    container.ClipsDescendants = true
    container.Parent = main

    self.ScreenName = screenName
    self.Screen = screen
    self.Main = main
    self.NotifContainer = notifHolder
    self.Container = container
    self.Sidebar = sidebar

    return self
end

