function PhantomLib:Notify(cfg)
    cfg = cfg or {}
    local toast = Instance.new("Frame", self.NotifContainer)
    toast.Size = UDim2.new(1, 0, 0, 52)
    toast.BackgroundColor3 = self.Theme.Sidebar
    toast.BackgroundTransparency = 1
    Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 8)
    
    local stroke = Instance.new("UIStroke", toast)
    stroke.Color = self.Theme.Accent; stroke.Transparency = 1

    local title = Instance.new("TextLabel", toast)
    title.Size = UDim2.new(1, -20, 0, 18); title.Position = UDim2.new(0, 10, 0, 6)
    title.BackgroundTransparency = 1; title.Text = cfg.Title or "Notice"; title.TextColor3 = self.Theme.Text
    title.TextSize = 13; title.Font = Enum.Font.GothamBold; title.TextXAlignment = Enum.TextXAlignment.Left; title.TextTransparency = 1

    local desc = Instance.new("TextLabel", toast)
    desc.Size = UDim2.new(1, -20, 0, 18); desc.Position = UDim2.new(0, 10, 0, 24)
    desc.BackgroundTransparency = 1; desc.Text = cfg.Content or ""; desc.TextColor3 = self.Theme.Muted
    desc.TextSize = 12; desc.Font = Enum.Font.Gotham; desc.TextXAlignment = Enum.TextXAlignment.Left; desc.TextTransparency = 1

    smoothTween(toast, 0.25, {BackgroundTransparency = 0})
    smoothTween(stroke, 0.25, {Transparency = 0})
    smoothTween(title, 0.25, {TextTransparency = 0})
    smoothTween(desc, 0.25, {TextTransparency = 0})

    task.delay(cfg.Duration or 3, function()
        smoothTween(toast, 0.25, {BackgroundTransparency = 1})
        smoothTween(stroke, 0.25, {Transparency = 1})
        smoothTween(title, 0.25, {TextTransparency = 1})
        smoothTween(desc, 0.25, {TextTransparency = 1})
        task.wait(0.25)
        toast:Destroy()
    end)
end

function PhantomLib:CreateTab(tabName)
    local tabData = { Name = tabName, Window = self }

    local btn = Instance.new("TextButton", self.Sidebar)
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = self.Theme.Card
    btn.BackgroundTransparency = 1
    btn.Text = tabName; btn.TextColor3 = self.Theme.Muted; btn.TextSize = 13; btn.Font = Enum.Font.GothamMedium
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local view = Instance.new("ScrollingFrame", self.Container)
    view.Size = UDim2.new(1, 0, 1, 0)
    view.BackgroundTransparency = 1; view.Visible = false
    view.ScrollBarThickness = 2; view.BorderSizePixel = 0

    local layout = Instance.new("UIListLayout", view)
    layout.Padding = UDim.new(0, 6)
    local pad = Instance.new("UIPadding", view)
    pad.PaddingTop = UDim.new(0, 8); pad.PaddingLeft = UDim.new(0, 8); pad.PaddingRight = UDim.new(0, 8); pad.PaddingBottom = UDim.new(0, 8)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        view.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 16)
    end)

    tabData.Button = btn; tabData.View = view

    local function selectTab()
        for _, tab in ipairs(self.Tabs) do
            tab.View.Visible = false
            smoothTween(tab.Button, 0.2, {BackgroundTransparency = 1, TextColor3 = self.Theme.Muted})
        end
        view.Visible = true
        smoothTween(btn, 0.2, {BackgroundTransparency = 0, TextColor3 = self.Theme.Text})
        self.ActiveTab = tabData
    end

    btn.MouseButton1Click:Connect(selectTab)
    if #self.Tabs == 0 then selectTab() end
    table.insert(self.Tabs, tabData)

    local function triggerAutoSave()
        if self.AutoSaveEnabled then self:SaveConfig() end
    end

    -- Button Element
    function tabData:CreateButton(cfg)
        cfg = cfg or {}
        local b = Instance.new("TextButton", view)
        b.Size = UDim2.new(1, 0, 0, 36)
        b.BackgroundColor3 = self.Window.Theme.Card
        b.Text = cfg.Name or "Button"; b.TextColor3 = self.Window.Theme.Text; b.TextSize = 13; b.Font = Enum.Font.GothamMedium
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

        b.MouseButton1Click:Connect(function()
            springTween(b, 0.15, {Size = UDim2.new(1, -4, 0, 34)})
            task.wait(0.1)
            springTween(b, 0.15, {Size = UDim2.new(1, 0, 0, 36)})
            if cfg.Callback then pcall(cfg.Callback) end
        end)
    end

    -- Toggle Element
    function tabData:CreateToggle(cfg)
        cfg = cfg or {}
        local state = cfg.CurrentValue or false

        local frame = Instance.new("Frame", view)
        frame.Size = UDim2.new(1, 0, 0, 38)
        frame.BackgroundColor3 = self.Window.Theme.Card
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local label = Instance.new("TextLabel", frame)
        label.Size = UDim2.new(1, -50, 1, 0); label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1; label.Text = cfg.Name or "Toggle"
        label.TextColor3 = self.Window.Theme.Text; label.TextSize = 13; label.Font = Enum.Font.Gotham; label.TextXAlignment = Enum.TextXAlignment.Left

        local track = Instance.new("Frame", frame)
        track.Size = UDim2.fromOffset(36, 18); track.Position = UDim2.new(1, -44, 0.5, -9)
        track.BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Border
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame", track)
        knob.Size = UDim2.fromOffset(12, 12)
        knob.Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
        knob.BackgroundColor3 = self.Window.Theme.Text
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local trigger = Instance.new("TextButton", frame)
        trigger.Size = UDim2.new(1, 0, 1, 0); trigger.BackgroundTransparency = 1; trigger.Text = ""

        trigger.MouseButton1Click:Connect(function()
            state = not state
            smoothTween(track, 0.2, {BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Border})
            springTween(knob, 0.25, {Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)})
            if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
            if cfg.Callback then pcall(cfg.Callback, state) end
            triggerAutoSave()
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
    end

    -- Slider Element
    function tabData:CreateSlider(cfg)
        cfg = cfg or {}
        local min = cfg.Range and cfg.Range[1] or 0
        local max = cfg.Range and cfg.Range[2] or 100
        local val = math.clamp(cfg.CurrentValue or min, min, max)

        local frame = Instance.new("Frame", view)
        frame.Size = UDim2.new(1, 0, 0, 50)
        frame.BackgroundColor3 = self.Window.Theme.Card
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local title = Instance.new("TextLabel", frame)
        title.Size = UDim2.new(1, -20, 0, 20); title.Position = UDim2.new(0, 10, 0, 5)
        title.BackgroundTransparency = 1; title.Text = cfg.Name or "Slider"; title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 13; title.Font = Enum.Font.Gotham; title.TextXAlignment = Enum.TextXAlignment.Left

        local valDisplay = Instance.new("TextLabel", frame)
        valDisplay.Size = UDim2.new(1, -20, 0, 20); valDisplay.Position = UDim2.new(0, 10, 0, 5)
        valDisplay.BackgroundTransparency = 1; valDisplay.Text = tostring(val) .. (cfg.Suffix or ""); valDisplay.TextColor3 = self.Window.Theme.Accent
        valDisplay.TextSize = 13; valDisplay.Font = Enum.Font.GothamBold; valDisplay.TextXAlignment = Enum.TextXAlignment.Right

        local track = Instance.new("Frame", frame)
        track.Size = UDim2.new(1, -20, 0, 6); track.Position = UDim2.new(0, 10, 0, 32)
        track.BackgroundColor3 = self.Window.Theme.Sidebar
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", track)
        fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = self.Window.Theme.Accent
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local trigger = Instance.new("TextButton", track)
        trigger.Size = UDim2.new(1, 0, 1, 10); trigger.Position = UDim2.new(0, 0, 0, -5)
        trigger.BackgroundTransparency = 1; trigger.Text = ""

        local dragging = false
        local function update(input)
            local percent = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = math.floor(min + ((max - min) * percent))
            valDisplay.Text = tostring(val) .. (cfg.Suffix or "")
            smoothTween(fill, 0.05, {Size = UDim2.new(percent, 0, 1, 0)})
            if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
            if cfg.Callback then pcall(cfg.Callback, val) end
        end

        trigger.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; update(input) end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
                if dragging then dragging = false; triggerAutoSave() end
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
    end

    -- Keybind Element
    function tabData:CreateKeybind(cfg)
        cfg = cfg or {}
        local currentKey = cfg.Default or Enum.KeyCode.E
        local listening = false

        local frame = Instance.new("Frame", view)
        frame.Size = UDim2.new(1, 0, 0, 42); frame.BackgroundColor3 = self.Window.Theme.Card
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local label = Instance.new("TextLabel", frame)
        label.Size = UDim2.new(0.6, 0, 1, 0); label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1; label.Text = cfg.Name or "Keybind"
        label.TextColor3 = self.Window.Theme.Text; label.TextSize = 13; label.Font = Enum.Font.Gotham; label.TextXAlignment = Enum.TextXAlignment.Left

        local bindBtn = Instance.new("TextButton", frame)
        bindBtn.Size = UDim2.new(0, 80, 0, 26); bindBtn.Position = UDim2.new(1, -90, 0.5, -13)
        bindBtn.BackgroundColor3 = self.Window.Theme.Sidebar
        bindBtn.Text = currentKey.Name; bindBtn.TextColor3 = self.Window.Theme.Accent
        bindBtn.TextSize = 12; bindBtn.Font = Enum.Font.GothamBold
        Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0, 4)

        bindBtn.MouseButton1Click:Connect(function()
            listening = true
            bindBtn.Text = "..."
            bindBtn.TextColor3 = self.Window.Theme.Yellow
        end)

        UserInputService.InputBegan:Connect(function(input, gpe)
            if listening and not gpe then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = input.KeyCode
                    listening = false
                    bindBtn.Text = currentKey.Name
                    bindBtn.TextColor3 = self.Window.Theme.Accent
                    if cfg.Flag then self.Window.Flags[cfg.Flag] = currentKey end
                    if cfg.Callback then pcall(cfg.Callback, currentKey) end
                    triggerAutoSave()
                end
            elseif not gpe and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey then
                if cfg.OnPressed then pcall(cfg.OnPressed) end
            end
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = currentKey end
    end

    -- Dropdown Element
    function tabData:CreateDropdown(cfg)
        cfg = cfg or {}
        local options = cfg.Options or {}
        local isMulti = cfg.MultiSelect or false
        local selected = isMulti and (cfg.Default or {}) or (cfg.Default or options[1] or "None")
        local expanded = false

        local frame = Instance.new("Frame", view)
        frame.Size = UDim2.new(1, 0, 0, 44); frame.BackgroundColor3 = self.Window.Theme.Card
        frame.ClipsDescendants = true
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local label = Instance.new("TextLabel", frame)
        label.Size = UDim2.new(0.5, 0, 0, 44); label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1; label.Text = cfg.Name or "Dropdown"
        label.TextColor3 = self.Window.Theme.Text; label.TextSize = 13; label.Font = Enum.Font.Gotham; label.TextXAlignment = Enum.TextXAlignment.Left

        local mainBtn = Instance.new("TextButton", frame)
        mainBtn.Size = UDim2.new(0.5, -10, 0, 28); mainBtn.Position = UDim2.new(0.5, 0, 0, 8)
        mainBtn.BackgroundColor3 = self.Window.Theme.Sidebar
        mainBtn.TextColor3 = self.Window.Theme.Muted; mainBtn.TextSize = 11; mainBtn.Font = Enum.Font.Gotham
        Instance.new("UICorner", mainBtn).CornerRadius = UDim.new(0, 4)

        local listHolder = Instance.new("Frame", frame)
        listHolder.Size = UDim2.new(1, -20, 0, #options * 26)
        listHolder.Position = UDim2.new(0, 10, 0, 44)
        listHolder.BackgroundTransparency = 1

        local listLayout = Instance.new("UIListLayout", listHolder)
        listLayout.Padding = UDim.new(0, 2)

        local function formatText()
            if isMulti then
                local keys = {}
                for item, active in pairs(selected) do
                    if active then table.insert(keys, item) end
                end
                return #keys > 0 and table.concat(keys, ", ") or "Select..."
            else
                return tostring(selected)
            end
        end

        mainBtn.Text = formatText()

        local function buildOptions()
            for _, child in ipairs(listHolder:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            for _, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton", listHolder)
                optBtn.Size = UDim2.new(1, 0, 0, 24)
                optBtn.BackgroundColor3 = self.Window.Theme.Background
                optBtn.Text = opt; optBtn.TextSize = 11; optBtn.Font = Enum.Font.Gotham
                optBtn.TextColor3 = (isMulti and selected[opt]) or (not isMulti and selected == opt) and self.Window.Theme.Accent or self.Window.Theme.Muted
                Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 4)

                optBtn.MouseButton1Click:Connect(function()
                    if isMulti then
                        selected[opt] = not selected[opt]
                    else
                        selected = opt
                        expanded = false
                        springTween(frame, 0.25, {Size = UDim2.new(1, 0, 0, 44)})
                    end
                    mainBtn.Text = formatText()
                    buildOptions()
                    if cfg.Flag then self.Window.Flags[cfg.Flag] = selected end
                    if cfg.Callback then pcall(cfg.Callback, selected) end
                    triggerAutoSave()
                end)
            end
        end

        buildOptions()

        mainBtn.MouseButton1Click:Connect(function()
            expanded = not expanded
            springTween(frame, 0.25, {Size = UDim2.new(1, 0, 0, expanded and (48 + #options * 26) or 44)})
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = selected end
    end

    return tabData
end

function PhantomLib:Destroy()
    if self.StatsConnection then self.StatsConnection:Disconnect() end

    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 16
                if hum.UseJumpPower then hum.JumpPower = 50 else hum.JumpHeight = 7.2 end
            end
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                local h = plr.Character:FindFirstChild("PhantomESP")
                if h then h:Destroy() end
            end
        end

        Workspace.CurrentCamera.FieldOfView = 70
    end)

    if self.Screen then self.Screen:Destroy() end
end

return PhantomLib
