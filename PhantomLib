local function tween(object, duration, properties)
    local anim = TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties)
    anim:Play()
    return anim
end

local function getGuiParent()
    local success, target = pcall(function() return CoreGui end)
    return (success and target) and target or LocalPlayer:WaitForChild("PlayerGui")
end

function PhantomLib:CreateWindow(options)
    options = options or {}
    local windowName = options.Name or "Phantom Window"
    local guiParent = getGuiParent()
    local screenName = "PhantomLib_" .. windowName:gsub("%s+", "_")

    if getgenv()._PhantomLib_Instances[screenName] then
        pcall(function()
            getgenv()._PhantomLib_Instances[screenName]:DisableAllAndDestroy()
        end)
    else
        local existingGui = guiParent:FindFirstChild(screenName)
        if existingGui then existingGui:Destroy() end
    end

    local self = setmetatable({}, PhantomLib)
    self.Theme = PhantomLib.Themes[options.Theme] or PhantomLib.Themes.Default
    self.Tabs = {}
    self.ActiveTab = nil
    self.Flags = {}
    self.ToggleObjects = {}
    self.Minimized = false

    getgenv()._PhantomLib_Instances[screenName] = self

    local screen = Instance.new("ScreenGui")
    screen.Name = screenName
    screen.ResetOnSpawn = false
    screen.Parent = guiParent

    local notifContainer = Instance.new("Frame", screen)
    notifContainer.Size = UDim2.new(0, 200, 1, -20)
    notifContainer.Position = UDim2.new(1, -15, 1, -15)
    notifContainer.AnchorPoint = Vector2.new(1, 1)
    notifContainer.BackgroundTransparency = 1
    
    local notifLayout = Instance.new("UIListLayout", notifContainer)
    notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    notifLayout.Padding = UDim.new(0, 6)

    local targetSize = options.Size or UDim2.fromOffset(450, 260)
    local main = Instance.new("Frame", screen)
    main.Size = targetSize
    main.Position = UDim2.new(0.5, -targetSize.X.Offset / 2, 0.5, -targetSize.Y.Offset / 2)
    main.BackgroundColor3 = self.Theme.Background
    main.BorderSizePixel = 0
    main.ClipsDescendants = true
    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 7)
    
    local stroke = Instance.new("UIStroke", main)
    stroke.Color = self.Theme.Border

    -- Header / Topbar
    local header = Instance.new("Frame", main)
    header.Size = UDim2.new(1, 0, 0, 28)
    header.BackgroundColor3 = self.Theme.Sidebar
    header.BorderSizePixel = 0
    
    Instance.new("UICorner", header).CornerRadius = UDim.new(0, 7)

    local headerFill = Instance.new("Frame", header)
    headerFill.Size = UDim2.new(1, 0, 0, 10)
    headerFill.Position = UDim2.new(0, 0, 1, -10)
    headerFill.BackgroundColor3 = self.Theme.Sidebar
    headerFill.BorderSizePixel = 0
    headerFill.ZIndex = 1

    local headerGradient = Instance.new("UIGradient", header)
    headerGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, self.Theme.Sidebar),
        ColorSequenceKeypoint.new(1, self.Theme.Card)
    })

    local title = Instance.new("TextLabel", header)
    title.Size = UDim2.new(1, -70, 1, 0)
    title.Position = UDim2.new(0, 10, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = windowName
    title.TextColor3 = self.Theme.Text
    title.TextSize = 12
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.ZIndex = 2

    local controls = Instance.new("Frame", header)
    controls.Size = UDim2.new(0, 45, 1, 0)
    controls.Position = UDim2.new(1, -48, 0, 0)
    controls.BackgroundTransparency = 1
    controls.ZIndex = 2

    local minimizeBtn = Instance.new("TextButton", controls)
    minimizeBtn.Size = UDim2.new(0, 18, 0, 18)
    minimizeBtn.Position = UDim2.new(0, 0, 0.5, -9)
    minimizeBtn.BackgroundColor3 = self.Theme.Card
    minimizeBtn.BackgroundTransparency = 1
    minimizeBtn.Text = "-"
    minimizeBtn.TextColor3 = self.Theme.Text
    minimizeBtn.TextSize = 12
    minimizeBtn.Font = Enum.Font.GothamBold
    minimizeBtn.ZIndex = 3
    Instance.new("UICorner", minimizeBtn).CornerRadius = UDim.new(0, 4)

    local closeBtn = Instance.new("TextButton", controls)
    closeBtn.Size = UDim2.new(0, 18, 0, 18)
    closeBtn.Position = UDim2.new(0, 22, 0.5, -9)
    closeBtn.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "×"
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.TextSize = 13
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.ZIndex = 3
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 4)

    minimizeBtn.MouseButton1Click:Connect(function()
        self.Minimized = not self.Minimized
        if self.Minimized then
            tween(main, 0.2, { Size = UDim2.new(targetSize.X.Scale, targetSize.X.Offset, 0, 28) })
        else
            tween(main, 0.2, { Size = targetSize })
        end
    end)

    closeBtn.MouseButton1Click:Connect(function()
        self:DisableAllAndDestroy()
    end)

    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)

    -- Sidebar / Tab Container
    local sidebar = Instance.new("ScrollingFrame", main)
    sidebar.Size = UDim2.new(0, 115, 1, -28)
    sidebar.Position = UDim2.new(0, 0, 0, 28)
    sidebar.BackgroundColor3 = self.Theme.Sidebar
    sidebar.BorderSizePixel = 0
    sidebar.ScrollBarThickness = 2
    sidebar.ScrollBarImageColor3 = self.Theme.Muted
    
    -- Rounded corner for top-left and bottom-left of sidebar
    Instance.new("UICorner", sidebar).CornerRadius = UDim.new(0, 7)

    -- Fill overlay to keep the right edge of the sidebar straight against the content view
    local sidebarFill = Instance.new("Frame", sidebar)
    sidebarFill.Size = UDim2.new(0, 10, 1, 0)
    sidebarFill.Position = UDim2.new(1, -10, 0, 0)
    sidebarFill.BackgroundColor3 = self.Theme.Sidebar
    sidebarFill.BorderSizePixel = 0
    sidebarFill.ZIndex = 0

    local sidebarLayout = Instance.new("UIListLayout", sidebar)
    sidebarLayout.Padding = UDim.new(0, 3)
    sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local sidebarPad = Instance.new("UIPadding", sidebar)
    sidebarPad.PaddingTop = UDim.new(0, 5); sidebarPad.PaddingLeft = UDim.new(0, 4); sidebarPad.PaddingRight = UDim.new(0, 4); sidebarPad.PaddingBottom = UDim.new(0, 5)

    sidebarLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        sidebar.CanvasSize = UDim2.new(0, 0, 0, sidebarLayout.AbsoluteContentSize.Y + 10)
    end)

    local container = Instance.new("Frame", main)
    container.Size = UDim2.new(1, -115, 1, -28)
    container.Position = UDim2.new(0, 115, 0, 28)
    container.BackgroundTransparency = 1

    self.ScreenName = screenName
    self.Screen = screen
    self.Main = main
    self.NotifContainer = notifContainer
    self.Container = container
    self.Sidebar = sidebar

    self:Notify({
        Title = "PhantomLib",
        Content = "Interface Loaded Successfully!",
        Duration = 3
    })

    return self
end

function PhantomLib:Notify(cfg)
    cfg = cfg or {}
    local toast = Instance.new("Frame", self.NotifContainer)
    toast.Size = UDim2.new(1, 0, 0, 42)
    toast.BackgroundColor3 = self.Theme.Card
    toast.BackgroundTransparency = 1
    Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 5)
    
    local stroke = Instance.new("UIStroke", toast)
    stroke.Color = self.Theme.Accent; stroke.Transparency = 1

    local title = Instance.new("TextLabel", toast)
    title.Size = UDim2.new(1, -12, 0, 14); title.Position = UDim2.new(0, 6, 0, 4)
    title.BackgroundTransparency = 1; title.Text = cfg.Title or "Notification"; title.TextColor3 = self.Theme.Text
    title.TextSize = 11; title.Font = Enum.Font.GothamBold; title.TextXAlignment = Enum.TextXAlignment.Left; title.TextTransparency = 1

    local desc = Instance.new("TextLabel", toast)
    desc.Size = UDim2.new(1, -12, 0, 14); desc.Position = UDim2.new(0, 6, 0, 20)
    desc.BackgroundTransparency = 1; desc.Text = cfg.Content or ""; desc.TextColor3 = self.Theme.Muted
    desc.TextSize = 10; desc.Font = Enum.Font.Gotham; desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.TextTransparency = 1

    tween(toast, 0.2, {BackgroundTransparency = 0})
    tween(stroke, 0.2, {Transparency = 0})
    tween(title, 0.2, {TextTransparency = 0})
    tween(desc, 0.2, {TextTransparency = 0})

    task.delay(cfg.Duration or 3, function()
        if toast and toast.Parent then
            tween(toast, 0.2, {BackgroundTransparency = 1})
            tween(stroke, 0.2, {Transparency = 1})
            tween(title, 0.2, {TextTransparency = 1})
            tween(desc, 0.2, {TextTransparency = 1})
            task.wait(0.2)
            if toast then toast:Destroy() end
        end
    end)
end

function PhantomLib:Rejoin()
    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
end

function PhantomLib:ServerHop()
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then return end

    local placeId = game.PlaceId
    local serversApi = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/0?sortOrder=Asc&limit=100"
    local res = req({ Url = serversApi, Method = "GET" })

    if res and res.StatusCode == 200 then
        local body = HttpService:JSONDecode(res.Body)
        if body and body.data then
            local validServers = {}
            for _, s in ipairs(body.data) do
                if type(s) == "table" and s.id ~= game.JobId and s.playing < s.maxPlayers then
                    table.insert(validServers, s.id)
                end
            end
            if #validServers > 0 then
                local chosenId = validServers[math.random(1, #validServers)]
                TeleportService:TeleportToPlaceInstance(placeId, chosenId, LocalPlayer)
            end
        end
    end
end

function PhantomLib:JoinSmallServer()
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then return end

    local placeId = game.PlaceId
    local cursor = ""
    local targetServerId = nil
    local minPlayers = math.huge

    for page = 1, 5 do
        local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/0?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
        local res = req({ Url = url, Method = "GET" })
        if res and res.StatusCode == 200 then
            local body = HttpService:JSONDecode(res.Body)
            if body and body.data then
                for _, s in ipairs(body.data) do
                    if type(s) == "table" and s.id ~= game.JobId and s.playing < s.maxPlayers then
                        if s.playing < minPlayers then
                            minPlayers = s.playing
                            targetServerId = s.id
                        end
                    end
                end
            end
            cursor = body.nextPageCursor or ""
            if not cursor or cursor == "" then break end
        else
            break
        end
    end

    if targetServerId then
        TeleportService:TeleportToPlaceInstance(placeId, targetServerId, LocalPlayer)
    end
end

function PhantomLib:CreateTab(tabName)
    local tabData = { Name = tabName, Window = self }

    local btn = Instance.new("TextButton", self.Sidebar)
    btn.Size = UDim2.new(1, 0, 0, 24)
    btn.BackgroundColor3 = self.Theme.Card
    btn.BackgroundTransparency = 1
    btn.Text = tabName; btn.TextColor3 = self.Theme.Muted; btn.TextSize = 11; btn.Font = Enum.Font.GothamMedium
    btn.ZIndex = 2
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    local view = Instance.new("ScrollingFrame", self.Container)
    view.Size = UDim2.new(1, 0, 1, 0)
    view.BackgroundTransparency = 1; view.Visible = false
    view.ScrollBarThickness = 3
    view.ScrollBarImageColor3 = self.Theme.Accent
    view.BorderSizePixel = 0
    view.ClipsDescendants = true

    local layout = Instance.new("UIListLayout", view)
    layout.Padding = UDim.new(0, 4)
    local pad = Instance.new("UIPadding", view)
    pad.PaddingTop = UDim.new(0, 5); pad.PaddingLeft = UDim.new(0, 5); pad.PaddingRight = UDim.new(0, 6); pad.PaddingBottom = UDim.new(0, 5)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        view.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)

    tabData.Button = btn; tabData.View = view

    local function selectTab()
        for _, tab in ipairs(self.Tabs) do
            tab.View.Visible = false
            tween(tab.Button, 0.15, {BackgroundTransparency = 1, TextColor3 = self.Theme.Muted})
        end
        view.Visible = true
        tween(btn, 0.15, {BackgroundTransparency = 1, TextColor3 = self.Theme.Text})
        self.ActiveTab = tabData
    end

    btn.MouseButton1Click:Connect(selectTab)
    if #self.Tabs == 0 then selectTab() end
    table.insert(self.Tabs, tabData)

    -- Button Element
    function tabData:CreateButton(cfg)
        cfg = cfg or {}
        local b = Instance.new("TextButton", view)
        b.Size = UDim2.new(1, 0, 0, 28)
        b.BackgroundColor3 = self.Window.Theme.ButtonGradTop
        b.BackgroundTransparency = 1
        b.Text = cfg.Name or "Button"
        b.TextColor3 = self.Window.Theme.Accent
        b.TextSize = 11
        b.Font = Enum.Font.GothamBold
        b.AutoButtonColor = false
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
        
        local stroke = Instance.new("UIStroke", b)
        stroke.Color = self.Window.Theme.Accent
        stroke.Thickness = 1
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

        b.MouseEnter:Connect(function()
            tween(stroke, 0.15, { Color = self.Window.Theme.GradientAccent })
            tween(b, 0.15, { TextColor3 = self.Window.Theme.Text })
        end)

        b.MouseLeave:Connect(function()
            tween(stroke, 0.15, { Color = self.Window.Theme.Accent })
            tween(b, 0.15, { TextColor3 = self.Window.Theme.Accent })
        end)

        b.MouseButton1Click:Connect(function()
            if cfg.Callback then pcall(cfg.Callback) end
        end)
    end

    -- Toggle Element
    function tabData:CreateToggle(cfg)
        cfg = cfg or {}
        local state = cfg.CurrentValue or false

        local frame = Instance.new("Frame", view)
        frame.Size = UDim2.new(1, 0, 0, 26)
        frame.BackgroundColor3 = self.Window.Theme.Card
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)

        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = self.Window.Theme.Border

        local label = Instance.new("TextLabel", frame)
        label.Size = UDim2.new(1, -40, 1, 0); label.Position = UDim2.new(0, 6, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = cfg.Name or "Toggle"
        label.TextColor3 = self.Window.Theme.Text; label.TextSize = 11; label.Font = Enum.Font.Gotham; label.TextXAlignment = Enum.TextXAlignment.Left

        local track = Instance.new("Frame", frame)
        track.Size = UDim2.fromOffset(26, 14); track.Position = UDim2.new(1, -32, 0.5, -7)
        track.BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Sidebar
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame", track)
        knob.Size = UDim2.fromOffset(10, 10)
        knob.Position = state and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
        knob.BackgroundColor3 = self.Window.Theme.Text
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local trigger = Instance.new("TextButton", frame)
        trigger.Size = UDim2.new(1, 0, 1, 0); trigger.BackgroundTransparency = 1; trigger.Text = ""

        local toggleObj = {}

        local function update(newState)
            state = newState
            tween(track, 0.15, {BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Sidebar})
            tween(knob, 0.15, {Position = state and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)})
            if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
            if cfg.Callback then pcall(cfg.Callback, state) end
        end

        function toggleObj:Set(val)
            update(val)
        end

        function toggleObj:Get()
            return state
        end

        trigger.MouseButton1Click:Connect(function()
            update(not state)
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
        table.insert(self.Window.ToggleObjects, toggleObj)

        return toggleObj
    end

    -- Slider Element
    function tabData:CreateSlider(cfg)
        cfg = cfg or {}
        local min = cfg.Range and cfg.Range[1] or 0
        local max = cfg.Range and cfg.Range[2] or 100
        local val = math.clamp(cfg.CurrentValue or min, min, max)

        local frame = Instance.new("Frame", view)
        frame.Size = UDim2.new(1, 0, 0, 36)
        frame.BackgroundColor3 = self.Window.Theme.Card
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)

        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = self.Window.Theme.Border

        local title = Instance.new("TextLabel", frame)
        title.Size = UDim2.new(1, -12, 0, 14); title.Position = UDim2.new(0, 6, 0, 3)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Slider"; title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 11; title.Font = Enum.Font.Gotham; title.TextXAlignment = Enum.TextXAlignment.Left

        local valDisplay = Instance.new("TextLabel", frame)
        valDisplay.Size = UDim2.new(1, -12, 0, 14); valDisplay.Position = UDim2.new(0, 6, 0, 3)
        valDisplay.BackgroundTransparency = 1
        valDisplay.Text = tostring(val) .. (cfg.Suffix or ""); valDisplay.TextColor3 = self.Window.Theme.Accent
        valDisplay.TextSize = 11; valDisplay.Font = Enum.Font.GothamBold; valDisplay.TextXAlignment = Enum.TextXAlignment.Right

        local track = Instance.new("Frame", frame)
        track.Size = UDim2.new(1, -12, 0, 4); track.Position = UDim2.new(0, 6, 0, 22)
        track.BackgroundColor3 = self.Window.Theme.Sidebar
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", track)
        fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = self.Window.Theme.Accent
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local trigger = Instance.new("TextButton", track)
        trigger.Size = UDim2.new(1, 0, 1, 8); trigger.Position = UDim2.new(0, 0, 0, -4)
        trigger.BackgroundTransparency = 1; trigger.Text = ""

        local dragging = false
        local function update(input)
            local percent = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = math.floor(min + ((max - min) * percent))
            valDisplay.Text = tostring(val) .. (cfg.Suffix or "")
            tween(fill, 0.05, {Size = UDim2.new(percent, 0, 1, 0)})
            if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
            if cfg.Callback then pcall(cfg.Callback, val) end
        end

        trigger.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; update(input) end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
    end

    -- Input Textbox Element
    function tabData:CreateInput(cfg)
        cfg = cfg or {}
        local frame = Instance.new("Frame", view)
        frame.Size = UDim2.new(1, 0, 0, 28); frame.BackgroundColor3 = self.Window.Theme.Card
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)

        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = self.Window.Theme.Border

        local label = Instance.new("TextLabel", frame)
        label.Size = UDim2.new(0.45, 0, 1, 0); label.Position = UDim2.new(0, 6, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = cfg.Name or "Input"; label.TextColor3 = self.Window.Theme.Text
        label.TextSize = 11; label.Font = Enum.Font.Gotham; label.TextXAlignment = Enum.TextXAlignment.Left

        local boxBg = Instance.new("Frame", frame)
        boxBg.Size = UDim2.new(0.55, -10, 0, 20); boxBg.Position = UDim2.new(0.45, 4, 0, 4)
        boxBg.BackgroundColor3 = self.Window.Theme.Sidebar
        Instance.new("UICorner", boxBg).CornerRadius = UDim.new(0, 3)

        local input = Instance.new("TextBox", boxBg)
        input.Size = UDim2.new(1, -6, 1, 0); input.Position = UDim2.new(0, 3, 0, 0)
        input.BackgroundTransparency = 1
        input.Text = cfg.CurrentValue or ""; input.PlaceholderText = cfg.PlaceholderText or "Type..."
        input.TextColor3 = self.Window.Theme.Text; input.PlaceholderColor3 = self.Window.Theme.Muted
        input.TextSize = 10; input.Font = Enum.Font.Gotham; input.TextXAlignment = Enum.TextXAlignment.Left; input.ClearTextOnFocus = false

        input.FocusLost:Connect(function()
            if cfg.Flag then self.Window.Flags[cfg.Flag] = input.Text end
            if cfg.Callback then pcall(cfg.Callback, input.Text) end
        end)
    end

    -- ColorPicker Element
    function tabData:CreateColorPicker(cfg)
        cfg = cfg or {}
        local currentColor = cfg.Color or Color3.fromRGB(255, 255, 255)
        local expanded = false

        local frame = Instance.new("Frame", view)
        frame.Size = UDim2.new(1, 0, 0, 28); frame.BackgroundColor3 = self.Window.Theme.Card
        frame.ClipsDescendants = true
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)

        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = self.Window.Theme.Border

        local title = Instance.new("TextLabel", frame)
        title.Size = UDim2.new(1, -40, 0, 28); title.Position = UDim2.new(0, 6, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "Color Picker"; title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 11; title.Font = Enum.Font.Gotham; title.TextXAlignment = Enum.TextXAlignment.Left

        local preview = Instance.new("TextButton", frame)
        preview.Size = UDim2.new(0, 20, 0, 14); preview.Position = UDim2.new(1, -26, 0, 7)
        preview.BackgroundColor3 = currentColor; preview.Text = ""
        Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 3)

        local hueTrack = Instance.new("Frame", frame)
        hueTrack.Size = UDim2.new(1, -12, 0, 10); hueTrack.Position = UDim2.new(0, 6, 0, 32)
        Instance.new("UICorner", hueTrack).CornerRadius = UDim.new(0, 3)
        
        local gradient = Instance.new("UIGradient", hueTrack)
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)), ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)), ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 0, 255)), ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0))
        })

        local trigger = Instance.new("TextButton", hueTrack)
        trigger.Size = UDim2.new(1, 0, 1, 0); trigger.BackgroundTransparency = 1; trigger.Text = ""
        
        local dragging = false
        local function update(input)
            local percent = math.clamp((input.Position.X - hueTrack.AbsolutePosition.X) / hueTrack.AbsoluteSize.X, 0, 1)
            currentColor = Color3.fromHSV(1 - percent, 1, 1)
            preview.BackgroundColor3 = currentColor
            if cfg.Flag then self.Window.Flags[cfg.Flag] = currentColor end
            if cfg.Callback then pcall(cfg.Callback, currentColor) end
        end

        trigger.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; update(input) end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
        end)

        preview.MouseButton1Click:Connect(function()
            expanded = not expanded
            tween(frame, 0.15, {Size = UDim2.new(1, 0, 0, expanded and 50 or 28)})
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = currentColor end
    end

    return tabData
end

function PhantomLib:DisableAllAndDestroy()
    if self.ToggleObjects then
        for _, toggle in ipairs(self.ToggleObjects) do
            if toggle:Get() then
                toggle:Set(false)
            end
        end
    end

    if self.ScreenName and getgenv()._PhantomLib_Instances then
        getgenv()._PhantomLib_Instances[self.ScreenName] = nil
    end

    self:Destroy()
end

function PhantomLib:Destroy()
    if self.Screen then
        if self.Main then
            tween(self.Main, 0.15, { BackgroundTransparency = 1 })
        end
        task.wait(0.15)
        self.Screen:Destroy()
    end
end

return PhantomLib
