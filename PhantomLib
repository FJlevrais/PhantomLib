        create("TextLabel", {
            Size = UDim2.new(0.45, 0, 0, 40),
            Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1,
            Text = cfg.Name or "Multi Dropdown",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame
        })

        local selectedLabel = create("TextLabel", {
            Size = UDim2.new(0.55, -36, 0, 40),
            Position = UDim2.new(0.45, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = #selected > 0 and (#selected .. " selected") or "None",
            TextColor3 = self.Window.Theme.Accent,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = frame
        })

        local arrow = create("TextLabel", {
            Size = UDim2.fromOffset(20, 40),
            Position = UDim2.new(1, -28, 0, 0),
            BackgroundTransparency = 1,
            Text = "▾",
            TextColor3 = self.Window.Theme.Muted,
            TextSize = 14,
            Font = Enum.Font.GothamBold,
            Parent = frame
        })

        local optionContainer = create("Frame", {
            Size = UDim2.new(1, -8, 0, 0),
            Position = UDim2.new(0, 4, 0, 44),
            BackgroundTransparency = 1,
            Parent = frame
        })
        create("UIListLayout", { Padding = UDim.new(0, 4), Parent = optionContainer })

        local function updateLabel()
            local count = 0
            for _ in pairs(selectedMap) do count += 1 end
            selectedLabel.Text = count > 0 and (count .. " selected") or "None"
        end

        local function getSelectedList()
            local list = {}
            for opt, _ in pairs(selectedMap) do
                table.insert(list, opt)
            end
            return list
        end

        local function toggle()
            open = not open
            local height = open and (40 + (#options * 34) + 12) or 40
            tween(frame, 0.22, { Size = UDim2.new(1, 0, 0, height) })
            tween(arrow, 0.22, { Rotation = open and 180 or 0 })
        end

        local trigger = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundTransparency = 1,
            Text = "",
            Parent = frame
        })
        trigger.MouseButton1Click:Connect(toggle)

        for _, opt in ipairs(options) do
            local optBtn = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundColor3 = self.Window.Theme.Sidebar,
                Text = "",
                Parent = optionContainer
            })
            create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = optBtn })

            local check = create("Frame", {
                Size = UDim2.fromOffset(16, 16),
                Position = UDim2.new(0, 8, 0.5, -8),
                BackgroundColor3 = selectedMap[opt] and self.Window.Theme.Accent or self.Window.Theme.Border,
                Parent = optBtn
            })
            create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = check })

            local checkMark = create("TextLabel", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = selectedMap[opt] and "✓" or "",
                TextColor3 = Color3.new(1, 1, 1),
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                Parent = check
            })

            local optLabel = create("TextLabel", {
                Size = UDim2.new(1, -36, 1, 0),
                Position = UDim2.new(0, 32, 0, 0),
                BackgroundTransparency = 1,
                Text = opt,
                TextColor3 = self.Window.Theme.Text,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = optBtn
            })

            optBtn.MouseEnter:Connect(function()
                tween(optBtn, 0.12, { BackgroundColor3 = Color3.fromRGB(
                    math.floor(self.Window.Theme.Sidebar.R * 255 + 15),
                    math.floor(self.Window.Theme.Sidebar.G * 255 + 15),
                    math.floor(self.Window.Theme.Sidebar.B * 255 + 15)
                )})
            end)
            optBtn.MouseLeave:Connect(function()
                tween(optBtn, 0.12, { BackgroundColor3 = self.Window.Theme.Sidebar })
            end)

            optBtn.MouseButton1Click:Connect(function()
                if selectedMap[opt] then
                    selectedMap[opt] = nil
                    check.BackgroundColor3 = self.Window.Theme.Border
                    checkMark.Text = ""
                else
                    selectedMap[opt] = true
                    check.BackgroundColor3 = self.Window.Theme.Accent
                    checkMark.Text = "✓"
                end
                updateLabel()
                local list = getSelectedList()
                if cfg.Flag then self.Window.Flags[cfg.Flag] = list end
                if cfg.Callback then pcall(cfg.Callback, list) end
            end)
        end

        if cfg.Flag then self.Window.Flags[cfg.Flag] = getSelectedList() end
        updateLabel()

        return {
            Set = function(_, list)
                selectedMap = {}
                for _, v in ipairs(list or {}) do selectedMap[v] = true end
                updateLabel()
                -- Note: visual checkmarks won't update unless you rebuild, but value is correct
            end,
            Get = function() return getSelectedList() end
        }
    end

    -- ========================
    -- PLAYER SELECTOR
    -- ========================
    function tabData:CreatePlayerSelector(cfg)
        cfg = cfg or {}
        local multi = cfg.MultiSelect or false
        local selectedPlayers = {} -- [Player] = true
        local open = false
        local playerButtons = {} -- [Player] = button frame

        local frame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundColor3 = self.Window.Theme.Card,
            ClipsDescendants = true,
            Parent = view
        })
        create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = frame })
        create("UIStroke", { Color = self.Window.Theme.Border, Parent = frame })

        create("TextLabel", {
            Size = UDim2.new(0.5, 0, 0, 42),
            Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1,
            Text = cfg.Name or "Player Selector",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame
        })

        local selectedLabel = create("TextLabel", {
            Size = UDim2.new(0.5, -36, 0, 42),
            Position = UDim2.new(0.5, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = multi and "0 selected" or "None",
            TextColor3 = self.Window.Theme.Accent,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = frame
        })

        local arrow = create("TextLabel", {
            Size = UDim2.fromOffset(20, 42),
            Position = UDim2.new(1, -28, 0, 0),
            BackgroundTransparency = 1,
            Text = "▾",
            TextColor3 = self.Window.Theme.Muted,
            TextSize = 14,
            Font = Enum.Font.GothamBold,
            Parent = frame
        })

        local listContainer = create("ScrollingFrame", {
            Size = UDim2.new(1, -8, 0, 0),
            Position = UDim2.new(0, 4, 0, 48),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = self.Window.Theme.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            Parent = frame
        })
        local listLayout = create("UIListLayout", {
            Padding = UDim.new(0, 4),
            Parent = listContainer
        })
        listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            listContainer.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 6)
        end)

        local function updateSelectedLabel()
            local count = 0
            local lastName = nil
            for plr, _ in pairs(selectedPlayers) do
                if plr.Parent then
                    count += 1
                    lastName = plr.DisplayName
                end
            end
            if multi then
                selectedLabel.Text = count > 0 and (count .. " selected") or "None"
            else
                selectedLabel.Text = lastName or "None"
            end
        end

        local function getSelected()
            local result = {}
            for plr, _ in pairs(selectedPlayers) do
                if plr and plr.Parent then
                    table.insert(result, plr)
                end
            end
            if multi then
                return result
            else
                return result[1]
            end
        end

        local function toggleOpen()
            open = not open
            local playerCount = #Players:GetPlayers()
            local height = open and math.min(42 + (playerCount * 48) + 16, 280) or 42
            tween(frame, 0.25, { Size = UDim2.new(1, 0, 0, height) })
            tween(arrow, 0.25, { Rotation = open and 180 or 0 })
            if open then
                listContainer.Size = UDim2.new(1, -8, 0, height - 52)
            end
        end

        local headerTrigger = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundTransparency = 1,
            Text = "",
            Parent = frame
        })
        headerTrigger.MouseButton1Click:Connect(toggleOpen)

        local function createPlayerRow(player)
            if playerButtons[player] then return end

            local row = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 44),
                BackgroundColor3 = self.Window.Theme.Sidebar,
                Text = "",
                Parent = listContainer
            })
            create("UICorner", { CornerRadius = UDim.new(0, 7), Parent = row })

            -- Avatar
            local avatar = create("ImageLabel", {
                Size = UDim2.fromOffset(32, 32),
                Position = UDim2.new(0, 8, 0.5, -16),
                BackgroundColor3 = self.Window.Theme.Card,
                Image = "rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=48&h=48",
                Parent = row
            })
            create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = avatar })

            -- Display Name
            local displayName = create("TextLabel", {
                Size = UDim2.new(1, -90, 0, 18),
                Position = UDim2.new(0, 48, 0, 5),
                BackgroundTransparency = 1,
                Text = player.DisplayName,
                TextColor3 = self.Window.Theme.Text,
                TextSize = 13,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = row
            })

            -- Username
            local userName = create("TextLabel", {
                Size = UDim2.new(1, -90, 0, 16),
                Position = UDim2.new(0, 48, 0, 23),
                BackgroundTransparency = 1,
                Text = "@" .. player.Name,
                TextColor3 = self.Window.Theme.Muted,
                TextSize = 11,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = row
            })

            -- Selection indicator (for multi)
            local indicator = create("Frame", {
                Size = UDim2.fromOffset(18, 18),
                Position = UDim2.new(1, -28, 0.5, -9),
                BackgroundColor3 = self.Window.Theme.Border,
                Visible = multi,
                Parent = row
            })
            create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = indicator })
            local check = create("TextLabel", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                TextColor3 = Color3.new(1,1,1),
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                Parent = indicator
            })

            local function setSelected(isSelected)
                if isSelected then
                    tween(row, 0.15, { BackgroundColor3 = self.Window.Theme.Accent })
                    displayName.TextColor3 = Color3.new(1,1,1)
                    userName.TextColor3 = Color3.fromRGB(230, 230, 255)
                    if multi then
                        indicator.BackgroundColor3 = Color3.new(1,1,1)
                        check.Text = "✓"
                        check.TextColor3 = self.Window.Theme.Accent
                    end
                else
                    tween(row, 0.15, { BackgroundColor3 = self.Window.Theme.Sidebar })
                    displayName.TextColor3 = self.Window.Theme.Text
                    userName.TextColor3 = self.Window.Theme.Muted
                    if multi then
                        indicator.BackgroundColor3 = self.Window.Theme.Border
                        check.Text = ""
                    end
                end
            end

            row.MouseEnter:Connect(function()
                if not selectedPlayers[player] then
                    tween(row, 0.12, { BackgroundColor3 = Color3.fromRGB(
                        math.floor(self.Window.Theme.Sidebar.R*255 + 12),
                        math.floor(self.Window.Theme.Sidebar.G*255 + 12),
                        math.floor(self.Window.Theme.Sidebar.B*255 + 12)
                    )})
                end
            end)
            row.MouseLeave:Connect(function()
                if not selectedPlayers[player] then
                    tween(row, 0.12, { BackgroundColor3 = self.Window.Theme.Sidebar })
                end
            end)

            row.MouseButton1Click:Connect(function()
                if multi then
                    if selectedPlayers[player] then
                        selectedPlayers[player] = nil
                        setSelected(false)
                    else
                        selectedPlayers[player] = true
                        setSelected(true)
                    end
                else
                    -- Single select: clear others
                    for plr, _ in pairs(selectedPlayers) do
                        selectedPlayers[plr] = nil
                        if playerButtons[plr] then
                            -- reset visual
                            local otherRow = playerButtons[plr]
                            -- simple reset
                        end
                    end
                    selectedPlayers = { [player] = true }
                    setSelected(true)
                    -- close after single select
                    toggleOpen()
                end

                updateSelectedLabel()
                local result = getSelected()
                if cfg.Flag then self.Window.Flags[cfg.Flag] = result end
                if cfg.Callback then pcall(cfg.Callback, result) end
            end)

            playerButtons[player] = row
            if selectedPlayers[player] then setSelected(true) end
        end

        local function removePlayerRow(player)
            if playerButtons[player] then
                playerButtons[player]:Destroy()
                playerButtons[player] = nil
            end
            if selectedPlayers[player] then
                selectedPlayers[player] = nil
                updateSelectedLabel()
            end
        end

        local function refreshPlayers()
            for _, plr in ipairs(Players:GetPlayers()) do
                createPlayerRow(plr)
            end
        end

        -- Initial load
        refreshPlayers()

        -- Auto refresh
        local addConn = Players.PlayerAdded:Connect(function(player)
            task.wait(0.1) -- small delay so character/name is ready
            createPlayerRow(player)
            if open then
                local playerCount = #Players:GetPlayers()
                local height = math.min(42 + (playerCount * 48) + 16, 280)
                tween(frame, 0.2, { Size = UDim2.new(1, 0, 0, height) })
                listContainer.Size = UDim2.new(1, -8, 0, height - 52)
            end
        end)

        local removeConn = Players.PlayerRemoving:Connect(function(player)
            removePlayerRow(player)
            if open then
                local playerCount = #Players:GetPlayers()
                local height = math.min(42 + (playerCount * 48) + 16, 280)
                tween(frame, 0.2, { Size = UDim2.new(1, 0, 0, height) })
                listContainer.Size = UDim2.new(1, -8, 0, height - 52)
            end
        end)

        -- Cleanup when window is destroyed
        self.Window.Screen.Destroying:Connect(function()
            addConn:Disconnect()
            removeConn:Disconnect()
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = getSelected() end
        updateSelectedLabel()

        return {
            Get = function() return getSelected() end,
            Set = function(_, players)
                selectedPlayers = {}
                if multi then
                    for _, plr in ipairs(players or {}) do
                        if typeof(plr) == "Instance" and plr:IsA("Player") then
                            selectedPlayers[plr] = true
                        end
                    end
                else
                    if typeof(players) == "Instance" and players:IsA("Player") then
                        selectedPlayers[players] = true
                    end
                end
                updateSelectedLabel()
            end,
            Refresh = refreshPlayers
        }
    end

