                keyBtn.Text = current
                keyBtn.TextColor3 = self.Window.Theme.Accent
                listening = false
                if cfg.Flag then self.Window.Flags[cfg.Flag] = current end
                if cfg.Callback then pcall(cfg.Callback, current) end
            end
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = current end
        return {
            Set = function(_, key) current = key; keyBtn.Text = key end,
            Get = function() return current end
        }
    end

