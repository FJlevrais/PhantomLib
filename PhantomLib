function PhantomLib:CreateWindow(opts)
    opts = opts or {}
    local name = opts.Name or opts.Title or "Phantom"
    local parent = getParent()
    local screenName = "PhantomLib_" .. name:gsub("%s+", "_")

    if getgenv()._PhantomLib_Instances[screenName] then
        pcall(function()
            getgenv()._PhantomLib_Instances[screenName]:DisableAllAndDestroy()
        end)
    else
        local old = parent:FindFirstChild(screenName)
        if old then old:Destroy() end
    end

    local self = setmetatable({}, PhantomLib)
    self.Theme = PhantomLib.Themes[opts.Theme] or PhantomLib.Themes.Default
    self.CurrentTheme = opts.Theme or "Default"
    self.Tabs = {}
    self.ActiveTab = nil
    self.Flags = {}
    self.ToggleObjects = {}
    self.Minimized = false
    getgenv()._PhantomLib_Instances[screenName] = self

    local function finishCreate()
        local screen = Instance.new("ScreenGui")
        screen.Name = screenName
        screen.ResetOnSpawn = false
        screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screen.IgnoreGuiInset = true
        screen.Parent = parent

        local notifHolder = Instance.new("Frame")
        notifHolder.Size = UDim2.new(0, 280, 1, -16)
        notifHolder.Position = UDim2.new(1, -12, 1, -12)
        notifHolder.AnchorPoint = Vector2.new(1, 1)
        notifHolder.BackgroundTransparency = 1
        notifHolder.Parent = screen

        local notifLayout = Instance.new("UIListLayout")
        notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        notifLayout.Padding = UDim.new(0, 8)
        notifLayout.Parent = notifHolder

        -- COMPACT SIZE
        local baseW, baseH = 460, 320
        if isMobile() then
            baseW, baseH = 340, 420
        end
        local size = opts.Size or UDim2.fromOffset(baseW, baseH)

        local main = Instance.new("Frame")
        main.Name = "Main"
        main.Size = UDim2.fromOffset(0, 0)
        main.Position = UDim2.fromScale(0.5, 0.5)
        main.AnchorPoint = Vector2.new(0.5, 0.5)
        main.BackgroundColor3 = self.Theme.Background
        main.BorderSizePixel = 0
        main.ClipsDescendants = true
        main.Parent = screen
        corner(main, 12)
        local mainStroke = stroke(main, self.Theme.Border, 1)

        spring(main, 0.45, {
            Size = size,
            Position = UDim2.new(0.5, -size.X.Offset / 2, 0.5, -size.Y.Offset / 2),
            AnchorPoint = Vector2.new(0, 0)
        })

        -- Header
        local header = Instance.new("Frame")
        header.Size = UDim2.new(1, 0, 0, 42)
        header.BackgroundColor3 = self.Theme.Surface
        header.BorderSizePixel = 0
        header.Parent = main
        corner(header, 12)

        local headerFill = Instance.new("Frame")
        headerFill.Size = UDim2.new(1, 0, 0, 16)
        headerFill.Position = UDim2.new(0, 0, 1, -16)
        headerFill.BackgroundColor3 = self.Theme.Surface
        headerFill.BorderSizePixel = 0
        headerFill.Parent = header

        local headerLine = Instance.new("Frame")
        headerLine.Size = UDim2.new(1, 0, 0, 1)
        headerLine.Position = UDim2.new(0, 0, 1, -1)
        headerLine.BackgroundColor3 = self.Theme.Accent
        headerLine.BackgroundTransparency = 0.7
        headerLine.BorderSizePixel = 0
        headerLine.Parent = header

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0, 180, 1, 0)
        title.Position = UDim2.new(0, 14, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = name
        title.TextColor3 = self.Theme.Text
        title.TextSize = 14
        title.Font = Enum.Font.GothamBold
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = header

        local right = Instance.new("Frame")
        right.Size = UDim2.new(0, 190, 1, 0)
        right.Position = UDim2.new(1, -198, 0, 0)
        right.BackgroundTransparency = 1
        right.Parent = header

        local stats = Instance.new("Frame")
        stats.Size = UDim2.new(0, 100, 1, 0)
        stats.BackgroundTransparency = 1
        stats.Parent = right

        local fpsLbl = Instance.new("TextLabel")
        fpsLbl.Size = UDim2.new(0.5, -2, 1, 0)
        fpsLbl.BackgroundTransparency = 1
        fpsLbl.Text = "FPS --"
        fpsLbl.TextColor3 = self.Theme.Muted
        fpsLbl.TextSize = 11
        fpsLbl.Font = Enum.Font.GothamMedium
        fpsLbl.TextXAlignment = Enum.TextXAlignment.Right
        fpsLbl.Parent = stats

        local pingLbl = Instance.new("TextLabel")
        pingLbl.Size = UDim2.new(0.5, -2, 1, 0)
        pingLbl.Position = UDim2.new(0.5, 2, 0, 0)
        pingLbl.BackgroundTransparency = 1
        pingLbl.Text = "--ms"
        pingLbl.TextColor3 = self.Theme.Muted
        pingLbl.TextSize = 11
        pingLbl.Font = Enum.Font.GothamMedium
        pingLbl.TextXAlignment = Enum.TextXAlignment.Left
        pingLbl.Parent = stats

        local last = 0
        RunService.RenderStepped:Connect(function(dt)
            if tick() - last > 0.45 then
                last = tick()
                local fps = math.floor(1 / math.max(dt, 0.001))
                fpsLbl.Text = "FPS " .. fps
                local ping = 0
                pcall(function()
                    ping = math.floor(LP:GetNetworkPing() * 1000)
                end)
                pingLbl.Text = ping .. "ms"
                fpsLbl.TextColor3 = fps >= 55 and self.Theme.Success or (fps >= 35 and self.Theme.Warning or self.Theme.Danger)
                pingLbl.TextColor3 = ping <= 70 and self.Theme.Success or (ping <= 130 and self.Theme.Warning or self.Theme.Danger)
            end
        end)

        local controls = Instance.new("Frame")
        controls.Size = UDim2.new(0, 86, 1, 0)
        controls.Position = UDim2.new(1, -90, 0, 0)
        controls.BackgroundTransparency = 1
        controls.Parent = right

        local function makeBtn(txt, x)
            local b = Instance.new("TextButton")
            b.Size = UDim2.fromOffset(26, 26)
            b.Position = UDim2.new(0, x, 0.5, -13)
            b.BackgroundColor3 = self.Theme.Elevated
            b.BackgroundTransparency = 1
            b.Text = txt
            b.TextColor3 = self.Theme.Text
            b.TextSize = 14
            b.Font = Enum.Font.GothamBold
            b.AutoButtonColor = false
            b.Parent = controls
            corner(b, 6)
            b.MouseEnter:Connect(function()
                tween(b, 0.12, {BackgroundTransparency = 0.4})
            end)
            b.MouseLeave:Connect(function()
                tween(b, 0.12, {BackgroundTransparency = 1})
            end)
            return b
        end

        local gear = makeBtn("⚙", 0)
        local minBtn = makeBtn("–", 30)
        local closeBtn = makeBtn("×", 60)
        closeBtn.TextColor3 = Color3.new(1, 1, 1)

        -- Theme panel
        local themePanel = Instance.new("Frame")
        themePanel.Size = UDim2.fromOffset(130, 0)
        themePanel.Position = UDim2.new(1, -142, 0, 48)
        themePanel.BackgroundColor3 = self.Theme.Elevated
        themePanel.Visible = false
        themePanel.ClipsDescendants = true
        themePanel.ZIndex = 40
        themePanel.Parent = main
        corner(themePanel, 9)
        stroke(themePanel, self.Theme.Border, 1)

        local tLayout = Instance.new("UIListLayout")
        tLayout.Padding = UDim.new(0, 4)
        tLayout.Parent = themePanel
        padding(themePanel, 6, 6, 6, 6)

        local themeOpen = false
        local themeBtns = {}

        local function setTheme(themeName)
            local th = PhantomLib.Themes[themeName]
            if not th then return end
            self.Theme = th
            self.CurrentTheme = themeName

            tween(main, 0.25, {BackgroundColor3 = th.Background})
            tween(header, 0.25, {BackgroundColor3 = th.Surface})
            tween(headerFill, 0.25, {BackgroundColor3 = th.Surface})
            tween(headerLine, 0.22, {BackgroundColor3 = th.Accent})
            tween(title, 0.18, {TextColor3 = th.Text})
            tween(mainStroke, 0.22, {Color = th.Border})
            tween(themePanel, 0.18, {BackgroundColor3 = th.Elevated})

            if self.Sidebar then
                tween(self.Sidebar, 0.22, {BackgroundColor3 = th.Surface})
                self.Sidebar.ScrollBarImageColor3 = th.Accent
            end

            for _, tab in ipairs(self.Tabs) do
                if tab.Label then
                    tween(tab.Label, 0.18, {
                        TextColor3 = (self.ActiveTab == tab) and th.Text or th.Muted
                    })
                end
                if tab.Indicator then
                    tween(tab.Indicator, 0.18, {BackgroundColor3 = th.Accent})
                end
                if tab.View then
                    tab.View.ScrollBarImageColor3 = th.Accent
                end
            end

            for n, data in pairs(themeBtns) do
                local sel = n == themeName
                tween(data.btn, 0.14, {
                    BackgroundTransparency = sel and 0 or 1,
                    BackgroundColor3 = sel and th.Accent or th.Elevated
                })
                tween(data.label, 0.14, {
                    TextColor3 = sel and Color3.new(1, 1, 1) or th.Text
                })
            end

            self:Notify({Title = "Theme", Content = "Switched to " .. themeName, Duration = 1.5})
        end

        for _, tName in ipairs({"Default", "Midnight", "Ember"}) do
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, 0, 0, 26)
            b.BackgroundColor3 = self.Theme.Accent
            b.BackgroundTransparency = (tName == self.CurrentTheme) and 0 or 1
            b.Text = ""
            b.AutoButtonColor = false
            b.ZIndex = 41
            b.Parent = themePanel
            corner(b, 6)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = tName
            lbl.TextColor3 = (tName == self.CurrentTheme) and Color3.new(1, 1, 1) or self.Theme.Text
            lbl.TextSize = 12
            lbl.Font = Enum.Font.GothamMedium
            lbl.ZIndex = 42
            lbl.Parent = b

            themeBtns[tName] = {btn = b, label = lbl}

            b.MouseEnter:Connect(function()
                if tName ~= self.CurrentTheme then
                    tween(b, 0.1, {BackgroundTransparency = 0.7})
                end
            end)
            b.MouseLeave:Connect(function()
                if tName ~= self.CurrentTheme then
                    tween(b, 0.1, {BackgroundTransparency = 1})
                end
            end)
            b.MouseButton1Click:Connect(function()
                setTheme(tName)
            end)
        end

        gear.MouseButton1Click:Connect(function()
            themeOpen = not themeOpen
            if themeOpen then
                themePanel.Visible = true
                themePanel.Size = UDim2.fromOffset(130, 0)
                spring(themePanel, 0.28, {Size = UDim2.fromOffset(130, 110)})
            else
                tween(themePanel, 0.16, {Size = UDim2.fromOffset(130, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
                task.delay(0.18, function()
                    if not themeOpen then themePanel.Visible = false end
                end)
            end
        end)

        minBtn.MouseButton1Click:Connect(function()
            self.Minimized = not self.Minimized
            if self.Minimized then
                if themeOpen then
                    themeOpen = false
                    themePanel.Visible = false
                end
                tween(main, 0.24, {Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 42)})
            else
                tween(main, 0.3, {Size = size}, Enum.EasingStyle.Back)
            end
        end)

        closeBtn.MouseButton1Click:Connect(function()
            self:DisableAllAndDestroy()
        end)

        -- Dragging
        local dragging, start, startPos
        header.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                start = inp.Position
                startPos = main.Position
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                local d = inp.Position - start
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        -- Sidebar
        local sidebarWidth = isMobile() and 100 or 118
        local sidebar = Instance.new("ScrollingFrame")
        sidebar.Size = UDim2.new(0, sidebarWidth, 1, -42)
        sidebar.Position = UDim2.new(0, 0, 0, 42)
        sidebar.BackgroundColor3 = self.Theme.Surface
        sidebar.BorderSizePixel = 0
        sidebar.ScrollBarThickness = 2
        sidebar.ScrollBarImageColor3 = self.Theme.Accent
        sidebar.ScrollBarImageTransparency = 0.4
        sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
        sidebar.Parent = main

        local sLayout = Instance.new("UIListLayout")
        sLayout.Padding = UDim.new(0, 3)
        sLayout.Parent = sidebar
        padding(sidebar, 8, 6, 10, 6)

        sLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            sidebar.CanvasSize = UDim2.new(0, 0, 0, sLayout.AbsoluteContentSize.Y + 12)
        end)

        local container = Instance.new("Frame")
        container.Size = UDim2.new(1, -sidebarWidth, 1, -42)
        container.Position = UDim2.new(0, sidebarWidth, 0, 42)
        container.BackgroundTransparency = 1
        container.Parent = main

        self.ScreenName = screenName
        self.Screen = screen
        self.Main = main
        self.NotifContainer = notifHolder
        self.Container = container
        self.Sidebar = sidebar
        self.TargetSize = size
        self.MainStroke = mainStroke

        task.delay(0.4, function()
            self:Notify({Title = "PhantomLib", Content = "Ready", Duration = 1.6})
        end)

        return self
    end

    if opts.KeySystem then
        self:CreateKeySystem(opts.KeySystem, function()
            finishCreate()
        end)
        return self
    else
        return finishCreate()
    end
end

