function PhantomLib:CreateWindow(opts)
    opts = opts or {}
    local name = opts.Name or opts.Title or "Phantom Window"
    local parent = getParent()
    local screenName = "PhantomLib_" .. name:gsub("%s+", "_")

    if getgenv()._PhantomLib_Instances[screenName] then
        pcall(function()
            getgenv()._PhantomLib_Instances[screenName]:DisableAllAndDestroy()
        end)
    else
        local old = parent:FindFirstChild(screenName)
        if old then old:Destroy() end
    end

    local self = setmetatable({}, PhantomLib)
    self.Theme = PhantomLib.Themes[opts.Theme] or PhantomLib.Themes.Default
    self.CurrentTheme = opts.Theme or "Default"
    self.Tabs = {}
    self.ActiveTab = nil
    self.Flags = {}
    self.ToggleObjects = {}
    self.Minimized = false
    getgenv()._PhantomLib_Instances[screenName] = self

    local function finishCreate()
        local screen = Instance.new("ScreenGui")
        screen.Name = screenName
        screen.ResetOnSpawn = false
        screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screen.Parent = parent

        local notifHolder = Instance.new("Frame")
