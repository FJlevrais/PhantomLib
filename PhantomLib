        local arrow = Instance.new("TextLabel")
        arrow.Size = UDim2.fromOffset(20, 30)
        arrow.Position = UDim2.new(1, -24, 0, 0)
        arrow.BackgroundTransparency = 1
        arrow.Text = "▼"
        arrow.TextColor3 = self.Window.Theme.Muted
        arrow.TextSize = 10
        arrow.Font = Enum.Font.GothamBold
        arrow.Parent = mainButton

        local content = Instance.new("Frame")
        content.Size = UDim2.new(1, -10, 0, 0)
        content.Position = UDim2.new(0, 5, 0, 42)
        content.BackgroundTransparency = 1
        content.ClipsDescendants = true
        content.Visible = false
        content.ZIndex = 5
        content.Parent = frame

        local searchBox = Instance.new("Frame")
        searchBox.Size = UDim2.new(1, 0, 0, 26)
        searchBox.BackgroundColor3 = self.Window.Theme.Sidebar
        searchBox.Parent = content
        corner(searchBox, 7)
        stroke(searchBox, self.Window.Theme.Border, 1, 0.4)

        local searchIcon = Instance.new("TextLabel")
        searchIcon.Size = UDim2.fromOffset(18, 26)
        searchIcon.Position = UDim2.new(0, 4, 0, 0)
        searchIcon.BackgroundTransparency = 1
        searchIcon.Text = "🔍"
        searchIcon.TextColor3 = self.Window.Theme.Muted
        searchIcon.TextSize = 9
        searchIcon.Font = Enum.Font.Gotham
        searchIcon.Parent = searchBox

        local searchInput = Instance.new("TextBox")
        searchInput.Size = UDim2.new(1, -28, 1, 0)
        searchInput.Position = UDim2.new(0, 24, 0, 0)
        searchInput.BackgroundTransparency = 1
        searchInput.PlaceholderText = cfg.SearchPlaceholder or "Search..."
        searchInput.PlaceholderColor3 = self.Window.Theme.Muted
        searchInput.TextColor3 = self.Window.Theme.Text
        searchInput.TextSize = 11
        searchInput.Font = Enum.Font.Gotham
        searchInput.ClearTextOnFocus = false
        searchInput.Text = ""
        searchInput.Parent = searchBox

        local list = Instance.new("ScrollingFrame")
        list.Size = UDim2.new(1, 0, 0, 0)
        list.Position = UDim2.new(0, 0, 0, 32)
        list.BackgroundColor3 = self.Window.Theme.Sidebar
        list.BackgroundTransparency = 0.1
        list.BorderSizePixel = 0
        list.ScrollBarThickness = 2
        list.ScrollBarImageColor3 = self.Window.Theme.Accent
        list.CanvasSize = UDim2.new(0, 0, 0, 0)
        list.ClipsDescendants = true
        list.ZIndex = 6
        list.Parent = content
        corner(list, 8)

        local listLayout = Instance.new("UIListLayout")
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Padding = UDim.new(0, 3)
        listLayout.Parent = list
        padding(list, 3, 3, 3, 3)

        listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            list.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 6)
        end)

        local optionButtons = {}
        local filteredOptions = {}
        local isOpen = false

        local function updateMainButtonTitle()
            local selectedList = {}
            for k, v in pairs(selectedItems) do
                if v then table.insert(selectedList, k) end
            end
            if #selectedList == 0 then
                titleLabel.Text = cfg.Name or "List"
                titleLabel.TextColor3 = self.Window.Theme.Muted
            elseif #selectedList == 1 then
                titleLabel.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. tostring(selectedList[1])
                titleLabel.TextColor3 = self.Window.Theme.Text
            else
                titleLabel.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. #selectedList .. " selected"
                titleLabel.TextColor3 = self.Window.Theme.Text
            end
        end

        local function updateDropdownHeight(count)
            local visibleCount = math.min(count or #filteredOptions, maxVisible)
            local searchHeight = 32
            local listHeight = visibleCount * (itemHeight + 3) + 6
            local totalHeight = searchHeight + listHeight
            content.Size = UDim2.new(1, -10, 0, totalHeight)
            list.Size = UDim2.new(1, 0, 0, listHeight)
        end

        local function buildOptions(filterText)
            filterText = string.lower(filterText or "")
            for _, btn in pairs(optionButtons) do
                btn:Destroy()
            end
            optionButtons = {}
            filteredOptions = {}
            if filterText == "" then
                for _, opt in ipairs(options) do
                    table.insert(filteredOptions, opt)
                end
            else
                for _, opt in ipairs(options) do
                    if string.find(string.lower(tostring(opt)), filterText, 1, true) then
                        table.insert(filteredOptions, opt)
                    end
                end
            end

            for i, opt in ipairs(filteredOptions) do
                local isSelected = selectedItems[opt] == true
                local b = Instance.new("TextButton")
                b.Size = UDim2.new(1, 0, 0, itemHeight)
                b.BackgroundColor3 = isSelected and self.Window.Theme.Accent or self.Window.Theme.Card
                b.BackgroundTransparency = isSelected and 0.22 or 0.65
                b.Text = ""
                b.AutoButtonColor = false
                b.LayoutOrder = i
                b.ZIndex = 7
                b.Parent = list
                corner(b, 6)

                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, -30, 1, 0)
                lbl.Position = UDim2.new(0, 10, 0, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = tostring(opt)
                lbl.TextColor3 = self.Window.Theme.Text
                lbl.TextSize = 11
                lbl.Font = Enum.Font.Gotham
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.ZIndex = 8
                lbl.Parent = b

                local check = Instance.new("TextLabel")
                check.Size = UDim2.fromOffset(16, 16)
                check.Position = UDim2.new(1, -24, 0.5, -8)
                check.BackgroundTransparency = 1
                check.Text = isSelected and "✓" or ""
                check.TextColor3 = self.Window.Theme.Accent
                check.TextSize = 12
                check.Font = Enum.Font.GothamBold
                check.ZIndex = 8
                check.Parent = b

                b.MouseEnter:Connect(function()
                    if not selectedItems[opt] then
                        tween(b, 0.1, {BackgroundTransparency = 0.4})
                    end
                end)
                b.MouseLeave:Connect(function()
                    if not selectedItems[opt] then
                        tween(b, 0.1, {BackgroundTransparency = 0.65})
                    end
                end)
                b.MouseButton1Click:Connect(function()
                    selectedItems[opt] = not selectedItems[opt]
                    local now = selectedItems[opt]
                    soft(b, 0.14, {
                        BackgroundColor3 = now and self.Window.Theme.Accent or self.Window.Theme.Card,
                        BackgroundTransparency = now and 0.22 or 0.65
                    })
                    check.Text = now and "✓" or ""
                    updateMainButtonTitle()
                    local selectedList = {}
                    for k, v in pairs(selectedItems) do
                        if v then table.insert(selectedList, k) end
                    end
                    if cfg.Flag then self.Window.Flags[cfg.Flag] = selectedList end
                    if cfg.Callback then pcall(cfg.Callback, selectedList) end
                    task.wait(0.04)
                    updateFrameHeight()
                end)
                optionButtons[opt] = b
            end
            updateDropdownHeight(#filteredOptions)
        end

        searchInput:GetPropertyChangedSignal("Text"):Connect(function()
            buildOptions(searchInput.Text)
        end)

        local function setOpen(state)
            isOpen = state
            if isOpen then
                buildOptions("")
                content.Visible = true
                content.Size = UDim2.new(1, -10, 0, 0)
                spring(content, 0.28, {Size = UDim2.new(1, -10, 0, 120)})
                soft(arrow, 0.2, {Rotation = 180})
                spring(frame, 0.28, {Size = UDim2.new(1, 0, 0, 42 + 8 + 120)})
                task.wait(0.08)
                searchInput:CaptureFocus()
            else
                spring(frame, 0.24, {Size = UDim2.new(1, 0, 0, 42)})
                soft(arrow, 0.2, {Rotation = 0})
                soft(content, 0.22, {Size = UDim2.new(1, -10, 0, 0)})
                task.delay(0.24, function()
                    if not isOpen then
                        content.Visible = false
                        content.Size = UDim2.new(1, -10, 0, 0)
                    end
                end)
            end
        end

        mainButton.MouseButton1Click:Connect(function()
            setOpen(not isOpen)
        end)

        searchInput.FocusLost:Connect(function()
            task.delay(0.12, function()
                if isOpen and not searchInput:IsFocused() then
                    setOpen(false)
                end
            end)
        end)

        local function updateFrameHeight()
            local h = 42
            if isOpen then
                h = h + content.Size.Y.Offset + 8
            end
            frame.Size = UDim2.new(1, 0, 0, h)
        end

        content:GetPropertyChangedSignal("Size"):Connect(updateFrameHeight)
        updateFrameHeight()
        updateMainButtonTitle()

        local obj = {}
        function obj:SetOptions(newOptions)
            options = newOptions or {}
            for k in pairs(selectedItems) do
                if not table.find(options, k) then
                    selectedItems[k] = nil
                end
            end
            updateMainButtonTitle()
            if isOpen then buildOptions(searchInput.Text) end
            task.wait(0.04)
            updateFrameHeight()
        end
        function obj:Get()
            local result = {}
            for k, v in pairs(selectedItems) do
                if v then table.insert(result, k) end
            end
            return result
        end
        function obj:Set(values)
            selectedItems = {}
            if type(values) == "table" then
                for _, v in ipairs(values) do
                    if table.find(options, v) then
                        selectedItems[v] = true
                    end
                end
            end
            updateMainButtonTitle()
            if isOpen then buildOptions(searchInput.Text) end
            if cfg.Flag then self.Window.Flags[cfg.Flag] = self:Get() end
            if cfg.Callback then pcall(cfg.Callback, self:Get()) end
            task.wait(0.04)
            updateFrameHeight()
        end
        function obj:Clear()
            selectedItems = {}
            updateMainButtonTitle()
            if isOpen then buildOptions(searchInput.Text) end
            if cfg.Flag then self.Window.Flags[cfg.Flag] = {} end
            if cfg.Callback then pcall(cfg.Callback, {}) end
            task.wait(0.04)
            updateFrameHeight()
        end
        function obj:Search(text)
            searchInput.Text = text or ""
        end

        if cfg.Flag then self.Window.Flags[cfg.Flag] = self:Get() end
        return obj
    end

    return tab
end

function PhantomLib:DisableAllAndDestroy()
    if self.ToggleObjects then
        for _, t in ipairs(self.ToggleObjects) do
            if t:Get() then t:Set(false) end
        end
    end
    if self.ScreenName and getgenv()._PhantomLib_Instances then
        getgenv()._PhantomLib_Instances[self.ScreenName] = nil
    end
    self:Destroy()
end

function PhantomLib:Destroy()
    if not self.Screen or not self.Main then return end
    local main = self.Main
    local glow = self.Glow
    local stroke = self.MainStroke

    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = main

    if glow then soft(glow, 0.2, {ImageTransparency = 1}) end
    if stroke then soft(stroke, 0.18, {Transparency = 1}) end

    soft(scale, 0.26, {Scale = 0.92})
    soft(main, 0.26, {
        BackgroundTransparency = 0.4,
        Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset + 18, main.Position.Y.Scale, main.Position.Y.Offset - 12)
    })

    task.wait(0.18)
    soft(scale, 0.2, {Scale = 0})
    soft(main, 0.2, {
        BackgroundTransparency = 1,
        Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset + 32, main.Position.Y.Scale, main.Position.Y.Offset - 24)
    })

    task.wait(0.22)
    if self.Screen then self.Screen:Destroy() end
end

return PhantomLib
