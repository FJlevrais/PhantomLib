        local closeBtn = makeBtn("×", self.Theme.Danger, 60)
        closeBtn.TextColor3 = Color3.new(1, 1, 1)

        -- Theme panel
        local themePanel = Instance.new("Frame")
        themePanel.Size = UDim2.fromOffset(148, 0)
        themePanel.Position = UDim2.new(1, -158, 0, 48)
        themePanel.BackgroundColor3 = self.Theme.Card
        themePanel.BackgroundTransparency = 0.08
        themePanel.Visible = false
        themePanel.ClipsDescendants = true
        themePanel.ZIndex = 30
        themePanel.Parent = main
        corner(themePanel, 12)
        local tStroke = stroke(themePanel, self.Theme.Accent, 1, 0.5)

        local tLayout = Instance.new("UIListLayout")
        tLayout.Padding = UDim.new(0, 5)
        tLayout.Parent = themePanel
        padding(themePanel, 8, 8, 8, 8)

        local themeOpen = false
        local themeBtns = {}

        local function setTheme(themeName)
            local th = PhantomLib.Themes[themeName]
            if not th then return end
            self.Theme = th
            self.CurrentTheme = themeName

            soft(main, 0.32, {BackgroundColor3 = th.Background, BackgroundTransparency = th.Glass * 0.4})
            soft(header, 0.32, {BackgroundColor3 = th.Sidebar})
            soft(headerFill, 0.32, {BackgroundColor3 = th.Sidebar})
            soft(headerLine, 0.3, {BackgroundColor3 = th.Accent})
            soft(title, 0.25, {TextColor3 = th.Text})
            soft(mainStroke, 0.28, {Color = th.Border, Transparency = th.GlassBorder})
            soft(glow, 0.35, {ImageColor3 = th.Accent})
            soft(themePanel, 0.25, {BackgroundColor3 = th.Card})
            soft(tStroke, 0.25, {Color = th.Accent})

            if self.Sidebar then
                soft(self.Sidebar, 0.28, {BackgroundColor3 = th.Sidebar})
                self.Sidebar.ScrollBarImageColor3 = th.Accent
            end

            for _, tab in ipairs(self.Tabs) do
                if tab.Label then
                    soft(tab.Label, 0.22, {
                        TextColor3 = (self.ActiveTab == tab) and th.Text or th.Muted
                    })
                end
                if tab.Indicator then
                    soft(tab.Indicator, 0.22, {BackgroundColor3 = th.Accent})
                end
                if tab.View then
                    tab.View.ScrollBarImageColor3 = th.Accent
                end
            end

            for n, data in pairs(themeBtns) do
                local sel = n == themeName
                soft(data.btn, 0.2, {
                    BackgroundTransparency = sel and 0.15 or 1,
                    BackgroundColor3 = sel and th.Accent or th.Card
                })
                soft(data.label, 0.2, {
                    TextColor3 = sel and Color3.new(1, 1, 1) or th.Text
                })
            end

            self:Notify({Title = "Theme", Content = "Switched to " .. themeName, Duration = 1.6})
        end

        local themeNames = {"Default", "Light", "Cyber", "Ocean", "Rose", "Emerald"}
        for _, tName in ipairs(themeNames) do
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, 0, 0, 28)
            b.BackgroundColor3 = self.Theme.Accent
            b.BackgroundTransparency = (tName == self.CurrentTheme) and 0.15 or 1
            b.Text = ""
            b.AutoButtonColor = false
            b.ZIndex = 31
            b.Parent = themePanel
            corner(b, 8)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = tName
            lbl.TextColor3 = (tName == self.CurrentTheme) and Color3.new(1, 1, 1) or self.Theme.Text
            lbl.TextSize = 12
            lbl.Font = Enum.Font.GothamMedium
            lbl.ZIndex = 32
            lbl.Parent = b

            themeBtns[tName] = {btn = b, label = lbl}

            b.MouseEnter:Connect(function()
                if tName ~= self.CurrentTheme then
                    tween(b, 0.12, {BackgroundTransparency = 0.65})
                end
            end)
            b.MouseLeave:Connect(function()
                if tName ~= self.CurrentTheme then
                    tween(b, 0.12, {BackgroundTransparency = 1})
                end
            end)
            b.MouseButton1Click:Connect(function()
                setTheme(tName)
            end)
        end

        gear.MouseButton1Click:Connect(function()
            themeOpen = not themeOpen
            if themeOpen then
                themePanel.Visible = true
                themePanel.Size = UDim2.fromOffset(148, 0)
                spring(themePanel, 0.32, {Size = UDim2.fromOffset(148, 6 + (#themeNames * 33))})
            else
                soft(themePanel, 0.22, {Size = UDim2.fromOffset(148, 0)})
                task.delay(0.24, function()
                    if not themeOpen then themePanel.Visible = false end
                end)
            end
        end)

        minBtn.MouseButton1Click:Connect(function()
            self.Minimized = not self.Minimized
            if self.Minimized then
                if themeOpen then
                    themeOpen = false
                    themePanel.Visible = false
                end
                soft(main, 0.28, {Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 42)})
                soft(glow, 0.25, {ImageTransparency = 1})
            else
                spring(main, 0.34, {Size = size})
                soft(glow, 0.32, {ImageTransparency = 0.9})
            end
        end)

        closeBtn.MouseButton1Click:Connect(function()
            self:DisableAllAndDestroy()
        end)

        -- Dragging
        local dragging, start, startPos
        header.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                start = inp.Position
                startPos = main.Position
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                local d = inp.Position - start
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        -- Sidebar
        local sidebar = Instance.new("ScrollingFrame")
        sidebar.Size = UDim2.new(0, 124, 1, -42)
        sidebar.Position = UDim2.new(0, 0, 0, 42)
        sidebar.BackgroundColor3 = self.Theme.Sidebar
        sidebar.BackgroundTransparency = 0.08
        sidebar.BorderSizePixel = 0
        sidebar.ScrollBarThickness = 2
        sidebar.ScrollBarImageColor3 = self.Theme.Accent
        sidebar.ScrollBarImageTransparency = 0.45
        sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
        sidebar.Parent = main

        local sLayout = Instance.new("UIListLayout")
        sLayout.Padding = UDim.new(0, 4)
        sLayout.Parent = sidebar
        padding(sidebar, 10, 8, 10, 8)

        sLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            sidebar.CanvasSize = UDim2.new(0, 0, 0, sLayout.AbsoluteContentSize.Y + 16)
        end)

        local container = Instance.new("Frame")
        container.Size = UDim2.new(1, -124, 1, -42)
        container.Position = UDim2.new(0, 124, 0, 42)
        container.BackgroundTransparency = 1
        container.Parent = main

        self.ScreenName = screenName
        self.Screen = screen
        self.Main = main
        self.NotifContainer = notifHolder
        self.Container = container
        self.Sidebar = sidebar
        self.TargetSize = size
        self.Glow = glow
        self.MainStroke = mainStroke

        task.delay(0.45, function()
            self:Notify({Title = "PhantomLib", Content = "Interface loaded", Duration = 2})
        end)

        return self
    end

    if opts.KeySystem then
        self:CreateKeySystem(opts.KeySystem, function()
            finishCreate()
        end)
        return self
    else
        return finishCreate()
    end
end

