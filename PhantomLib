function PhantomLib:CreateWindow(options)
    options = options or {}
    local windowName = options.Name or "Phantom Window"
    local guiParent  = getGuiParent()
    local screenName = "PhantomLib_" .. windowName:gsub("%s+", "_")

    if getgenv()._PhantomLib_Instances[screenName] then
        pcall(function()
            getgenv()._PhantomLib_Instances[screenName]:DisableAllAndDestroy()
        end)
    else
        local existing = guiParent:FindFirstChild(screenName)
        if existing then existing:Destroy() end
    end

    local self = setmetatable({}, PhantomLib)
    self.Theme         = PhantomLib.Themes[options.Theme] or PhantomLib.Themes.Default
    self.CurrentTheme  = options.Theme or "Default"
    self.Tabs          = {}
    self.ActiveTab     = nil
    self.Flags         = {}
    self.ToggleObjects = {}
    self.Minimized     = false
    getgenv()._PhantomLib_Instances[screenName] = self

    local screen = Instance.new("ScreenGui")
    screen.Name = screenName
    screen.ResetOnSpawn = false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.Parent = guiParent

    -- Notification container
    local notifContainer = Instance.new("Frame")
    notifContainer.Size = UDim2.new(0, 280, 1, -24)
    notifContainer.Position = UDim2.new(1, -16, 1, -16)
    notifContainer.AnchorPoint = Vector2.new(1, 1)
    notifContainer.BackgroundTransparency = 1
    notifContainer.Parent = screen

    local notifLayout = Instance.new("UIListLayout")
    notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    notifLayout.Padding = UDim.new(0, 8)
    notifLayout.Parent = notifContainer

    local targetSize = options.Size or UDim2.fromOffset(510, 315)

    -- Main window
    local main = Instance.new("Frame")
    main.Name = "Main"
    main.Size = UDim2.fromOffset(0, 0)
    main.Position = UDim2.new(0.5, 0, 0.5, 0)
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.BackgroundColor3 = self.Theme.Background
    main.BorderSizePixel = 0
    main.ClipsDescendants = true
    main.Parent = screen
    createCorner(main, 10)
    local mainStroke = createStroke(main, self.Theme.Border, 1, 0.3)

    -- Soft outer glow
    local glow = Instance.new("ImageLabel")
    glow.Name = "Glow"
    glow.Size = UDim2.new(1, 40, 1, 40)
    glow.Position = UDim2.new(0.5, 0, 0.5, 0)
    glow.AnchorPoint = Vector2.new(0.5, 0.5)
    glow.BackgroundTransparency = 1
    glow.Image = "rbxassetid://5028857084"
    glow.ImageColor3 = self.Theme.Accent
    glow.ImageTransparency = 0.85
    glow.ScaleType = Enum.ScaleType.Slice
    glow.SliceCenter = Rect.new(24, 24, 276, 276)
    glow.ZIndex = 0
    glow.Parent = main

    -- Open animation
    spring(main, 0.45, {
        Size = targetSize,
        Position = UDim2.new(0.5, -targetSize.X.Offset / 2, 0.5, -targetSize.Y.Offset / 2),
        AnchorPoint = Vector2.new(0, 0)
    })

    -- ── Header ───────────────────────────────
    local header = Instance.new("Frame")
    header.Name = "Header"
    header.Size = UDim2.new(1, 0, 0, 34)
    header.BackgroundColor3 = self.Theme.Sidebar
    header.BorderSizePixel = 0
    header.Parent = main
    createCorner(header, 10)

    local headerFill = Instance.new("Frame")
    headerFill.Size = UDim2.new(1, 0, 0, 14)
    headerFill.Position = UDim2.new(0, 0, 1, -14)
    headerFill.BackgroundColor3 = self.Theme.Sidebar
    headerFill.BorderSizePixel = 0
    headerFill.Parent = header

    local headerAccent = Instance.new("Frame")
    headerAccent.Size = UDim2.new(1, 0, 0, 1)
    headerAccent.Position = UDim2.new(0, 0, 1, -1)
    headerAccent.BackgroundColor3 = self.Theme.Accent
    headerAccent.BackgroundTransparency = 0.6
    headerAccent.BorderSizePixel = 0
    headerAccent.Parent = header

    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(0, 160, 1, 0)
    title.Position = UDim2.new(0, 12, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = windowName
    title.TextColor3 = self.Theme.Text
    title.TextSize = 13
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = header

    -- Right side: FPS + Ping + Controls
    local rightSide = Instance.new("Frame")
    rightSide.Size = UDim2.new(0, 210, 1, 0)
    rightSide.Position = UDim2.new(1, -218, 0, 0)
    rightSide.BackgroundTransparency = 1
    rightSide.Parent = header

    -- FPS + Ping
    local statsFrame = Instance.new("Frame")
    statsFrame.Size = UDim2.new(0, 115, 1, 0)
    statsFrame.Position = UDim2.new(0, 0, 0, 0)
    statsFrame.BackgroundTransparency = 1
    statsFrame.Parent = rightSide

    local fpsLabel = Instance.new("TextLabel")
    fpsLabel.Size = UDim2.new(0.5, -2, 1, 0)
    fpsLabel.BackgroundTransparency = 1
    fpsLabel.Text = "FPS --"
    fpsLabel.TextColor3 = self.Theme.Muted
    fpsLabel.TextSize = 11
    fpsLabel.Font = Enum.Font.GothamMedium
    fpsLabel.TextXAlignment = Enum.TextXAlignment.Right
    fpsLabel.Parent = statsFrame

    local pingLabel = Instance.new("TextLabel")
    pingLabel.Size = UDim2.new(0.5, -2, 1, 0)
    pingLabel.Position = UDim2.new(0.5, 2, 0, 0)
    pingLabel.BackgroundTransparency = 1
    pingLabel.Text = "ms --"
    pingLabel.TextColor3 = self.Theme.Muted
    pingLabel.TextSize = 11
    pingLabel.Font = Enum.Font.GothamMedium
    pingLabel.TextXAlignment = Enum.TextXAlignment.Left
    pingLabel.Parent = statsFrame

    -- Live FPS + Ping
    local fpsValue = 60
    local lastUpdate = 0
    RunService.RenderStepped:Connect(function(dt)
        fpsValue = math.floor(1 / math.max(dt, 0.001))
        if tick() - lastUpdate > 0.35 then
            lastUpdate = tick()
            fpsLabel.Text = "FPS " .. tostring(fpsValue)

            local pingMs = 0
            pcall(function()
                pingMs = math.floor(LocalPlayer:GetNetworkPing() * 1000)
            end)
            pingLabel.Text = pingMs .. "ms"

            if fpsValue >= 55 then
                fpsLabel.TextColor3 = self.Theme.Success
            elseif fpsValue >= 35 then
                fpsLabel.TextColor3 = Color3.fromRGB(250, 190, 60)
            else
                fpsLabel.TextColor3 = self.Theme.Danger
            end

            if pingMs <= 70 then
                pingLabel.TextColor3 = self.Theme.Success
            elseif pingMs <= 130 then
                pingLabel.TextColor3 = Color3.fromRGB(250, 190, 60)
            else
                pingLabel.TextColor3 = self.Theme.Danger
            end
        end
    end)

    -- Controls
    local controls = Instance.new("Frame")
    controls.Size = UDim2.new(0, 90, 1, 0)
    controls.Position = UDim2.new(1, -92, 0, 0)
    controls.BackgroundTransparency = 1
    controls.Parent = rightSide

    local function makeControlBtn(text, color, posX, textSize)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.fromOffset(24, 24)
        btn.Position = UDim2.new(0, posX, 0.5, -12)
        btn.BackgroundColor3 = color
        btn.BackgroundTransparency = 1
        btn.Text = text
        btn.TextColor3 = self.Theme.Text
        btn.TextSize = textSize or 14
        btn.Font = Enum.Font.GothamBold
        btn.AutoButtonColor = false
        btn.Parent = controls
        createCorner(btn, 6)

        btn.MouseEnter:Connect(function()
            tween(btn, 0.15, { BackgroundTransparency = 0.6 })
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, 0.15, { BackgroundTransparency = 1 })
        end)
        return btn
    end

    local gearBtn     = makeControlBtn("⚙", self.Theme.Card, 0, 15)
    local minimizeBtn = makeControlBtn("–", self.Theme.Card, 30)
    local closeBtn    = makeControlBtn("×", self.Theme.Danger, 60)
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

    -- Theme Switcher Panel
    local themePanel = Instance.new("Frame")
    themePanel.Name = "ThemePanel"
    themePanel.Size = UDim2.fromOffset(148, 0)
    themePanel.Position = UDim2.new(1, -158, 0, 38)
    themePanel.BackgroundColor3 = self.Theme.Card
    themePanel.BackgroundTransparency = 0.04
    themePanel.Visible = false
    themePanel.ClipsDescendants = true
    themePanel.ZIndex = 20
    themePanel.Parent = main
    createCorner(themePanel, 8)
    local themeStroke = createStroke(themePanel, self.Theme.Accent, 1, 0.35)

    local themeLayout = Instance.new("UIListLayout")
    themeLayout.Padding = UDim.new(0, 4)
    themeLayout.Parent = themePanel

    local themePad = Instance.new("UIPadding")
    themePad.PaddingTop = UDim.new(0, 6)
    themePad.PaddingBottom = UDim.new(0, 6)
    themePad.PaddingLeft = UDim.new(0, 6)
    themePad.PaddingRight = UDim.new(0, 6)
    themePad.Parent = themePanel

    local themeOpen = false
    local themeButtons = {}

    local function applyTheme(themeName)
        local newTheme = PhantomLib.Themes[themeName]
        if not newTheme then return end
        self.Theme = newTheme
        self.CurrentTheme = themeName

        tween(main, 0.3, { BackgroundColor3 = newTheme.Background })
        tween(header, 0.3, { BackgroundColor3 = newTheme.Sidebar })
        tween(headerFill, 0.3, { BackgroundColor3 = newTheme.Sidebar })
        tween(headerAccent, 0.3, { BackgroundColor3 = newTheme.Accent })
        tween(title, 0.25, { TextColor3 = newTheme.Text })
        tween(mainStroke, 0.3, { Color = newTheme.Border })
        tween(glow, 0.35, { ImageColor3 = newTheme.Accent })
        tween(themePanel, 0.25, { BackgroundColor3 = newTheme.Card })
        tween(themeStroke, 0.25, { Color = newTheme.Accent })

        if self.Sidebar then
            tween(self.Sidebar, 0.3, { BackgroundColor3 = newTheme.Sidebar })
            self.Sidebar.ScrollBarImageColor3 = newTheme.Accent
        end

        for _, tab in ipairs(self.Tabs) do
            if tab.Label then
                local isActive = (self.ActiveTab == tab)
                tween(tab.Label, 0.25, { TextColor3 = isActive and newTheme.Text or newTheme.Muted })
            end
            if tab.Indicator then
                tween(tab.Indicator, 0.25, { BackgroundColor3 = newTheme.Accent })
            end
            if tab.View then
                tab.View.ScrollBarImageColor3 = newTheme.Accent
            end
        end

        for name, btnData in pairs(themeButtons) do
            local isSelected = (name == themeName)
            tween(btnData.btn, 0.2, {
                BackgroundTransparency = isSelected and 0.25 or 1,
                BackgroundColor3 = isSelected and newTheme.Accent or newTheme.Card
            })
            tween(btnData.label, 0.2, {
                TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or newTheme.Text
            })
        end

        self:Notify({
            Title = "Theme Changed",
            Content = "Switched to " .. themeName,
            Duration = 2
        })
    end

    local themeOrder = {"Default", "Light", "Cyber", "Ocean"}
    for _, themeName in ipairs(themeOrder) do
        local tBtn = Instance.new("TextButton")
        tBtn.Size = UDim2.new(1, 0, 0, 26)
        tBtn.BackgroundColor3 = self.Theme.Accent
        tBtn.BackgroundTransparency = (themeName == self.CurrentTheme) and 0.25 or 1
        tBtn.Text = ""
        tBtn.AutoButtonColor = false
        tBtn.ZIndex = 21
        tBtn.Parent = themePanel
        createCorner(tBtn, 5)

        local tLabel = Instance.new("TextLabel")
        tLabel.Size = UDim2.new(1, 0, 1, 0)
        tLabel.BackgroundTransparency = 1
        tLabel.Text = themeName
        tLabel.TextColor3 = (themeName == self.CurrentTheme) and Color3.fromRGB(255, 255, 255) or self.Theme.Text
        tLabel.TextSize = 12
        tLabel.Font = Enum.Font.GothamMedium
        tLabel.ZIndex = 22
        tLabel.Parent = tBtn

        themeButtons[themeName] = { btn = tBtn, label = tLabel }

        tBtn.MouseEnter:Connect(function()
            if themeName ~= self.CurrentTheme then
                tween(tBtn, 0.15, { BackgroundTransparency = 0.65 })
            end
        end)
        tBtn.MouseLeave:Connect(function()
            if themeName ~= self.CurrentTheme then
                tween(tBtn, 0.15, { BackgroundTransparency = 1 })
            end
        end)
        tBtn.MouseButton1Click:Connect(function()
            applyTheme(themeName)
        end)
    end

    gearBtn.MouseButton1Click:Connect(function()
        themeOpen = not themeOpen
        if themeOpen then
            themePanel.Visible = true
            themePanel.Size = UDim2.fromOffset(148, 0)
            spring(themePanel, 0.32, { Size = UDim2.fromOffset(148, 128) })
        else
            tween(themePanel, 0.22, { Size = UDim2.fromOffset(148, 0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            task.delay(0.23, function()
                if not themeOpen then themePanel.Visible = false end
            end)
        end
    end)

    -- Minimize
    minimizeBtn.MouseButton1Click:Connect(function()
        self.Minimized = not self.Minimized
        if self.Minimized then
            if themeOpen then
                themeOpen = false
                themePanel.Visible = false
            end
            tween(main, 0.28, { Size = UDim2.new(targetSize.X.Scale, targetSize.X.Offset, 0, 34) })
            tween(glow, 0.28, { ImageTransparency = 1 })
        else
            tween(main, 0.32, { Size = targetSize }, Enum.EasingStyle.Back)
            tween(glow, 0.32, { ImageTransparency = 0.85 })
        end
    end)

    -- Close
    closeBtn.MouseButton1Click:Connect(function()
        self:DisableAllAndDestroy()
    end)

    -- Dragging
    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Sidebar
    local sidebar = Instance.new("ScrollingFrame")
    sidebar.Name = "Sidebar"
    sidebar.Size = UDim2.new(0, 118, 1, -34)
    sidebar.Position = UDim2.new(0, 0, 0, 34)
    sidebar.BackgroundColor3 = self.Theme.Sidebar
    sidebar.BorderSizePixel = 0
    sidebar.ScrollBarThickness = 2
    sidebar.ScrollBarImageColor3 = self.Theme.Accent
    sidebar.ScrollBarImageTransparency = 0.4
    sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
    sidebar.Parent = main

    local sidebarLayout = Instance.new("UIListLayout")
    sidebarLayout.Padding = UDim.new(0, 4)
    sidebarLayout.Parent = sidebar

    local sidebarPad = Instance.new("UIPadding")
    sidebarPad.PaddingTop = UDim.new(0, 8)
    sidebarPad.PaddingLeft = UDim.new(0, 6)
    sidebarPad.PaddingRight = UDim.new(0, 6)
    sidebarPad.PaddingBottom = UDim.new(0, 8)
    sidebarPad.Parent = sidebar

    sidebarLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        sidebar.CanvasSize = UDim2.new(0, 0, 0, sidebarLayout.AbsoluteContentSize.Y + 16)
    end)

    -- Content container
    local container = Instance.new("Frame")
    container.Name = "Container"
    container.Size = UDim2.new(1, -118, 1, -34)
    container.Position = UDim2.new(0, 118, 0, 34)
    container.BackgroundTransparency = 1
    container.Parent = main

    self.ScreenName     = screenName
    self.Screen         = screen
    self.Main           = main
    self.NotifContainer = notifContainer
    self.Container      = container
    self.Sidebar        = sidebar
    self.TargetSize     = targetSize
    self.Glow           = glow
    self.MainStroke     = mainStroke

    task.delay(0.4, function()
        self:Notify({
            Title = "PhantomLib",
            Content = "Interface loaded successfully",
            Duration = 2.6
        })
    end)

    return self
end

-- ─────────────────────────────────────────────
-- Notifications
-- ─────────────────────────────────────────────
function PhantomLib:Notify(cfg)
    cfg = cfg or {}
    local duration = cfg.Duration or 3.2

    local toast = Instance.new("Frame")
    toast.Size = UDim2.new(0, 260, 0, 0)
    toast.BackgroundColor3 = self.Theme.Card
    toast.BackgroundTransparency = 1
    toast.ClipsDescendants = true
    toast.Parent = self.NotifContainer
    createCorner(toast, 8)
    local stroke = createStroke(toast, self.Theme.Accent, 1, 1)

    local accentBar = Instance.new("Frame")
    accentBar.Size = UDim2.new(0, 3, 1, 0)
    accentBar.BackgroundColor3 = self.Theme.Accent
    accentBar.BorderSizePixel = 0
    accentBar.Parent = toast
    createCorner(accentBar, 2)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 16)
    title.Position = UDim2.new(0, 14, 0, 8)
    title.BackgroundTransparency = 1
    title.Text = cfg.Title or "Notification"
    title.TextColor3 = self.Theme.Text
    title.TextSize = 12
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextTransparency = 1
    title.Parent = toast

    local desc = Instance.new("TextLabel")
    desc.Size = UDim2.new(1, -20, 0, 16)
    desc.Position = UDim2.new(0, 14, 0, 26)
    desc.BackgroundTransparency = 1
    desc.Text = cfg.Content or ""
    desc.TextColor3 = self.Theme.Muted
    desc.TextSize = 11
    desc.Font = Enum.Font.Gotham
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.TextTransparency = 1
    desc.Parent = toast

    tween(toast, 0.35, { Size = UDim2.new(0, 260, 0, 52), BackgroundTransparency = 0 }, Enum.EasingStyle.Back)
    tween(stroke, 0.3, { Transparency = 0.35 })
    tween(title, 0.25, { TextTransparency = 0 })
    tween(desc, 0.3, { TextTransparency = 0 })

    task.delay(duration, function()
        if not toast or not toast.Parent then return end
        tween(toast, 0.25, { BackgroundTransparency = 1, Size = UDim2.new(0, 260, 0, 0) })
        tween(stroke, 0.2, { Transparency = 1 })
        tween(title, 0.2, { TextTransparency = 1 })
        tween(desc, 0.2, { TextTransparency = 1 })
        task.wait(0.28)
        if toast then toast:Destroy() end
    end)
end

