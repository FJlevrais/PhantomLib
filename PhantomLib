                check.Size = UDim2.fromOffset(18, 18)
                check.Position = UDim2.new(1, -24, 0.5, -9)
                check.BackgroundTransparency = 1
                check.Text = isSelected and "✓" or ""
                check.TextColor3 = self.Window.Theme.Accent
                check.TextSize = 14
                check.Font = Enum.Font.GothamBold
                check.ZIndex = 8
                check.Parent = b

                b.MouseEnter:Connect(function()
                    if opt ~= selected then
                        tween(b, 0.12, {BackgroundTransparency = 0.4})
                    end
                end)
                b.MouseLeave:Connect(function()
                    if opt ~= selected then
                        tween(b, 0.12, {BackgroundTransparency = 0.65})
                    end
                end)
                b.MouseButton1Click:Connect(function()
                    selected = opt
                    valueLbl.Text = tostring(selected)
                    title.TextColor3 = self.Window.Theme.Text
                    if cfg.Flag then self.Window.Flags[cfg.Flag] = selected end
                    if cfg.Callback then pcall(cfg.Callback, selected) end
                    setOpen(false)
                end)
                optionButtons[opt] = b
            end
            
            updateDropdownHeight(#filteredOptions)
        end

        searchInput:GetPropertyChangedSignal("Text"):Connect(function()
            buildOptions(searchInput.Text)
        end)

        local function setOpen(state)
            isOpen = state
            if isOpen then
                buildOptions("")
                content.Visible = true
                content.Size = UDim2.new(1, -8, 0, 0)
                spring(content, 0.3, {Size = UDim2.new(1, -8, 0, 120)})
                tween(arrow, 0.2, {Rotation = 180})
                spring(frame, 0.3, {Size = UDim2.new(1, 0, 0, 38 + 8 + 120)})
                task.wait(0.1)
                searchInput:CaptureFocus()
            else
                spring(frame, 0.26, {Size = UDim2.new(1, 0, 0, 38)})
                tween(arrow, 0.2, {Rotation = 0})
                tween(content, 0.22, {Size = UDim2.new(1, -8, 0, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
                task.delay(0.24, function()
                    if not isOpen then
                        content.Visible = false
                        content.Size = UDim2.new(1, -8, 0, 0)
                    end
                end)
            end
        end

        trigger.MouseButton1Click:Connect(function()
            setOpen(not isOpen)
        end)

        searchInput.FocusLost:Connect(function()
            task.delay(0.15, function()
                if isOpen and not searchInput:IsFocused() then
                    setOpen(false)
                end
            end)
        end)

        local obj = {}
        function obj:SetOptions(newOptions)
            options = newOptions or {}
            if not table.find(options, selected) then
                selected = options[1] or ""
                valueLbl.Text = tostring(selected)
                title.TextColor3 = selected ~= "" and self.Window.Theme.Text or self.Window.Theme.Muted
            end
            if isOpen then buildOptions(searchInput.Text) end
        end
        function obj:Get() return selected end
        function obj:Set(value)
            if table.find(options, value) or value == "" then
                selected = value
                valueLbl.Text = tostring(selected)
                title.TextColor3 = selected ~= "" and self.Window.Theme.Text or self.Window.Theme.Muted
                if cfg.Flag then self.Window.Flags[cfg.Flag] = selected end
                if cfg.Callback then pcall(cfg.Callback, selected) end
                if isOpen then buildOptions(searchInput.Text) end
            end
        end

        if cfg.Flag then self.Window.Flags[cfg.Flag] = selected end
        return obj
    end

    -- NEW: SEARCHABLE LIST ELEMENT (FIXED - No variable shadowing)
    function tab:CreateSearchableList(cfg)
        cfg = cfg or {}
        local options = cfg.Options or {}
        local maxVisible = cfg.MaxVisible or 6
        local itemHeight = cfg.ItemHeight or 28

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 0)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.BackgroundTransparency = 0.25
        frame.ClipsDescendants = true
        frame.Parent = view
        corner(frame, 9)
        stroke(frame, self.Window.Theme.Border, 1, 0.45)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, -16, 0, 28)
        title.Position = UDim2.new(0, 14, 0, 6)
        title.BackgroundTransparency = 1
        title.Text = cfg.Name or "List"
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 13
        title.Font = Enum.Font.GothamBold
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame

        -- Create searchable list using the utility function
        local listData = createSearchableList(frame, options, {
            Theme = self.Window.Theme,
            ItemHeight = itemHeight,
            MaxVisible = maxVisible,
            SearchPlaceholder = cfg.SearchPlaceholder or "Search items...",
            OnSelect = function(opt, btn, check)
                -- Toggle selection
                local currentlySelected = listData.SelectedItems[opt] == true
                if currentlySelected then
                    listData.SelectedItems[opt] = nil
                else
                    listData.SelectedItems[opt] = true
                end
                
                -- Update visual
                local isSelected = listData.SelectedItems[opt] == true
                tween(btn, 0.15, {
                    BackgroundColor3 = isSelected and self.Window.Theme.Accent or self.Window.Theme.Card,
                    BackgroundTransparency = isSelected and 0.3 or 0.65
                })
                check.Text = isSelected and "✓" or ""
                
                -- Update title
                local selectedList = listData:GetSelected()
                if #selectedList == 0 then
                    title.Text = cfg.Name or "List"
                    title.TextColor3 = self.Window.Theme.Muted
                elseif #selectedList == 1 then
                    title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. tostring(selectedList[1])
                    title.TextColor3 = self.Window.Theme.Text
                else
                    title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. #selectedList .. " selected"
                    title.TextColor3 = self.Window.Theme.Text
                end
                
                if cfg.Flag then
                    self.Window.Flags[cfg.Flag] = listData:GetSelected()
                end
                if cfg.Callback then
                    pcall(cfg.Callback, listData:GetSelected())
                end
                
                -- Update frame height (slight delay to let layout settle)
                task.wait(0.05)
                updateFrameHeight()
            end
        })

        -- Position list in frame
        listData.Container.Position = UDim2.new(0, 8, 0, 38)
        listData.Container.Size = UDim2.new(1, -16, 0, 0)
        listData.Container.Parent = frame

        -- Set initial selected
        if cfg.CurrentOptions then
            listData:SetSelected(cfg.CurrentOptions)
            -- Update title
            local selectedList = listData:GetSelected()
            if #selectedList == 0 then
                title.Text = cfg.Name or "List"
                title.TextColor3 = self.Window.Theme.Muted
            elseif #selectedList == 1 then
                title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. tostring(selectedList[1])
                title.TextColor3 = self.Window.Theme.Text
            else
                title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. #selectedList .. " selected"
                title.TextColor3 = self.Window.Theme.Text
            end
        end

        -- Update frame height
        local function updateFrameHeight()
            local h = listData.Container.Size.Y.Offset + 48
            frame.Size = UDim2.new(1, 0, 0, h)
        end

        -- Hook into container size changes
        local sizeConnection
        sizeConnection = listData.Container:GetPropertyChangedSignal("Size"):Connect(function()
            updateFrameHeight()
        end)
        
        -- Initial height update
        task.wait(0.05)
        updateFrameHeight()

        -- Store connection for cleanup
        frame._sizeConnection = sizeConnection

        local obj = {}
        function obj:SetOptions(newOptions)
            options = newOptions or {}
            listData:SetOptions(newOptions)
            -- Update title
            local selectedList = listData:GetSelected()
            if #selectedList == 0 then
                title.Text = cfg.Name or "List"
                title.TextColor3 = self.Window.Theme.Muted
            elseif #selectedList == 1 then
                title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. tostring(selectedList[1])
                title.TextColor3 = self.Window.Theme.Text
            else
                title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. #selectedList .. " selected"
                title.TextColor3 = self.Window.Theme.Text
            end
            task.wait(0.05)
            updateFrameHeight()
        end
        function obj:Get() 
            local result = listData:GetSelected()
            -- Ensure we return a table, not nil
            return result or {}
        end
        function obj:Set(values)
            listData:SetSelected(values or {})
            -- Update title
            local selectedList = listData:GetSelected()
            if #selectedList == 0 then
                title.Text = cfg.Name or "List"
                title.TextColor3 = self.Window.Theme.Muted
            elseif #selectedList == 1 then
                title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. tostring(selectedList[1])
                title.TextColor3 = self.Window.Theme.Text
            else
                title.Text = (cfg.Name and (cfg.Name .. ": ") or "") .. #selectedList .. " selected"
                title.TextColor3 = self.Window.Theme.Text
            end
            if cfg.Flag then self.Window.Flags[cfg.Flag] = listData:GetSelected() end
            if cfg.Callback then pcall(cfg.Callback, listData:GetSelected()) end
            task.wait(0.05)
            updateFrameHeight()
        end
        function obj:Clear()
            listData:Clear()
            title.Text = cfg.Name or "List"
            title.TextColor3 = self.Window.Theme.Muted
            if cfg.Flag then self.Window.Flags[cfg.Flag] = {} end
            if cfg.Callback then pcall(cfg.Callback, {}) end
            task.wait(0.05)
            updateFrameHeight()
        end
        function obj:Search(text)
            listData.SearchInput.Text = text or ""
        end

        if cfg.Flag then self.Window.Flags[cfg.Flag] = listData:GetSelected() end
        return obj
    end

    return tab
end

function PhantomLib:DisableAllAndDestroy()
    if self.ToggleObjects then
        for _, t in ipairs(self.ToggleObjects) do
            if t:Get() then t:Set(false) end
        end
    end
    if self.ScreenName and getgenv()._PhantomLib_Instances then
        getgenv()._PhantomLib_Instances[self.ScreenName] = nil
    end
    self:Destroy()
end

function PhantomLib:Destroy()
    if not self.Screen or not self.Main then return end
    local main = self.Main
    local glow = self.Glow
    local stroke = self.MainStroke

    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = main

    if glow then tween(glow, 0.22, {ImageTransparency = 1}) end
    if stroke then tween(stroke, 0.2, {Transparency = 1}) end

    tween(scale, 0.28, {Scale = 0.9}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    tween(main, 0.28, {
        BackgroundTransparency = 0.4,
        Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset + 20, main.Position.Y.Scale, main.Position.Y.Offset - 14)
    }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

    task.wait(0.18)
    tween(scale, 0.22, {Scale = 0}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    tween(main, 0.22, {
        BackgroundTransparency = 1,
        Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset + 38, main.Position.Y.Scale, main.Position.Y.Offset - 30)
    }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

    task.wait(0.24)
    if self.Screen then self.Screen:Destroy() end
end

return PhantomLib
