function PhantomLib:Notify(cfg)
    cfg = cfg or {}
    local toast = Instance.new("Frame", self.NotifContainer)
    toast.Size = UDim2.new(1, 0, 0, 56)
    toast.BackgroundColor3 = self.Theme.Card
    toast.BackgroundTransparency = 1
    Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 8)
    
    local stroke = Instance.new("UIStroke", toast)
    stroke.Color = self.Theme.Border; stroke.Transparency = 1

    local title = Instance.new("TextLabel", toast)
    title.Size = UDim2.new(1, -20, 0, 18); title.Position = UDim2.new(0, 10, 0, 8)
    title.BackgroundTransparency = 1; title.Text = cfg.Title or "Notification"; title.TextColor3 = self.Theme.Text
    title.TextSize = 13; title.Font = Enum.Font.GothamBold; title.TextXAlignment = Enum.TextXAlignment.Left; title.TextTransparency = 1

    local desc = Instance.new("TextLabel", toast)
    desc.Size = UDim2.new(1, -20, 0, 18); desc.Position = UDim2.new(0, 10, 0, 28)
    desc.BackgroundTransparency = 1; desc.Text = cfg.Content or ""; desc.TextColor3 = self.Theme.Muted
    desc.TextSize = 11; desc.Font = Enum.Font.Gotham; desc.TextXAlignment = Enum.TextXAlignment.Left; desc.TextTransparency = 1

    smoothTween(toast, 0.3, {BackgroundTransparency = 0})
    smoothTween(stroke, 0.3, {Transparency = 0})
    smoothTween(title, 0.3, {TextTransparency = 0})
    smoothTween(desc, 0.3, {TextTransparency = 0})

    task.delay(cfg.Duration or 3.5, function()
        smoothTween(toast, 0.3, {BackgroundTransparency = 1})
        smoothTween(stroke, 0.3, {Transparency = 1})
        smoothTween(title, 0.3, {TextTransparency = 1})
        smoothTween(desc, 0.3, {TextTransparency = 1})
        task.wait(0.3)
        toast:Destroy()
    end)
end

