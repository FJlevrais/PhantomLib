        hueTrack.Position = UDim2.new(0, 12, 0, 52)
        hueTrack.Parent = frame
        Instance.new("UICorner", hueTrack).CornerRadius = UDim.new(0, 5)

        local gradient = Instance.new("UIGradient")
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,0,0)),
            ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255,255,0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0,255,255)),
            ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0,0,255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,0,0))
        })
        gradient.Parent = hueTrack

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 0)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = hueTrack

        local dragging = false
        local function update(input)
            local percent = math.clamp((input.Position.X - hueTrack.AbsolutePosition.X) / hueTrack.AbsoluteSize.X, 0, 1)
            currentColor = Color3.fromHSV(1 - percent, 1, 1)
            preview.BackgroundColor3 = currentColor
            if cfg.Flag then self.Window.Flags[cfg.Flag] = currentColor end
            if cfg.Callback then pcall(cfg.Callback, currentColor) end
        end

        trigger.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input)
            end
        end)

        preview.MouseButton1Click:Connect(function()
            expanded = not expanded
            tween(frame, 0.2, {Size = UDim2.new(1, 0, 0, expanded and 80 or 44)})
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = currentColor end
        register(name, frame)
    end

    return tabData
end

function PhantomLib:DisableAllAndDestroy()
    if self.ToggleObjects then
        for _, toggle in ipairs(self.ToggleObjects) do
            if toggle:Get() then toggle:Set(false) end
        end
    end
    if self.ScreenName and getgenv()._PhantomLib_Instances then
        getgenv()._PhantomLib_Instances[self.ScreenName] = nil
    end
    self:Destroy()
end

function PhantomLib:Destroy()
    if self.Screen then
        if self.Main then
            tween(self.Main, 0.18, {BackgroundTransparency = 1})
        end
        task.wait(0.18)
        self.Screen:Destroy()
    end
end

return PhantomLib
