-- // Utility
local function tween(obj, duration, props, style, dir)
    local info = TweenInfo.new(duration or 0.25, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function getGuiParent()
    local ok, result = pcall(function() return CoreGui end)
    return (ok and result) and result or LocalPlayer:WaitForChild("PlayerGui")
end

local function create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

-- // Main
function PhantomLib:CreateWindow(options)
    options = options or {}
    local self = setmetatable({}, PhantomLib)

    self.Theme = PhantomLib.Themes[options.Theme] or PhantomLib.Themes.Default
    self.Tabs = {}
    self.ActiveTab = nil
    self.Flags = {}
    self.Closed = false

    local screen = create("ScreenGui", {
        Name = "PhantomLib",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = getGuiParent()
    })

    local notifContainer = create("Frame", {
        Size = UDim2.new(0, 280, 1, -30),
        Position = UDim2.new(1, -20, 1, -20),
        AnchorPoint = Vector2.new(1, 1),
        BackgroundTransparency = 1,
        Parent = screen
    })
    create("UIListLayout", {
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        Padding = UDim.new(0, 10),
        Parent = notifContainer
    })

    local main = create("Frame", {
        Name = "Main",
        Size = options.Size or UDim2.fromOffset(620, 440),
        Position = UDim2.new(0.5, -310, 0.5, -220),
        BackgroundColor3 = self.Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = screen
    })
    create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = main })
    create("UIStroke", { Color = self.Theme.Border, Thickness = 1, Parent = main })

    local header = create("Frame", {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = self.Theme.Sidebar,
        BorderSizePixel = 0,
        Parent = main
    })

    local title = create("TextLabel", {
        Size = UDim2.new(1, -80, 1, 0),
        Position = UDim2.new(0, 16, 0, 0),
        BackgroundTransparency = 1,
        Text = options.Name or "Phantom Window",
        TextColor3 = self.Theme.Text,
        TextSize = 15,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = header
    })

    local closeBtn = create("TextButton", {
        Size = UDim2.fromOffset(28, 28),
        Position = UDim2.new(1, -36, 0.5, -14),
        BackgroundColor3 = self.Theme.Card,
        Text = "×",
        TextColor3 = self.Theme.Muted,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        Parent = header
    })
    create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = closeBtn })

    closeBtn.MouseEnter:Connect(function()
        tween(closeBtn, 0.15, { BackgroundColor3 = self.Theme.Error, TextColor3 = Color3.new(1,1,1) })
    end)
    closeBtn.MouseLeave:Connect(function()
        tween(closeBtn, 0.15, { BackgroundColor3 = self.Theme.Card, TextColor3 = self.Theme.Muted })
    end)
    closeBtn.MouseButton1Click:Connect(function()
        self:Destroy()
    end)

    -- Dragging
    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local sidebar = create("Frame", {
        Size = UDim2.new(0, 150, 1, -42),
        Position = UDim2.new(0, 0, 0, 42),
        BackgroundColor3 = self.Theme.Sidebar,
        BorderSizePixel = 0,
        Parent = main
    })
    create("UIListLayout", { Padding = UDim.new(0, 5), Parent = sidebar })
    create("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
        Parent = sidebar
    })

    local container = create("Frame", {
        Size = UDim2.new(1, -150, 1, -42),
        Position = UDim2.new(0, 150, 0, 42),
        BackgroundTransparency = 1,
        Parent = main
    })

    self.Screen = screen
    self.Main = main
    self.NotifContainer = notifContainer
    self.Container = container
    self.Sidebar = sidebar
    self.ThemeName = options.Theme or "Default"

    task.defer(function()
        self:Notify({
            Title = "PhantomLib",
            Content = "Interface loaded successfully",
            Duration = 3,
            Type = "Success"
        })
    end)

    return self
end

-- // Notifications
function PhantomLib:Notify(cfg)
    cfg = cfg or {}
    local theme = self.Theme
    local notifType = cfg.Type or "Info"
    local accent = theme.Accent

    if notifType == "Success" then accent = theme.Success
    elseif notifType == "Error" then accent = theme.Error
    elseif notifType == "Warning" then accent = theme.Warning
    end

    local toast = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = theme.Sidebar,
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Parent = self.NotifContainer
    })
    create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = toast })

    local stroke = create("UIStroke", {
        Color = accent,
        Thickness = 1.5,
        Transparency = 1,
        Parent = toast
    })

    local bar = create("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = accent,
        BackgroundTransparency = 1,
        Parent = toast
    })
    create("UICorner", { CornerRadius = UDim.new(0, 2), Parent = bar })

    local title = create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 20),
        Position = UDim2.new(0, 16, 0, 8),
        BackgroundTransparency = 1,
        Text = cfg.Title or "Notification",
        TextColor3 = theme.Text,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTransparency = 1,
        Parent = toast
    })

    local desc = create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 18),
        Position = UDim2.new(0, 16, 0, 28),
        BackgroundTransparency = 1,
        Text = cfg.Content or "",
        TextColor3 = theme.Muted,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTransparency = 1,
        Parent = toast
    })

    tween(toast, 0.3, { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 0 })
    tween(stroke, 0.3, { Transparency = 0 })
    tween(bar, 0.3, { BackgroundTransparency = 0 })
    tween(title, 0.3, { TextTransparency = 0 })
    tween(desc, 0.3, { TextTransparency = 0 })

    task.delay(cfg.Duration or 4, function()
        tween(toast, 0.25, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0) })
        tween(stroke, 0.25, { Transparency = 1 })
        tween(bar, 0.25, { BackgroundTransparency = 1 })
        tween(title, 0.25, { TextTransparency = 1 })
        tween(desc, 0.25, { TextTransparency = 1 })
        task.wait(0.3)
        toast:Destroy()
    end)
end

-- // Tabs
function PhantomLib:CreateTab(tabName)
    local tabData = { Name = tabName, Window = self }

    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = self.Theme.Card,
        BackgroundTransparency = 1,
        Text = "  " .. (tabName or "Tab"),
        TextColor3 = self.Theme.Muted,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = self.Sidebar
    })
    create("UICorner", { CornerRadius = UDim.new(0, 7), Parent = btn })

    local view = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = self.Container
    })

    local layout = create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = view
    })
    create("UIPadding", {
        PaddingTop = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
        PaddingBottom = UDim.new(0, 12),
        Parent = view
    })

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        view.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)

    tabData.Button = btn
    tabData.View = view

    local function selectTab()
        for _, tab in ipairs(self.Tabs) do
            tab.View.Visible = false
            tween(tab.Button, 0.18, { BackgroundTransparency = 1, TextColor3 = self.Theme.Muted })
        end
        view.Visible = true
        tween(btn, 0.18, { BackgroundTransparency = 0, TextColor3 = self.Theme.Text })
        self.ActiveTab = tabData
    end

    btn.MouseButton1Click:Connect(selectTab)
    btn.MouseEnter:Connect(function()
        if self.ActiveTab \~= tabData then
            tween(btn, 0.15, { TextColor3 = self.Theme.Text })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab \~= tabData then
            tween(btn, 0.15, { TextColor3 = self.Theme.Muted })
        end
    end)

    if #self.Tabs == 0 then selectTab() end
    table.insert(self.Tabs, tabData)

    -- ========================
    -- ELEMENTS
    -- ========================

    function tabData:CreateSection(name)
        local section = create("Frame", {
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundTransparency = 1,
            Parent = view
        })
        create("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = name or "Section",
            TextColor3 = self.Window.Theme.Accent,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = section
        })
        return section
    end

    function tabData:CreateLabel(cfg)
        cfg = cfg or {}
        local frame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundTransparency = 1,
            Parent = view
        })
        local label = create("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = cfg.Text or cfg.Name or "Label",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Parent = frame
        })
        return { Set = function(_, text) label.Text = text end }
    end

    function tabData:CreateParagraph(cfg)
        cfg = cfg or {}
        local frame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = self.Window.Theme.Card,
            Parent = view
        })
        create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = frame })
        create("UIStroke", { Color = self.Window.Theme.Border, Parent = frame })

        local title = create("TextLabel", {
            Size = UDim2.new(1, -20, 0, 20),
            Position = UDim2.new(0, 12, 0, 10),
            BackgroundTransparency = 1,
            Text = cfg.Title or "Paragraph",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame
        })

        local content = create("TextLabel", {
            Size = UDim2.new(1, -20, 0, 0),
            Position = UDim2.new(0, 12, 0, 32),
            BackgroundTransparency = 1,
            Text = cfg.Content or "",
            TextColor3 = self.Window.Theme.Muted,
            TextSize = 12,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            Parent = frame
        })

        local function updateSize()
            local textSize = TextService:GetTextSize(content.Text, 12, Enum.Font.Gotham, Vector2.new(frame.AbsoluteSize.X - 24, 9999))
            content.Size = UDim2.new(1, -20, 0, textSize.Y)
            frame.Size = UDim2.new(1, 0, 0, textSize.Y + 48)
        end
        content:GetPropertyChangedSignal("Text"):Connect(updateSize)
        frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateSize)
        task.defer(updateSize)

        return { Set = function(_, newContent) content.Text = newContent end }
    end

    function tabData:CreateDivider()
        return create("Frame", {
            Size = UDim2.new(1, 0, 0, 1),
            BackgroundColor3 = self.Window.Theme.Border,
            BorderSizePixel = 0,
            Parent = view
        })
    end

    function tabData:CreateButton(cfg)
        cfg = cfg or {}
        local btn = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 38),
            BackgroundColor3 = self.Window.Theme.Card,
            Text = cfg.Name or "Button",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.GothamMedium,
            Parent = view
        })
        create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = btn })
        local stroke = create("UIStroke", { Color = self.Window.Theme.Border, Parent = btn })

        btn.MouseEnter:Connect(function()
            tween(btn, 0.15, { BackgroundColor3 = self.Window.Theme.Accent })
            tween(stroke, 0.15, { Color = self.Window.Theme.Accent })
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, 0.15, { BackgroundColor3 = self.Window.Theme.Card })
            tween(stroke, 0.15, { Color = self.Window.Theme.Border })
        end)
        btn.MouseButton1Click:Connect(function()
            if cfg.Callback then pcall(cfg.Callback) end
        end)
        return btn
    end

    function tabData:CreateToggle(cfg)
        cfg = cfg or {}
        local state = cfg.CurrentValue or false

        local frame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundColor3 = self.Window.Theme.Card,
            Parent = view
        })
        create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = frame })
        create("UIStroke", { Color = self.Window.Theme.Border, Parent = frame })

        create("TextLabel", {
            Size = UDim2.new(1, -60, 1, 0),
            Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1,
            Text = cfg.Name or "Toggle",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame
        })

        local track = create("Frame", {
            Size = UDim2.fromOffset(40, 20),
            Position = UDim2.new(1, -52, 0.5, -10),
            BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Border,
            Parent = frame
        })
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

        local knob = create("Frame", {
            Size = UDim2.fromOffset(14, 14),
            Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
            BackgroundColor3 = Color3.new(1, 1, 1),
            Parent = track
        })
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

        local trigger = create("TextButton", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
            Parent = frame
        })

        local function update()
            tween(track, 0.18, { BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Border })
            tween(knob, 0.18, { Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) })
            if cfg.Flag then self.Window.Flags[cfg.Flag] = state end
            if cfg.Callback then pcall(cfg.Callback, state) end
        end

        trigger.MouseButton1Click:Connect(function()
            state = not state
            update()
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = state end

        return {
            Set = function(_, value) state = value and true or false; update() end,
            Get = function() return state end
        }
    end

    function tabData:CreateSlider(cfg)
        cfg = cfg or {}
        local min = (cfg.Range and cfg.Range[1]) or 0
        local max = (cfg.Range and cfg.Range[2]) or 100
        local val = math.clamp(cfg.CurrentValue or min, min, max)
        local suffix = cfg.Suffix or ""

        local frame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 54),
            BackgroundColor3 = self.Window.Theme.Card,
            Parent = view
        })
        create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = frame })
        create("UIStroke", { Color = self.Window.Theme.Border, Parent = frame })

        create("TextLabel", {
            Size = UDim2.new(0.7, 0, 0, 20),
            Position = UDim2.new(0, 14, 0, 8),
            BackgroundTransparency = 1,
            Text = cfg.Name or "Slider",
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame
        })

        local valueLabel = create("TextLabel", {
            Size = UDim2.new(0.3, -14, 0, 20),
            Position = UDim2.new(0.7, 0, 0, 8),
            BackgroundTransparency = 1,
            Text = tostring(val) .. suffix,
            TextColor3 = self.Window.Theme.Accent,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = frame
        })

        local track = create("Frame", {
            Size = UDim2.new(1, -28, 0, 6),
            Position = UDim2.new(0, 14, 0, 36),
            BackgroundColor3 = self.Window.Theme.Sidebar,
            Parent = frame
        })
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

        local fill = create("Frame", {
            Size = UDim2.new((val - min) / math.max(max - min, 1), 0, 1, 0),
            BackgroundColor3 = self.Window.Theme.Accent,
            Parent = track
        })
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })

        local trigger = create("TextButton", {
            Size = UDim2.new(1, 0, 1, 12),
            Position = UDim2.new(0, 0, 0, -3),
            BackgroundTransparency = 1,
            Text = "",
            Parent = track
        })

        local dragging = false
        local function update(input)
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = math.floor(min + (max - min) * rel + 0.5)
            valueLabel.Text = tostring(val) .. suffix
            tween(fill, 0.05, { Size = UDim2.new(rel, 0, 1, 0) })
            if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
            if cfg.Callback then pcall(cfg.Callback, val) end
        end

        trigger.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input)
            end
        end)

        if cfg.Flag then self.Window.Flags[cfg.Flag] = val end

        return {
            Set = function(_, value)
                val = math.clamp(value, min, max)
                local rel = (val - min) / math.max(max - min, 1)
                valueLabel.Text = tostring(val) .. suffix
                fill.Size = UDim2.new(rel, 0, 1, 0)
                if cfg.Flag then self.Window.Flags[cfg.Flag] = val end
            end
        }
    end

    -- Normal Dropdown
    function tabData:CreateDropdown(cfg)
        cfg = cfg or {}
