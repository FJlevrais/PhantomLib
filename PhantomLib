function PhantomLib:Notify(cfg)
    cfg = cfg or {}
    local dur = cfg.Duration or 2.6

    local toast = Instance.new("Frame")
    toast.Size = UDim2.new(0, 250, 0, 0)
    toast.BackgroundColor3 = self.Theme.Elevated
    toast.BackgroundTransparency = 1
    toast.ClipsDescendants = true
    toast.Parent = self.NotifContainer
    corner(toast, 9)
    local s = stroke(toast, self.Theme.Border, 1, 1)

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, 0)
    bar.BackgroundColor3 = self.Theme.Accent
    bar.BorderSizePixel = 0
    bar.Parent = toast
    corner(bar, 2)

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -18, 0, 16)
    t.Position = UDim2.new(0, 12, 0, 8)
    t.BackgroundTransparency = 1
    t.Text = cfg.Title or "Notification"
    t.TextColor3 = self.Theme.Text
    t.TextSize = 13
    t.Font = Enum.Font.GothamBold
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextTransparency = 1
    t.Parent = toast

    local d = Instance.new("TextLabel")
    d.Size = UDim2.new(1, -18, 0, 15)
    d.Position = UDim2.new(0, 12, 0, 26)
    d.BackgroundTransparency = 1
    d.Text = cfg.Content or ""
    d.TextColor3 = self.Theme.Muted
    d.TextSize = 12
    d.Font = Enum.Font.Gotham
    d.TextXAlignment = Enum.TextXAlignment.Left
    d.TextTransparency = 1
    d.Parent = toast

    tween(toast, 0.3, {
        Size = UDim2.new(0, 250, 0, 48),
        BackgroundTransparency = 0
    }, Enum.EasingStyle.Back)
    tween(s, 0.22, {Transparency = 0})
    tween(t, 0.2, {TextTransparency = 0})
    tween(d, 0.24, {TextTransparency = 0})

    task.delay(dur, function()
        if not toast or not toast.Parent then return end
        tween(toast, 0.2, {BackgroundTransparency = 1, Size = UDim2.new(0, 250, 0, 0)})
        tween(s, 0.14, {Transparency = 1})
        tween(t, 0.14, {TextTransparency = 1})
        tween(d, 0.14, {TextTransparency = 1})
        task.wait(0.22)
        if toast then toast:Destroy() end
    end)
end

function PhantomLib:Rejoin()
    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP)
end

function PhantomLib:ServerHop()
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then return end
    local res = req({Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/0?sortOrder=Asc&limit=100", Method = "GET"})
    if res and res.StatusCode == 200 then
        local body = HttpService:JSONDecode(res.Body)
        if body and body.data then
            local valid = {}
            for _, s in ipairs(body.data) do
                if type(s) == "table" and s.id ~= game.JobId and s.playing < s.maxPlayers then
                    table.insert(valid, s.id)
                end
            end
            if #valid > 0 then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, valid[math.random(1, #valid)], LP)
            end
        end
    end
end

function PhantomLib:JoinSmallServer()
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then return end
    local cursor, target, minP = "", nil, math.huge
    for _ = 1, 5 do
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/0?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
        local res = req({Url = url, Method = "GET"})
        if res and res.StatusCode == 200 then
            local body = HttpService:JSONDecode(res.Body)
            if body and body.data then
                for _, s in ipairs(body.data) do
                    if type(s) == "table" and s.id ~= game.JobId and s.playing < s.maxPlayers and s.playing < minP then
                        minP = s.playing
                        target = s.id
                    end
                end
            end
            cursor = body.nextPageCursor or ""
            if cursor == "" then break end
        else
            break
        end
    end
    if target then
        TeleportService:TeleportToPlaceInstance(game.PlaceId, target, LP)
    end
end

