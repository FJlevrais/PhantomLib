            if listening and not gpe and input.UserInputType == Enum.UserInputType.Keyboard then
                key = input.KeyCode
                keyBtn.Text = key.Name
                keyBtn.TextColor3 = self.Window.Theme.Text
                listening = false
                if cfg.Flag then self.Window.Flags[cfg.Flag] = key end
                if cfg.Callback then pcall(cfg.Callback, key) end
            end
        end)

        register(name, frame)
    end

    function tabData:CreateColorPicker(cfg)
        cfg = cfg or {}
        local name = cfg.Name or "Color"
        local currentColor = cfg.Color or Color3.fromRGB(255, 100, 180)
        local expanded = false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 44)
        frame.BackgroundColor3 = self.Window.Theme.Card
        frame.ClipsDescendants = true
        frame.Parent = view
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 9)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, -55, 0, 44)
        title.Position = UDim2.new(0, 12, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = name
        title.TextColor3 = self.Window.Theme.Text
        title.TextSize = 13
        title.Font = Enum.Font.Gotham
