-- Utility Helpers
local function tween(object, duration, properties, easingStyle, easingDir)
    local style = easingStyle or Enum.EasingStyle.Quart
    local direction = easingDir or Enum.EasingDirection.Out
    local info = TweenInfo.new(duration, style, direction)
    local anim = TweenService:Create(object, info, properties)
    anim:Play()
    return anim
end

local function getGuiParent()
    local success, target = pcall(function()
        return CoreGui
    end)
    if success and target then
        return target
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

-- Constructor
function NovaUI.new(options)
    options = options or {}
    
    local self = setmetatable({}, NovaUI)
    self.CurrentTheme = NovaUI.Themes[options.Theme] or NovaUI.Themes.Dark
    self.Tabs = {}
    self.ActiveTab = nil
    self._connections = {}

    -- Base ScreenGui
    local screen = Instance.new("ScreenGui")
    screen.Name = "NovaUI_" .. string.sub(game:GetService("HttpService"):GenerateGUID(false), 1, 8)
    screen.ResetOnSpawn = false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.Parent = getGuiParent()

    -- Main Frame Window
    local main = Instance.new("Frame")
    main.Name = "MainWindow"
    main.Size = options.Size or UDim2.fromOffset(580, 390)
    main.Position = UDim2.new(0.5, -290, 0.5, -195)
    main.BackgroundColor3 = self.CurrentTheme.Background
    main.BorderSizePixel = 0
    main.ClipsDescendants = true
    main.Parent = screen

    local mainCorner = Instance.new("UICorner")
    mainCorner.CornerRadius = UDim.new(0, 8)
    mainCorner.Parent = main

    local mainStroke = Instance.new("UIStroke")
    mainStroke.Color = self.CurrentTheme.Border
    mainStroke.Thickness = 1
    mainStroke.Parent = main

    -- Header / Title Bar
    local header = Instance.new("Frame")
    header.Name = "HeaderBar"
    header.Size = UDim2.new(1, 0, 0, 38)
    header.BackgroundColor3 = self.CurrentTheme.Sidebar
    header.BorderSizePixel = 0
    header.Parent = main

    local title = Instance.new("TextLabel")
    title.Name = "TitleLabel"
    title.Size = UDim2.new(1, -40, 1, 0)
    title.Position = UDim2.new(0, 12, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = options.Title or "NovaUI Application"
    title.TextColor3 = self.CurrentTheme.Text
    title.TextSize = 14
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = header

    -- Window Dragging Implementation
    local dragging = false
    local dragInput, dragStart, startPos

    local function updateDrag(input)
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end

    table.insert(self._connections, header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end))

    table.insert(self._connections, header.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))

    table.insert(self._connections, UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            updateDrag(input)
        end
    end))

    -- Navigation Sidebar
    local sidebar = Instance.new("Frame")
    sidebar.Name = "NavSidebar"
    sidebar.Size = UDim2.new(0, 140, 1, -38)
    sidebar.Position = UDim2.new(0, 0, 0, 38)
    sidebar.BackgroundColor3 = self.CurrentTheme.Sidebar
    sidebar.BorderSizePixel = 0
    sidebar.Parent = main

    local sidebarLayout = Instance.new("UIListLayout")
    sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sidebarLayout.Padding = UDim.new(0, 4)
    sidebarLayout.Parent = sidebar

    local sidebarPadding = Instance.new("UIPadding")
    sidebarPadding.PaddingTop = UDim.new(0, 8)
    sidebarPadding.PaddingLeft = UDim.new(0, 6)
    sidebarPadding.PaddingRight = UDim.new(0, 6)
    sidebarPadding.Parent = sidebar

    -- Viewport Content Folder
    local container = Instance.new("Frame")
    container.Name = "TabContainer"
    container.Size = UDim2.new(1, -140, 1, -38)
    container.Position = UDim2.new(0, 140, 0, 38)
    container.BackgroundTransparency = 1
    container.Parent = main

    -- Object References
    self.Screen = screen
    self.MainFrame = main
    self.Header = header
    self.Sidebar = sidebar
    self.Container = container
    self.TitleLabel = title

    return self
end

-- Tab Management
function NovaUI:CreateTab(name)
    local tabData = {
        Name = name,
        Elements = {},
        ParentUI = self
    }

    -- Tab Button
    local tabButton = Instance.new("TextButton")
    tabButton.Name = "TabBtn_" .. name
    tabButton.Size = UDim2.new(1, 0, 0, 32)
    tabButton.BackgroundColor3 = self.CurrentTheme.Card
    tabButton.BackgroundTransparency = 1
    tabButton.Text = name
    tabButton.TextColor3 = self.CurrentTheme.Muted
    tabButton.TextSize = 13
    tabButton.Font = Enum.Font.GothamMedium
    tabButton.Parent = self.Sidebar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = tabButton

    -- Scrolling Frame Content Container
    local tabView = Instance.new("ScrollingFrame")
    tabView.Name = "View_" .. name
    tabView.Size = UDim2.new(1, 0, 1, 0)
    tabView.BackgroundTransparency = 1
    tabView.Visible = false
    tabView.ScrollBarThickness = 2
    tabView.ScrollBarImageColor3 = self.CurrentTheme.Accent
    tabView.BorderSizePixel = 0
    tabView.Parent = self.Container

    local viewLayout = Instance.new("UIListLayout")
    viewLayout.SortOrder = Enum.SortOrder.LayoutOrder
    viewLayout.Padding = UDim.new(0, 6)
    viewLayout.Parent = tabView

    local viewPadding = Instance.new("UIPadding")
    viewPadding.PaddingTop = UDim.new(0, 10)
    viewPadding.PaddingLeft = UDim.new(0, 10)
    viewPadding.PaddingRight = UDim.new(0, 10)
    viewPadding.PaddingBottom = UDim.new(0, 10)
    viewPadding.Parent = tabView

    -- Dynamic Scrolling Auto-Canvas Adjuster
    viewLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabView.CanvasSize = UDim2.new(0, 0, 0, viewLayout.AbsoluteContentSize.Y + 20)
    end)

    tabData.Button = tabButton
    tabData.View = tabView

    -- Tab Switch Controller
    local function selectTab()
        for _, tab in ipairs(self.Tabs) do
            tab.View.Visible = false
            tween(tab.Button, DEFAULT_ANIM_SPEED, {
                BackgroundTransparency = 1,
                TextColor3 = self.CurrentTheme.Muted
            })
        end
        tabView.Visible = true
        tween(tabButton, DEFAULT_ANIM_SPEED, {
            BackgroundTransparency = 0,
            BackgroundColor3 = self.CurrentTheme.Card,
            TextColor3 = self.CurrentTheme.Text
        })
        self.ActiveTab = tabData
    end

    tabButton.MouseButton1Click:Connect(selectTab)

    if #self.Tabs == 0 then
        selectTab()
    end

    table.insert(self.Tabs, tabData)

    -- Component Methods Attached to Tab Context
    
    -- 1. Button Element
    function tabData:AddButton(label, callback)
        callback = callback or function() end

        local btn = Instance.new("TextButton")
        btn.Name = "Btn_" .. label
        btn.Size = UDim2.new(1, 0, 0, 36)
        btn.BackgroundColor3 = self.ParentUI.CurrentTheme.Card
        btn.Text = label
        btn.TextColor3 = self.ParentUI.CurrentTheme.Text
        btn.TextSize = 13
        btn.Font = Enum.Font.GothamMedium
        btn.AutoButtonColor = false
        btn.Parent = tabView

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Color = self.ParentUI.CurrentTheme.Border
        stroke.Thickness = 1
        stroke.Parent = btn

        btn.MouseEnter:Connect(function()
            tween(btn, DEFAULT_ANIM_SPEED, {BackgroundColor3 = self.ParentUI.CurrentTheme.Accent})
        end)

        btn.MouseLeave:Connect(function()
            tween(btn, DEFAULT_ANIM_SPEED, {BackgroundColor3 = self.ParentUI.CurrentTheme.Card})
        end)

        btn.MouseButton1Click:Connect(function()
            task.spawn(function()
                tween(btn, 0.06, {Size = UDim2.new(1, -2, 0, 34)})
                task.wait(0.06)
                tween(btn, 0.06, {Size = UDim2.new(1, 0, 0, 36)})
            end)
            pcall(callback)
        end)
    end

    -- 2. Toggle Switch Element
    function tabData:AddToggle(label, default, callback)
        callback = callback or function() end
        local toggled = default or false

        local frame = Instance.new("Frame")
        frame.Name = "Toggle_" .. label
        frame.Size = UDim2.new(1, 0, 0, 38)
        frame.BackgroundColor3 = self.ParentUI.CurrentTheme.Card
        frame.Parent = tabView

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = frame

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, -50, 1, 0)
        textLabel.Position = UDim2.new(0, 10, 0, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = label
        textLabel.TextColor3 = self.ParentUI.CurrentTheme.Text
        textLabel.TextSize = 13
        textLabel.Font = Enum.Font.Gotham
        textLabel.TextXAlignment = Enum.TextXAlignment.Left
        textLabel.Parent = frame

        local track = Instance.new("Frame")
        track.Size = UDim2.fromOffset(36, 18)
        track.Position = UDim2.new(1, -44, 0.5, -9)
        track.BackgroundColor3 = toggled and self.ParentUI.CurrentTheme.Accent or self.ParentUI.CurrentTheme.Border
        track.Parent = frame

        local trackCorner = Instance.new("UICorner")
        trackCorner.CornerRadius = UDim.new(1, 0)
        trackCorner.Parent = track

        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(12, 12)
        knob.Position = toggled and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
        knob.BackgroundColor3 = self.ParentUI.CurrentTheme.Text
        knob.Parent = track

        local knobCorner = Instance.new("UICorner")
        knobCorner.CornerRadius = UDim.new(1, 0)
        knobCorner.Parent = knob

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 1, 0)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = frame

        trigger.MouseButton1Click:Connect(function()
            toggled = not toggled
            
            tween(track, DEFAULT_ANIM_SPEED, {
                BackgroundColor3 = toggled and self.ParentUI.CurrentTheme.Accent or self.ParentUI.CurrentTheme.Border
            })
            
            tween(knob, DEFAULT_ANIM_SPEED, {
                Position = toggled and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
            })

            pcall(callback, toggled)
        end)
    end

    -- 3. Scrollable List Selection (Dropdown)
    function tabData:AddListSelection(label, items, callback)
        callback = callback or function() end
        items = items or {}
        local expanded = false
        local selected = items[1] or "None"

        local container = Instance.new("Frame")
        container.Name = "Dropdown_" .. label
        container.Size = UDim2.new(1, 0, 0, 40)
        container.BackgroundColor3 = self.ParentUI.CurrentTheme.Card
        container.ClipsDescendants = true
        container.Parent = tabView

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = container

        local titleLabel = Instance.new("TextLabel")
        titleLabel.Size = UDim2.new(0.45, 0, 0, 40)
        titleLabel.Position = UDim2.new(0, 10, 0, 0)
        titleLabel.BackgroundTransparency = 1
        titleLabel.Text = label
        titleLabel.TextColor3 = self.ParentUI.CurrentTheme.Text
        titleLabel.TextSize = 13
        titleLabel.Font = Enum.Font.Gotham
        titleLabel.TextXAlignment = Enum.TextXAlignment.Left
        titleLabel.Parent = container

        local triggerBtn = Instance.new("TextButton")
        triggerBtn.Size = UDim2.new(0.5, -10, 0, 28)
        triggerBtn.Position = UDim2.new(0.5, 0, 0, 6)
        triggerBtn.BackgroundColor3 = self.ParentUI.CurrentTheme.Background
        triggerBtn.Text = selected .. "  ▼"
        triggerBtn.TextColor3 = self.ParentUI.CurrentTheme.Muted
        triggerBtn.TextSize = 12
        triggerBtn.Font = Enum.Font.GothamMedium
        triggerBtn.Parent = container

        local triggerCorner = Instance.new("UICorner")
        triggerCorner.CornerRadius = UDim.new(0, 4)
        triggerCorner.Parent = triggerBtn

        local scrollList = Instance.new("ScrollingFrame")
        scrollList.Size = UDim2.new(1, -20, 0, 100)
        scrollList.Position = UDim2.new(0, 10, 0, 44)
        scrollList.BackgroundColor3 = self.ParentUI.CurrentTheme.Sidebar
        scrollList.BorderSizePixel = 0
        scrollList.ScrollBarThickness = 2
        scrollList.ScrollBarImageColor3 = self.ParentUI.CurrentTheme.Accent
        scrollList.Parent = container

        local listLayout = Instance.new("UIListLayout")
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Padding = UDim.new(0, 3)
        listLayout.Parent = scrollList

        local listPadding = Instance.new("UIPadding")
        listPadding.PaddingTop = UDim.new(0, 4)
        listPadding.PaddingLeft = UDim.new(0, 4)
        listPadding.PaddingRight = UDim.new(0, 4)
        listPadding.Parent = scrollList

        listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            scrollList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 8)
        end)

        for _, item in ipairs(items) do
            local itemBtn = Instance.new("TextButton")
            itemBtn.Size = UDim2.new(1, 0, 0, 24)
            itemBtn.BackgroundColor3 = self.ParentUI.CurrentTheme.Card
            itemBtn.Text = item
            itemBtn.TextColor3 = self.ParentUI.CurrentTheme.Text
            itemBtn.TextSize = 12
            itemBtn.Font = Enum.Font.Gotham
            itemBtn.Parent = scrollList

            local itemCorner = Instance.new("UICorner")
            itemCorner.CornerRadius = UDim.new(0, 4)
            itemCorner.Parent = itemBtn

            itemBtn.MouseButton1Click:Connect(function()
                selected = item
                triggerBtn.Text = selected .. "  ▼"
                expanded = false
                tween(container, DEFAULT_ANIM_SPEED, {Size = UDim2.new(1, 0, 0, 40)})
                pcall(callback, selected)
            end)
        end

        triggerBtn.MouseButton1Click:Connect(function()
            expanded = not expanded
            local targetHeight = expanded and 152 or 40
            tween(container, DEFAULT_ANIM_SPEED, {Size = UDim2.new(1, 0, 0, targetHeight)})
        end)
    end

    return tabData
end

-- Global Theme Engine Method
function NovaUI:SetTheme(themeName)
    local targetTheme = NovaUI.Themes[themeName]
    if not targetTheme then return end
    
    self.CurrentTheme = targetTheme

    tween(self.MainFrame, DEFAULT_ANIM_SPEED, {BackgroundColor3 = targetTheme.Background})
    tween(self.Header, DEFAULT_ANIM_SPEED, {BackgroundColor3 = targetTheme.Sidebar})
    tween(self.Sidebar, DEFAULT_ANIM_SPEED, {BackgroundColor3 = targetTheme.Sidebar})
    tween(self.TitleLabel, DEFAULT_ANIM_SPEED, {TextColor3 = targetTheme.Text})

    for _, tab in ipairs(self.Tabs) do
        if tab == self.ActiveTab then
            tween(tab.Button, DEFAULT_ANIM_SPEED, {BackgroundColor3 = targetTheme.Card, TextColor3 = targetTheme.Text})
        else
            tween(tab.Button, DEFAULT_ANIM_SPEED, {TextColor3 = targetTheme.Muted})
        end
    end
end

-- Cleanup Handler
function NovaUI:Destroy()
    for _, conn in ipairs(self._connections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    if self.Screen then
        self.Screen:Destroy()
    end
end

return NovaUI
